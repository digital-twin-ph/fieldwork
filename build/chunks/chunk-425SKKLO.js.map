{
 "schema": "fieldwork/composition/2",
 "id": "urn:fieldwork:composition:classify_extent",
 "nodeType": "classify_extent",
 "version": "0.1.0",
 "title": "Extent review",
 "author": "Fieldwork project",
 "released": "2026-10-14",
 "stage": "classify",
 "description": "How far a set of points reaches, and whether that is large enough to look at. Draws the convex hull of the points, measures its area in a metric CRS, and classifies the hull against a stated threshold with the extent-review ruleset. The polygon comes out carrying its own status, so a map can colour it and anything downstream keeps the judgement.",
 "mustNotBeReadAs": "Not a judgement that a large area is a problem. Whether extent matters, and above what size, depends entirely on the question: a hull over 2 km2 is unremarkable for a city and alarming for a building footprint. The threshold is the practitioner\u2019s to set and neither this composition nor the ruleset inside it ships a basis for any value. A hull is also an outline of what was OBSERVED, not a boundary anyone agreed to, and it encloses ground where nothing was recorded.",
 "governance": {
  "status": "private",
  "owner": "Fieldwork project",
  "reviews": [
   {
    "at": "2026-10-14",
    "by": "agent, unreviewed by a human",
    "outcome": "Assembled and executed, and substituted into the John Snow outbreak-extent example, which is how a composition is tested here. Not admitted to the palette: admission needs a human review and an ontology expansion, neither of which exists. Status stays private. Experiment 113."
   }
  ]
 },
