{
  "name": "fieldwork-semantic-gis",
  "version": "0.109.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "npm run typecheck && node build.mjs",
    "build:kernel": "cargo build --manifest-path kernel/Cargo.toml --release --target wasm32-unknown-unknown && cp kernel/target/wasm32-unknown-unknown/release/fieldwork_kernel.wasm kernel/fieldwork-kernel.wasm && node scripts/embed-kernel.mjs",
    "dev": "node server.mjs",
    "test": "npm run build && node scripts/test-unit.mjs",
    "test:browser": "playwright test",
    "test:report": "playwright show-report",
    "check": "npm run build && npm run validate:kernel && npm run validate:docs && npm run validate:experiments && npm run validate:check-coverage && npm run validate:evidence && npm run validate:rulesets && npm run validate:blockers && npm run validate:directions && npm run validate:facility-registers && npm run validate:standardization && npm run validate:naming && npm run validate:names && npm run validate:widget-budget && npm run validate:admission && npm run validate:ontology-coupling && npm run validate:dive-deeper && npm run validate:manual && npm run validate:inspector-prose && npm run validate:caps && npm run validate:extracts && npm run validate:fixtures && npm run validate:examples && npm run validate:example-audit && npm run validate:port-contracts && npm run validate:release-notes && npm run validate:vocabulary && npm run validate:audit-queue && npm run validate:packs && npm run validate:sentence-numbers && node scripts/test-unit.mjs && npm run test:browser",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json --noEmit",
    "catalogue:worldpop": "node scripts/refresh-worldpop-catalogue.mjs",
    "validate:ontology": "node scripts/validate-ontology.mjs",
    "validate:widgets": "node scripts/validate-widgets.mjs",
    "validate:ontology-coupling": "node scripts/validate-ontology-coupling.mjs",
    "validate:packs": "node scripts/validate-packs.mjs",
    "validate:parity": "node scripts/validate-parity.mjs",
    "validate:fixtures": "node scripts/export-validation-fixture.mjs --dry-run",
    "validate:check-coverage": "node scripts/validate-check-coverage.mjs",
    "validate:evidence": "node scripts/widget-evidence.mjs --check",
    "validate:rulesets": "node scripts/validate-rulesets.mjs",
    "validate:blockers": "node scripts/validate-blockers.mjs",
    "validate:standardization": "node scripts/validate-standardization.mjs",
    "validate:naming": "node scripts/validate-naming.mjs",
    "validate:names": "node scripts/validate-names.mjs && node scripts/widget-names.mjs",
    "names:widgets": "node scripts/widget-names.mjs --write",
    "validate:widget-budget": "node scripts/validate-widget-budget.mjs",
    "validate:admission": "node scripts/validate-admission.mjs",
    "stamp:docs": "node scripts/stamp-docs.mjs --write",
    "validate:kernel": "node scripts/embed-kernel.mjs --check",
    "validate:docs": "node scripts/stamp-docs.mjs",
    "validate:experiments": "node scripts/validate-experiments.mjs",
    "usage:widgets": "node scripts/widget-coverage.mjs",
    "audit:metres": "node scripts/audit-metre-conversions.mjs",
    "validate:dive-deeper": "node scripts/validate-dive-deeper.mjs",
    "reveal:widgets": "node scripts/widget-reveal.mjs",
    "manual:widgets": "node scripts/widget-manual.mjs --write",
    "validate:manual": "node scripts/validate-manual.mjs",
    "validate:audit-queue": "node scripts/validate-audit-queue.mjs",
    "contracts:ports": "node scripts/port-contracts.mjs --write",
    "evidence:widgets": "node scripts/widget-evidence.mjs --write",
    "validate:port-contracts": "node scripts/validate-port-contracts.mjs",
    "validate:vocabulary": "node scripts/validate-vocabulary.mjs",
    "check:fast": "npm run build && npm run validate:kernel && npm run validate:docs && npm run validate:experiments && npm run validate:check-coverage && npm run validate:evidence && npm run validate:rulesets && npm run validate:ruleset-sources && npm run validate:blockers && npm run validate:directions && npm run validate:facility-registers && npm run validate:standardization && npm run validate:naming && npm run validate:names && npm run validate:widget-budget && npm run validate:admission && npm run validate:ontology-coupling && npm run validate:dive-deeper && npm run validate:manual && npm run validate:fixtures && npm run validate:examples && npm run validate:example-audit && npm run validate:port-contracts && npm run validate:release-notes && npm run validate:vocabulary && npm run validate:audit-queue && npm run validate:packs && node scripts/test-unit.mjs",
    "test:browser:chromium": "playwright test --project=chromium",
    "hooks:install": "node scripts/install-hooks.mjs",
    "notes:releases": "node scripts/release-notes.mjs --write",
    "validate:release-notes": "node scripts/release-notes.mjs",
    "validate:directions": "node scripts/validate-directions.mjs",
    "validate:ruleset-sources": "node scripts/validate-ruleset-sources.mjs",
    "validate:inspector-prose": "node scripts/validate-inspector-prose.mjs",
    "validate:caps": "node scripts/validate-caps.mjs",
    "notes:extracts": "node scripts/geofabrik-catalogue.mjs --write",
    "validate:extracts": "node scripts/geofabrik-catalogue.mjs",
    "test:browser:linux": "bash scripts/linux-webkit.sh",
    "validate:examples": "node scripts/validate-examples.mjs",
    "audit:examples": "node scripts/audit-worked-examples.mjs --write",
    "validate:example-audit": "node scripts/audit-worked-examples.mjs",
    "validate:facility-registers": "node scripts/facility-registers.mjs",
    "registers:facilities": "node scripts/facility-registers.mjs --write",
    "validate:sentence-numbers": "node scripts/sentence-numbers.mjs --strict --twice"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@protomaps/basemaps": "^5.7.2",
    "@turf/area": "7.3.5",
    "@turf/boolean-point-in-polygon": "7.3.5",
    "@turf/buffer": "7.3.5",
    "@xyflow/react": "^12.12.0",
    "@zip.js/zip.js": "2.23.0",
    "fflate": "^0.8.3",
    "geotiff": "3.0.5",
    "h3-js": "4.5.0",
    "h5wasm": "^0.10.3",
    "hyparquet": "^1.31.3",
    "hyparquet-compressors": "^1.1.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.5.0",
    "polyclip-ts": "0.16.8",
    "proj4": "2.19.10",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "1.14.1",
    "temml": "0.14.0",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "esbuild": "^0.28.2",
    "n3": "2.13.8",
    "rdf-validate-shacl": "0.6.5",
    "typescript": "7.0.2"
  }
}
