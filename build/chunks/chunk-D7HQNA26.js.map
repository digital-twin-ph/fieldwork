{
 "schema": "fieldwork/parity-evidence/1",
 "description": "Independent recomputation of implemented widgets by an external process, recorded after release. Release files are immutable once committed, so evidence about a release lives here and accrues as checks run. A fixture digest recorded in a result is over canonical JSON content rather than the file’s bytes, revised 2026-10-11 because byte identity is unsatisfiable in the browser the lab publishes to. A parity result establishes numerical agreement with a named external implementation under a stated criterion. It is not scientific certification, and it says nothing about whether a method is appropriate for a question.",
 "lab": {
  "repository": "https://github.com/digital-twin-ph/validation-lab",
  "commit": "c924eb3960db53715004df5b9323ed422192e3fa"
 },
 "outcomes": {
  "agrees": "Every case met the stated criterion.",
  "partial": "Some cases met it and others did not; the measurement states which.",
  "diverges": "The stated criterion was not met.",
  "unresolved": "The comparison could not be made, for a reason the note gives."
 },
 "entries": [
  {
   "widget": "urn:fieldwork:widget:reproject",
   "coversRelease": "0.1.0",
   "check": "01-reproject",
   "result": "content/results/check-01-reproject.json",
   "sha256": "bc9d75e83b7b31e9b5da28ff36e74ff8bbceaa56868432af73da1118eb4e9e73",
   "external": [
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "maximum separation below 0.001 m over the fixture points",
   "outcome": "agrees",
   "measured": "maximum separation 6.70e-5 m over 9 points",
   "ranAt": "2026-10-11T15:31:45.181390+00:00",
   "note": "Recomputed from the declared PROJ definition rather than the source EPSG code, so the comparison tests what the widget says it did. Covers a projection change on one datum; no datum shift is exercised."
  },
  {
   "widget": "urn:fieldwork:widget:clip_raster",
   "coversRelease": "1.0.0",
   "check": "02-clip",
   "result": "content/results/check-02-clip.json",
   "sha256": "29db912713596fb55b68f05de59a1f62deb3cb6b7ba5935a8e1f14e7b98d9e6c",
   "external": [
    "rasterio 1.5.2",
    "GDAL 3.12.2",
    "shapely 2.2.0",
    "GEOS 3.14.1"
   ],
   "criterion": "identical opened window, included-cell set and retained values, per case",
   "outcome": "partial",
   "measured": "Cell-centre: agrees, 0 of 132 cells differ and retained values are identical. All-touched at a pixel-aligned cutline: 2 cells differ, both beside the alignment. All-touched with a one-pixel margin: the window differs and 61 cells differ, where the reference models the margin as a 3x3 binary dilation, which is not this widget's rule.",
   "ranAt": "2026-10-11T15:31:45.775888+00:00",
   "note": "Recorded per case rather than as one verdict. The two residual all-touched cells are what remains after adopting GDAL's positive-area rule, down from 35; see docs/experiments/29-raster-edge-inclusion.md. The margin case is an unresolved comparison, not an established defect: the reference and the widget define the margin differently."
  },
  {
   "widget": "urn:fieldwork:widget:measure_area",
   "coversRelease": "0.1.0",
   "check": "05-area",
   "result": "content/results/check-05-area.json",
   "sha256": "06bf4df80c623e923592a6a5937d858c73ce90baaa4b47c3363fc2d9044dd149",
   "external": [
    "pyproj 3.8.0 / GeographicLib geodesic areas",
    "an independent closed-form spherical area"
   ],
   "criterion": "relative difference at most 1e-9 against an independent expression of the declared spherical formula, over five boundaries including one with a hole",
   "outcome": "agrees",
   "measured": "Implementation: relative difference at most 4.78e-14. Reported separately as method context, not as failures — against a geodesic area with great-circle edges on the same sphere, boxes differ by under 0.01 % and a mid-latitude triangle with oblique edges by 0.30 %; against WGS84 the declared spherical approximation runs +0.45 % at the equator to -0.56 % at 60 N, so its sign changes with latitude.",
   "ranAt": "2026-10-11T15:31:45.916652+00:00",
   "note": "Three questions kept apart: whether the widget computes the formula it declares, how far that formula is from a great-circle-edged geodesic area, and how far from an ellipsoidal one. Only the first is a criterion; the other two quantify the approximation the widget already discloses when it calls its result approximate."
  },
  {
   "widget": "urn:fieldwork:widget:mean_center",
   "coversRelease": "0.1.0",
   "check": "06-mean-center",
   "result": "content/results/check-06-mean-center.json",
   "sha256": "68155f46d0701db75f515e19337ee2990196fcd0c7901e0448df914ba765456b",
   "external": [
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "projected mean within 1e-3 m on both axes, returned position within 1e-3 m ground separation, and the input count unchanged",
   "outcome": "agrees",
   "measured": "Easting exact, northing 9.31e-10 m, returned position 4.09e-10 m ground separation over 6 points.",
   "ranAt": "2026-10-11T15:31:46.053251+00:00",
   "note": "Establishes that proj4js and PROJ agree on this UTM transform and that the average is unweighted as declared. It establishes nothing about whether a mean centre is an appropriate summary: the fixture includes an outlier 25 km from the cluster, and both implementations are pulled by it identically."
  },
  {
   "widget": "urn:fieldwork:widget:reachable_nodes",
   "coversRelease": "0.3.0",
   "check": "07-reachability",
   "result": "content/results/check-07-reachability.json",
   "sha256": "78c84fc5e8e7ddc93de91baf3ba65c1bef4046b10b7f9ef74a88e4ebdc50fde5",
   "external": [
    "networkx 3.6"
   ],
   "criterion": "the same set of reached nodes exactly, every cost within 0.01 m, and every remaining budget within 0.01 m of the budget less the cost",
   "outcome": "agrees",
   "measured": "reached sets identical over 738 junctions, 142 each with none reached by only one implementation; worst cost difference 5.000e-03 m and worst remaining-budget difference 5.000e-03 m",
   "ranAt": "2026-10-11T15:31:46.251974+00:00",
   "note": "Compared against the implementation the original case study used: Advanced-1 NB03 reaches its isochrones with nx.ego_graph. The 5 mm residual is exactly the half-step of the two decimal places Fieldwork publishes, so the only disagreement is its rounding. Both traversals run on the edge lengths the fixture states and neither measures a street, so a wrong network passes in both. Covers outbound travel from one origin on one network; inbound is unexercised. Re-run against 0.3.0 after that release added speedMPerMin and travelMode to each junction: the parity validator refused evidence covering 0.2.0 while 0.3.0 was current, and the change being additive was not grounds for carrying the old result forward."
  },
  {
   "widget": "urn:fieldwork:widget:reachable_corridor",
   "coversRelease": "0.2.0",
   "check": "08-corridor",
   "result": "content/results/check-08-corridor.json",
   "sha256": "514a741350403a2afa7aa1bfd3edc2062cb3182481f06d8e4e5f30475ad699c8",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1",
    "pyproj 3.8.0"
   ],
   "criterion": "entered and partial segment counts exactly, area within 1%, and symmetric difference at most 2% of the reported area",
   "outcome": "agrees",
   "measured": "street selection identical -- 301 entered and 45 cut part-way in both; area 199210 against 198980 square metres, 0.116% apart, with a symmetric difference of 0.116%",
   "ranAt": "2026-10-11T15:31:46.610399+00:00",
   "note": "The corridor is rebuilt from the widget's stated rule with GEOS, not compared feature by feature, so the selection arithmetic is reproduced independently. The 0.116% residual is two engines approximating a 25 m radius at 8 segments per quadrant in two different projections, and the symmetric difference being the same size says it is spread around the boundary rather than a missing piece. Covers the five minute band of one corridor, outbound. Both implementations trust the same street lengths and geometry, so a wrong network passes in both. The notebook beside it measures the corridor's area at 0.51x for a 10 m half-width and 1.53x at 60 m, against a 25 m figure the case study records no reason for."
  },
  {
   "widget": "urn:fieldwork:widget:summarize_hull",
   "coversRelease": "0.1.0",
   "check": "10-hull",
   "result": "content/results/check-10-hull.json",
   "sha256": "166368f3fc8ef68136901a03038443022fe372f04c62cb3368f3fb310aa65e31",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1",
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "the same number of hull vertices, every vertex within 0.001 m of one in the reference hull and vice versa, planar area within 0.05 m2, span within 0.1 m, and the located-point count unchanged",
   "outcome": "agrees",
   "measured": "11 hull vertices on both sides, worst vertex separation 1.95e-09 m, area difference 0.004 m2, span difference 0.018 m, over 250 located points",
   "ranAt": "2026-10-11T20:27:47.774876+00:00",
   "note": "A convex hull is exact, so there is no approximation to allow for and a disagreement would be real. The reference projects the points itself with pyproj rather than using Fieldwork's projected metres, so the projection and the hull are checked together. The area compared is the planar area of the ring in EPSG:32630, which is what the widget claims, and not a geodesic area. Agreement says nothing about whether a convex hull is a sensible summary: it fills in ground the outbreak did not cross, and both implementations fill it in identically."
  },
  {
   "widget": "urn:fieldwork:widget:fill_interior_gaps",
   "coversRelease": "0.1.0",
   "check": "11-fill-gaps",
   "result": "content/results/check-11-fill-gaps.json",
   "sha256": "9d88147af0dbc4985a2657b44752da5812a70582f8b7260d8525da1ff3ba9d85",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1",
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "the same number of gaps filled, no interior ring left in the output, the filled geometry within 0.05 m2 by symmetric difference, and the areas before, after and added each within 0.05 m2",
   "outcome": "agrees",
   "measured": "69 interior rings dropped on both sides, zero rings left, symmetric difference 0.0e+00 m2, and the areas before, after and added agreeing to 3.5e-03 m2. The fill added 37293 m2 of 938166 m2",
   "ranAt": "2026-10-11T20:48:38.525152+00:00",
   "note": "Dropping interior rings is exact, so this checks the bookkeeping rather than a tolerance: the gap count, the area net of holes before, the outer rings after, and the difference. Two bands are used because the example has one pump, and a one-part fixture could not distinguish filling from joining up. Agreement says nothing about whether filling is right: the added ground was never computed as reachable, and the reference asserts it identically because it is the same operation."
  },
  {
   "widget": "urn:fieldwork:widget:summarize_combined_area",
   "coversRelease": "0.1.0",
   "check": "12-combined-area",
   "result": "content/results/check-12-combined-area.json",
   "sha256": "0c7d0be488f8f7810887e4ecc711adee59586b23b1f8fa95d3bc8bd9b92575ef",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1",
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "the combined geometry within 1 m2 by symmetric difference, the combined area and the summed parts area each within 1 m2, and the part and piece counts unchanged",
   "outcome": "agrees",
   "measured": "combined area 701662.61 m2 against 701662.61 m2, a difference of 3.4e-03 m2, with a zero symmetric difference and the summed parts agreeing to 1.4e-03 m2 over 3 nested parts whose overlap is 240717 m2",
   "ranAt": "2026-10-11T20:48:38.645737+00:00",
   "note": "The most independent check in the lab so far: Fieldwork unions with polyclip-ts and measures with a shoelace sum, the reference unions with GEOS and measures with GEOS. A union is where two libraries most plausibly differ. The parts are three nested bands, so they overlap heavily and the union is not trivially the sum. Parts are summed net of their holes, which is the defect Fieldwork's own comment records finding on the isochrone chain: summing outer rings alone reported a hole-bearing area as overlapping itself."
  },
  {
   "widget": "urn:fieldwork:widget:clip_polygons",
   "coversRelease": "0.1.0",
   "check": "13-clip-polygons",
   "result": "content/results/check-13-clip-polygons.json",
   "sha256": "48b7d913a12842707279084b4067914c6889c47dca6ad97a4c9733a867c82b93",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1"
   ],
   "criterion": "the same polygons surviving the clip, each within 1e-13 square degrees of shapely's intersection by symmetric difference, and no output polygon extending beyond the boundary",
   "outcome": "agrees",
   "measured": "all 8 of 8 polygons survived on both sides, worst symmetric difference 5.8e-18 square degrees, and none escaped the boundary",
   "ranAt": "2026-10-11T21:05:45.351537+00:00",
   "note": "polyclip-ts against GEOS on the John Snow chain: nearest-pump cells clipped to the reporting rectangle, which extend past it, so the clip does real work. Compared in square degrees because the widget intersects on longitude and latitude without projecting, which is declared rather than hidden. The notebook measures the cost of that: clipping in degrees and clipping in metres agree to 5.9e-5 relative at worst over a rectangle 1.4 km across -- 59 parts per million, about 6 m2 of 100,000 -- and the simplification would not hold for a continental boundary."
  },
  {
   "widget": "urn:fieldwork:widget:summarize_polygons",
   "coversRelease": "0.1.0",
   "check": "14-summarize-polygons",
   "result": "content/results/check-14-summarize-polygons.json",
   "sha256": "9ad17eec6874fc02f3c72e8ca3801211b434189cdbefcfb9f1e8ea8426d58c85",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1"
   ],
   "criterion": "every per-polygon count, numeric total and missing-value count exact, and the summary of records, matched, unmatched, unlocated and multiply-assigned locations exact, with boundary policy 'include' read as GEOS covers",
   "outcome": "agrees",
   "measured": "every per-polygon count and total exact over 250 locations in 8 polygons, summary exact, worst total difference 0",
   "ranAt": "2026-10-11T21:06:17.277525+00:00",
   "note": "Fieldwork's own point-in-polygon test against GEOS predicates, with the boundary policy mapped explicitly: include is covers, exclude is contains. The fixture contains no location on a polygon edge and none in two polygons, so that mapping is declared and NOT exercised by the comparison -- the notebook constructs the missing case to show that include counts an edge location for both cells and exclude for neither. Agreement says nothing about whether nearest-pump assignment models which pump anybody drank from."
  },
  {
   "widget": "urn:fieldwork:widget:voronoi",
   "coversRelease": "0.1.0",
   "check": "15-voronoi",
   "result": "content/results/check-15-voronoi.json",
   "sha256": "1ff1442142b2418cf8856ea4cfd3a4f7fdaa20432e46c353ecd1d75b10eade91",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1",
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "each cell within 1 m2 of GEOS's Voronoi region for the same site by symmetric difference, the cells tiling the recomputed envelope to within 1 m2 with no overlap, and every cell containing its own site",
   "outcome": "agrees",
   "measured": "all 8 cells within 2.5e-06 m2 of GEOS's region for the same site, union against the recomputed envelope 2.1e-06 m2, pairwise overlap 6.0e-07 m2, every cell holding its own site",
   "ranAt": "2026-10-11T21:25:23.644223+00:00",
   "note": "Two unrelated algorithms for the same partition: Fieldwork clips a rectangle with one half-plane per other site, the reference asks GEOS for the Voronoi diagram of the same projected points. Neither method informs the other. The envelope is recomputed from the boundary by the declared rule rather than taken from the fixture, so that derivation is checked too. This completes the John Snow Voronoi chain: cells, clip and count are all now independently recomputed. Agreement says nothing about whether a nearest-pump cell models which pump anybody drank from -- the notebook measures that 138,081 m2 of the ground reachable on foot in five minutes falls outside the cell, and the two answer different questions."
  },
  {
   "widget": "urn:fieldwork:widget:stack_polygons",
   "coversRelease": "0.1.0",
   "check": "16-stack-polygons",
   "result": "content/results/check-16-stack-polygons.json",
   "sha256": "9fe3f955cec8f0437dcdd34f8783cb607de7825d712efad0e88929fc9ce72173",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1"
   ],
   "criterion": "the order of identifiers exactly as the declared extent rule gives it, the same multiset of identifiers in and out, and the layer, polygon and banded-polygon counts exact",
   "outcome": "agrees",
   "measured": "the order of all 3 identifiers exact, the same polygons in and out, the layer, polygon and banded counts exact, and 0 ties in extent",
   "ranAt": "2026-10-11T21:25:52.043065+00:00",
   "note": "A check of a rule rather than of arithmetic: this widget concatenates layers and sorts by extent, and has no geometry to compare. Extent is deliberately crude and is declared in full -- the sum of every ring's absolute shoelace area in SQUARE DEGREES, unprojected, holes added not subtracted -- because it is a sort key and not a measurement. The notebook measures the gap on the real bands: extent exceeds the net area by 0.6%, 10.8% and 7.6% for the 2, 5 and 10 minute corridors. Ties are reported because a tie would leave the order ambiguous while this check still passed; there are none here."
  },
  {
   "widget": "urn:fieldwork:widget:buffer_point",
   "coversRelease": "0.1.0",
   "check": "17-buffer-point",
   "result": "content/results/check-17-buffer-point.json",
   "sha256": "84dfb6e4066fc445048801e91759992c0a41eae50f480f4cc9e348544abdc408",
   "external": [
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "exactly 128 vertices, the reported circle-area fraction within 5e-05 of the closed form for an inscribed polygon, and every vertex within 0.001 m of the stated 500 m on the sphere of radius 6.37101e+06 m that Turf buffers on",
   "outcome": "agrees",
   "measured": "128 vertices as expected, reported circle-area fraction 0.9996 against the closed form 0.99960, every vertex within 2.4e-09 m of the stated 500 m on Turf's sphere, and 500.28 to 501.59 m on the WGS84 ellipsoid",
   "ranAt": "2026-10-11T21:48:18.524100+00:00",
   "note": "Checked against theory rather than a second implementation: Turf buffers in a local azimuthal equidistant projection, so there is nothing equivalent to compare the construction with. A circle buffered with n/4 segments per quadrant is a polygon of n vertices inscribed in it, whose area is (n/2pi) sin(2pi/n) of the circle's -- arithmetic that owes nothing to any geometry library, and which reproduces the 0.99359 and 0.99960 this project measured by hand. This check FAILED on its first run at 1.589 m against a 1 m radius criterion, and the fault was the criterion. Turf buffers on a sphere of radius 6,371,008.8 m and does so exactly: the measured spread of vertex distances there is 0.0000 m. On the WGS84 ellipsoid the same ring is 500.28 to 501.59 m from the centre. So a 500 m buffer is 500 m on a sphere and up to 1.59 m more on the ground, varying with direction -- 0.32%, about 16 m on a 5 km scope. Nothing recorded that before, and it was found only because a criterion fixed in advance failed and was investigated instead of relaxed."
  },
  {
   "widget": "urn:fieldwork:widget:buffer_area",
   "coversRelease": "0.1.0",
   "check": "18-buffer-area",
   "result": "content/results/check-18-buffer-area.json",
   "sha256": "fd60d79e2ae54fe2bf989790611a4b962b8ea585e28aab45bd1d6e070caefe8b",
   "external": [
    "shapely 2.2.0",
    "GEOS 3.14.1",
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "the buffered area within 0.5% of a EPSG:32630 reference buffer at the same 8 segments per quadrant, and the result containing the original boundary",
   "outcome": "agrees",
   "measured": "12248049 m2 against 12235014 m2 from a EPSG:32630 buffer at the same 8 segments per quadrant, a relative difference of 1.1e-03, and the result contains the original boundary",
   "ranAt": "2026-10-11T21:48:18.678187+00:00",
   "note": "Exact agreement is not available and is not claimed: Turf buffers in a local azimuthal equidistant projection and the reference buffers in UTM, so the criterion is a relative area difference with the quadrant count declared. 8 segments per quadrant leaves 0.64% of an ideal circle outside the polygon against 0.04% at the 32 buffer_point uses, which is deliberate: this widget expands a boundary that already exists, so its edge decides nothing, while buffer_point's edge decides membership. The notebook measures where the approximation can even apply -- the corners are 13.4% of what this buffer adds and the sides are the rest, so the polygon approximation costs 0.086% of the addition."
  },
  {
   "widget": "urn:fieldwork:widget:snap_to_network",
   "coversRelease": "0.1.0",
   "check": "19-snap",
   "result": "content/results/check-19-snap.json",
   "sha256": "133d00fea977964c5c62350ec30b9eb559a02df81a1a49777367614b940bd240",
   "external": [
    "pyproj 3.8.0",
    "PROJ 9.8.1"
   ],
   "criterion": "the same node chosen for every site, the distance moved within 0.005 m -- half of the centimetre the widget reports it to -- the returned position being the node's and not the site's, the site and distinct-node counts exact, and no site beyond the 150 m limit",
   "outcome": "agrees",
   "measured": "the same node chosen for all 8 sites against 738 nodes, worst distance error 3.7e-03 m against a reported precision of 0.01 m, every returned position being the node's, 0 equidistant ties, smallest margin to the second-nearest node 0.43 m",
   "ranAt": "2026-10-11T22:07:42.204889+00:00",
   "note": "A nearest-neighbour search and a distance, both exact. Eight pumps rather than the isochrone example's one, because a search over a single site exercises almost nothing. The criterion is 5 mm rather than 1 mm, and the reason is worth stating: the widget reports snapDistanceM as Number(d.toFixed(2)), so it computes in full precision and publishes centimetres, and 5 mm is half of its last reported digit rather than a statement about its accuracy. The first version of this check asked for 1 mm and failed at 3.7 mm, which was rounding and nothing else. The margin to the second-nearest node is reported because one site's is 0.43 m: no tie, so the answer is unambiguous, but the choice is decided by less than a pavement's width and a different datum would flip it. Agreement says nothing about whether snapping is harmless -- it moves the pumps 2.2 to 20.9 m, up to 5.6% of the five-minute band budget, and both implementations move them identically."
  },
  {
   "widget": "urn:fieldwork:widget:travel_time_band",
   "coversRelease": "0.3.0",
   "check": "20-band",
   "result": "content/results/check-20-band.json",
   "sha256": "d3a49abc01c08560b4ac606d433a781ac8354e5b44a7a0c97f1aa14ba423ff37",
   "external": [
    "none: a band is a threshold on distances the junctions carry"
   ],
   "criterion": "the band budget within 0.005 m of minutes x the speed carried on the junctions, the same junctions selected, every remaining budget recomputed against the band to within 0.005 m, the counts exact, every kept junction stamped with the band, and the band nested rather than a ring",
   "outcome": "agrees",
   "measured": "142 of 706 junctions selected, band budget 375.00 m against 375.00 m recomputed from the speed on the junctions, worst remaining-budget error 5.7e-14 m, nested rather than a ring",
   "ranAt": "2026-10-11T22:08:17.123562+00:00",
   "note": "The arithmetic is a threshold and is not what this check is for. The design claim is that the widget restates neither the speed nor the direction, reading both from the junctions, so a band cannot disagree with the traversal that produced it -- and the reference tests exactly that, recomputing the budget from the speed carried on the junctions rather than from a parameter of its own. It also checks the part most likely to be got wrong: a junction's remaining budget is recomputed against the band, not carried over from the traversal. Here the traversal was 1,125 m and the band 375 m, so carrying it over would put fifteen minutes of reach at the edge of a five-minute corridor. The notebook measures the sensitivity to the walking speed, which is an estimate from photographs of 1854 London rather than a measurement: at 50 m/min 69 junctions are in the band, at 75 m/min 142, at 100 m/min 246. Walking 20% slower keeps about two thirds; a third slower halves it."
  },
  {
   "widget": "urn:fieldwork:widget:hex_aggregate",
   "coversRelease": "0.1.0",
   "check": "21-hex",
   "result": "content/results/check-21-hex.json",
   "sha256": "1463c8aeacb9278d82ef79c8bfef773416a99c5eb23fdd506079420d87682447",
   "external": [
    "h3-py 4.5.0"
   ],
   "criterion": "per resolution: the same cells kept, the same count in each, each boundary and centre within 1e-09 degrees of h3-py's, the cells ordered by H3 index, and the matched and dropped point counts exact",
   "outcome": "agrees",
