{
  "name": "fieldwork-semantic-gis",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node scripts/test-unit.mjs",
    "test:browser": "playwright test",
    "test:report": "playwright show-report",
    "check": "npm run build && node scripts/test-unit.mjs && npm run test:browser",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json --noEmit",
    "validate:ontology": "node scripts/validate-ontology.mjs",
    "validate:widgets": "node scripts/validate-widgets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@turf/area": "7.3.5",
    "@turf/boolean-point-in-polygon": "7.3.5",
    "@turf/buffer": "7.3.5",
    "@xyflow/react": "^12.12.0",
    "@zip.js/zip.js": "2.23.0",
    "geotiff": "3.0.5",
    "h3-js": "4.5.0",
    "leaflet": "^1.9.4",
    "polyclip-ts": "0.16.8",
    "proj4": "2.19.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "1.14.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "esbuild": "^0.28.2",
    "n3": "2.13.8",
    "rdf-validate-shacl": "0.6.5",
    "typescript": "7.0.2"
  }
}
