{
  "schema": "fieldwork/ruleset/1",
  "id": "urn:fieldwork:ruleset:extract-contract",
  "version": "1.0.0",
  "title": "Published projection extract",
  "released": "2026-10-26",
  "description": "Declares what a long-format extract of a published projection dataset must carry before anything is computed from it: the key columns that identify a projected value, the units its values may be stated in, and the closed vocabulary of its family column. The AR6 particulars are declared here as data; nothing about sea level is compiled into a widget.",
  "mustNotBeReadAs": "A statement that the numbers are correct, or that this dataset is the right one for a question. It is a contract about a table's shape and declarations. In particular: a basis identifier is uninterpretable without the kind of identifier it is -- wf_1e is ONE workflow, \"medium\" is a p-box over several, and A P-BOX BOUND IS NOT A QUANTILE OF ONE DISTRIBUTION. And a conversion between millimetres and metres is RECORDED here, never performed: a decomposition that performed it would change every comparison downstream.",
  "rules": "# Projection extract contract. Declares what a published projection table must carry; it concludes nothing about sea level.\n{ ?p fw:projectedValueKnown false. } => { ?p fw:extractRow fw:Unreadable. }.\n{ ?p fw:projectedValueKnown true. } => { ?p fw:extractRow fw:Readable. }.\n",
  "parameters": [],
  "inputContract": {
    "factGenerator": "src/authored-application.ts#authoredFacts",
    "subjectKind": "projected values",
    "expects": [
      {
        "predicate": "fw:projectedValueKnown",
        "type": "boolean"
      },
      {
        "predicate": "fw:projectedValue",
        "type": "number",
        "unit": "http://qudt.org/vocab/unit/MilliM"
      }
    ],
    "tableContract": {
      "requiredKeys": [
        "site_id",
        "scenario",
        "basis",
        "family",
        "year",
        "quantile"
      ],
      "allowedUnits": [
        "metre",
        "millimetre"
      ],
      "closedVocabulary": [
        {
          "column": "family",
          "values": [
            "with_vlm",
            "without_vlm"
          ],
          "meaning": "A family that includes vertical land motion and one that excludes it are not comparable, so a row outside the declared pair is refused rather than averaged in."
        }
      ],
      "declares": [
        {
          "name": "datasetVersion",
          "value": "20210809",
          "meaning": "The dataset version these values are comparable within. Zenodo returns the same string for the dataset DOI, so this can be checked against its source rather than trusted."
        },
        {
          "name": "baselinePeriod",
          "value": "1995-2014",
          "meaning": "The period the projected change is measured from. A projected value is a CHANGE from the dataset's baseline sea surface, so +0.5 m means nothing without it, and comparing it to an elevation is meaningful only when that elevation is measured from the same surface."
        },
        {
          "name": "basisKind",
          "value": "confidence-pbox",
          "meaning": "What the basis column names in this dataset's confidence output files. A basis identifier is uninterpretable without the kind of identifier it is: wf_1e is one published workflow, \"medium\" is a p-box combining workflow p-boxes, and a p-box bound is not a quantile of one distribution."
        },
        {
          "name": "valueConversion",
          "value": "millimetre to metre, recorded and not performed",
          "meaning": "The published files state sea_level_change in millimetres and comparisons are made in metres. The conversion is recorded on the result rather than applied to the data: any step that performed it would change every comparison downstream, silently."
        },
        {
          "name": "familyWithVerticalLandMotion",
          "value": "with_vlm",
          "meaning": "The value in the family column marking projections that include vertical land motion. Families that include and exclude it are not comparable."
        },
        {
          "name": "familyWithoutVerticalLandMotion",
          "value": "without_vlm",
          "meaning": "The value in the family column marking projections that exclude vertical land motion."
        }
      ]
    },
    "fieldFrom": [
      {
        "attribute": "value_mm",
        "predicate": "fw:projectedValue",
        "kind": "number",
        "label": "Projected change",
        "unitLabel": "mm"
      }
    ],
    "ports": {
      "inputs": [
        [
          "projections",
          "table"
        ]
      ],
      "output": "table"
    },
    "projection": "declared",
    "parameterFrom": {},
    "portsNote": "A table in and a table out, carrying what the contract concluded about each row as a further key column. The extract widget passed its table through unchanged with a provenance bag attached; the bag was a token meaning the contract was satisfied, and the contract is declared here instead.",
    "note": "The binding names the column the rules read, so nothing is guessed from a spelling. `value_mm` is this dataset's own column name and lives here, in data, rather than as a constant in a widget -- which is the whole of what made the old extract widget sea-level-specific."
  },
  "outputVocabulary": {
    "predicates": [
      {
        "predicate": "fw:extractRow",
        "values": [
          "Readable",
          "Unreadable"
        ],
        "unknownValue": "Unreadable"
      }
    ],
    "unmatchedSubjectsExpected": false,
    "note": "Every row reaches one of the two conclusions, because the two conditions are each other's negation. A subject no rule fired on would mean the fact generator produced no fw:projectedValueKnown for it, which is a gap in the binding rather than a finding about the data."
  },
  "basis": {
    "status": "published",
    "statedBy": "The dataset's own documentation, carried here rather than typed into a widget. The practitioner, 2026-10-26: the provenance fields \"become citation entries for the ruleset\". That pins them to a ruleset VERSION, which is what makes the dataset version meaningful -- values are not comparable across dataset versions, so a different dataset version is a different ruleset version by construction. Decomposing a vocabulary preserves a wrong one as faithfully as a right one: nothing here re-reads that documentation.",
    "evidence": [
      {
        "id": "ar6-chapter9",
        "kind": "url",
        "url": "https://doi.org/10.1017/9781009157896.011",
        "title": "Ocean, Cryosphere and Sea Level Change (IPCC AR6 WG1, Chapter 9)",
        "role": "source",
        "authors": "Fox-Kemper, B., et al.",
        "published": "2021",
        "locator": "10.1017/9781009157896.011",
        "notes": "Resolves as a book-chapter. Supports the six key columns and the baseline period. Its DOI registers issued 2023-07-06 against a citation text reading 2021 -- a publication-versus-registration difference, not an error, and exactly the discrepancy a practitioner should not have to explain from memory at a venue (docs/research/doi-resolution-probe-2026-10-17.md).",
        "addedAt": "2026-10-26",
        "modifiedAt": "2026-10-26"
      },
      {
        "id": "facts-v1",
        "kind": "url",
        "url": "https://doi.org/10.5194/gmd-16-7461-2023",
        "title": "FACTS v1.0: The Framework for Assessing Changes To Sea-level",
        "role": "method",
        "authors": "Kopp, R. E., et al.",
        "published": "2023",
        "locator": "10.5194/gmd-16-7461-2023",
        "notes": "Resolves as a journal-article. Supports what the basis column names, and why a p-box bound is not a quantile of one distribution.",
        "addedAt": "2026-10-26",
        "modifiedAt": "2026-10-26"
      },
      {
        "id": "ar6-dataset",
        "kind": "url",
        "url": "https://doi.org/10.5281/zenodo.5914709",
        "title": "IPCC AR6 Sea Level Projections",
        "role": "data",
        "authors": "Garner, G. G., et al.",
        "published": "2021",
        "locator": "10.5281/zenodo.5914709",
        "notes": "Resolves as a dataset and returns version 20210809, which is the dataset version these values are comparable within. The version can therefore be CHECKED rather than trusted: a typo in it would otherwise be invisible and propagate into every receipt.",
        "addedAt": "2026-10-26",
        "modifiedAt": "2026-10-26"
      }
    ],
    "unresolvedCitations": [],
    "note": "WHY THESE THREE ARE OBLIGATORY, and not bookkeeping. The practitioner, 2026-10-26: \"it's something the authors require of users, and if the users present to an audience they will be held accountable by other scientists to that provenance requirement.\" The obligation is to the dataset's authors and to the room, not to the arithmetic. Experiment 115's P2 made provenance an alert rather than a blocker on the ground that no provenance field changes a computed number -- which is true, and is the wrong measure of what it costs to omit one. A figure published without them is not wrong; its author is unable to answer the first question a scientist asks of it.\n\nCarrying them HERE is what makes the obligation travel. A ruleset is pinned by id and version on every receipt, so a practitioner cannot apply this contract and arrive at an audience without the citations the authors require. Typed into a widget, they were whatever somebody remembered to enter.\n\nALL THREE ARE DOIs AND ALL THREE RESOLVE, verified 2026-10-17 against the public DOI system with nothing of a practitioner's sent. That is what makes them answer the question in the room: the practitioner, 2026-10-26, \"the citations are also DOIs, so when transmitted and embedded in the output they are independently verifiable\" -- by the audience, without trusting this application or the person presenting."
  },
  "authored": {
    "subject": "?p",
    "comment": "Projection extract contract. Declares what a published projection table must carry; it concludes nothing about sea level.",
    "rules": [
      {
        "any": [
          {
            "all": [
              {
                "field": "fw:projectedValueKnown",
                "comparator": "equals",
                "value": false
              }
            ]
          }
        ],
        "then": [
          {
            "predicate": "fw:extractRow",
            "value": "fw:Unreadable"
          }
        ]
      },
      {
        "any": [
          {
            "all": [
              {
                "field": "fw:projectedValueKnown",
                "comparator": "equals",
                "value": true
              }
            ]
          }
        ],
        "then": [
          {
            "predicate": "fw:extractRow",
            "value": "fw:Readable"
          }
        ]
      }
    ]
  },
  "obligation": {
    "summary": "Applying this contract commits you to citing three sources whenever you publish or present what you make with it. They are required by the dataset's authors, not by this application.",
    "whatYouTakeOn": "The IPCC AR6 sea-level projections are published on terms that oblige a user to cite the chapter, the FACTS framework paper and the dataset version. The obligation is to the authors and to whoever reads your figure. It is not discharged by this application having the citations: it is discharged by them appearing on what you show people.",
    "howToAcknowledge": "Connect this step's provenance output to the output that will carry it. Connecting it is how you say you know the citations are required; the citations then appear on the figure or table, which is the evidence that you did. All three are DOIs, so a reader can resolve them without trusting you or this application.",
    "ifYouDoNot": "The run stops with an error and produces no output. Not a warning beside a figure -- no figure. A figure that travelled without its citations would leave you unable to answer the first question a scientist asks of it, which is where the numbers came from.",
    "editable": true,
    "note": "The author's words, pinned to this ruleset version and carried on every receipt. A practitioner may rewrite them for their own setting, and an earlier draft of this field forbade it. That was a false protection: locking text stops nobody determined, and the hard constraint is structural rather than editorial -- no connection, no output, whatever the wording says. The practitioner, 2026-10-26: \"they could soften it as much as they can, but the hard constraint and the accountability to audience and the consequences of shirking that responsibility will always make them think twice -- the consequences are real, even if they manage to skirt around the responsibility: non-acceptance of a publication, questioning by peers during a presentation.\"\n\nWhat is kept is ATTRIBUTION, not control. The original stays here, pinned; a rewrite is recorded as the practitioner's revision in the same way a repaired column is -- prov:qualifiedRevision, the source unchanged, the change attributed. So a softened obligation is never read in the authors' voice, which is the only thing an application can honestly protect."
  }
}
