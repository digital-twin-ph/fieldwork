  "isochrone": {
   "version": "0.4.0",
   "released": "2026-10-20",
   "changes": [
    {
     "kind": "changed",
     "description": "Declares fw:travelMode, which src/catchments.ts began asserting when street networks gained a walking or driving mode: the mode a graph was filtered for is now on the network entity in the receipt. Nothing about how an isochrone is computed changed. This widget reads the mode rather than setting it, and a graph downloaded for driving is refused by the reachability step it is built on if that step says walking."
    },
    {
     "kind": "minor",
     "description": "Optional bounded list of cumulative time thresholds and explicit interior-hole infill; preserves single-time corridor defaults."
    },
    {
     "kind": "changed",
     "description": "All three segments of a walk are now charged and drawn. The walk onto the network comes out of the budget; the walk off it at the end is the leg the budget still allows up to bufferM, so the region ends at its own time rather than bufferM beyond it; and the region is the whole route buffered rather than the streets alone. A site beyond the snap limit is routed anyway and marked off-network instead of ending the run, and one whose walk alone spends the budget gets no catchment and is named. Results change: the John Snow bands shrink by 39.3%, 13.8%, 4.2% and 0%, and the one-minute band holds 21 locations and 65 deaths where it held 48 and 110. Experiment 114."
    }
   ],
   "breaking": false,
   "migrationFrom": []
  },
