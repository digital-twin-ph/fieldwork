+/// Read an extract that is already in memory, which is the only shape it has in
+/// a browser: wasm32 has no filesystem, and `BlobReader` is generic over any
+/// `Read + Send`. Added for a fieldwork measurement, 2026-10-22.
+pub fn read_pbf_bytes(
+    bytes: &[u8],
+    network_type: NetworkType,
+) -> Result<(OsmData, Vec<Poi>), OsmGraphError> {
+    let scan = scan_reader(std::io::Cursor::new(bytes), &[network_type])?;
+    Ok((scan.xml_data(&scan.roads[0]), scan.pois))
+}
