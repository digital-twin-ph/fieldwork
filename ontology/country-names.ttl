# WRITTEN BY scripts/country-names.mjs from ontology/country-names.json's sources. Do not edit by hand.

<urn:fieldwork:ontology:country-names> a owl:Ontology;
  rdfs:label "Country names by source";
  rdfs:comment "Every country Fieldwork's sources name. Each is a fw:Jurisdiction identified by its ISO 3166-1 alpha-3 code, with its alpha-2 and alpha-3 codes as typed SKOS notations and one SKOS-XL label per source saying which source gives that name. No source's name is preferred: the code is the key, and every name is an alias of it.".

<urn:fieldwork:scheme:iso-3166-1-alpha-3> rdfs:label "ISO 3166-1 alpha-3".
<urn:fieldwork:scheme:iso-3166-1-alpha-2> rdfs:label "ISO 3166-1 alpha-2".
<urn:fieldwork:source:geoboundaries> a dcat:Dataset;
  dcterms:title "geoBoundaries gbOpen, ADM0";
  dcat:landingPage <https://www.geoboundaries.org/api/current/gbOpen/ALL/ADM0/>.
<urn:fieldwork:source:natural-earth> a dcat:Dataset;
  dcterms:title "Natural Earth 1:110m Admin 0 countries";
  dcat:landingPage <https://github.com/nvkelso/natural-earth-vector>;
  dcterms:license "Public domain. Natural Earth states no restrictions on use.".
<urn:fieldwork:source:un-m49> a dcat:Dataset;
  dcterms:title "ISO 3166-1 codes and UN M49 official English short names, as packaged by datasets/country-codes";
  dcat:landingPage <https://github.com/datasets/country-codes/blob/main/data/country-codes.csv>;
  dcterms:license "The package is ODC-PDDL-1.0 for its maintainers' own work only. The codes are facts; the names come from the UN Statistics Division (M49), whose terms were not checked on the M49 page itself.".

