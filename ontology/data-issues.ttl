@prefix fw: <urn:fieldwork:>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dqv: <http://www.w3.org/ns/dqv#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

# DATA ISSUES: everything a step finds about its records that it does not resolve, as one kind of thing with one closed
# list of kinds. Experiment 207. The practitioner, 2026-11-12: "There should be an ontology for data issues." Built on
# W3C's Data Quality Vocabulary (https://www.w3.org/TR/vocab-dqv/, CC BY 4.0): an issue is a quality measurement, a
# count of records over one metric. DQV names no dimensions; these are Fieldwork's. ISO/IEC 25012, which names some, is
# not openly available and was not read.

<urn:fieldwork:ontology:data-issues> a owl:Ontology;
  owl:versionInfo "0.1 experimental, 2026-11-12";
  dcterms:source <https://www.w3.org/TR/vocab-dqv/>;
  rdfs:comment "What a step found about its records and did not resolve. An issue is not an error: the result stands, and the issue says which part of it is about an absence, a repeat or a disagreement.".

fw:DataIssue a owl:Class; rdfs:subClassOf dqv:QualityMeasurement;
  rdfs:label "Data issue";
  rdfs:comment "How many of the records one step considered it found with one kind of issue, in one column or field where there is one.".
fw:dataIssue a owl:ObjectProperty; rdfs:range fw:DataIssue;
  rdfs:label "data issue";
  rdfs:comment "An issue the step found. Absent when it found none.".
fw:issueKind a owl:ObjectProperty; rdfs:domain fw:DataIssue; rdfs:range fw:DataIssueKind;
  rdfs:label "kind of issue".
fw:issueColumn a owl:DatatypeProperty; rdfs:domain fw:DataIssue; rdfs:range xsd:string;
  rdfs:label "column, field or site";
  rdfs:comment "As the source spells it, so a reader can find it in their own file.".
fw:DataIssueKind a owl:Class; rdfs:subClassOf skos:Concept;
  rdfs:label "Kind of data issue".
fw:dataIssueKinds a skos:ConceptScheme; rdfs:label "Kinds of data issue".

# The two existing models, now kinds of this one. Their IRIs are unchanged (ontology/fieldwork.ttl).
fw:ReadingProblem rdfs:subClassOf fw:DataIssue.
fw:JoinFinding rdfs:subClassOf fw:DataIssue.
fw:ValueProblemKind rdfs:subClassOf fw:DataIssueKind.

# Dimensions. completeness and readability are declared in ontology/fieldwork.ttl.
fw:uniqueness a dqv:Dimension; rdfs:label "Whether what should identify one record identifies only one".
fw:documentation a dqv:Dimension; rdfs:label "Whether what the data means has been said".
fw:consistency a dqv:Dimension; rdfs:label "Whether two statements about the same thing agree".
fw:computability a dqv:Dimension; rdfs:label "Whether a value asked for can be computed from the values given".
fw:coverage a dqv:Dimension; rdfs:label "Whether the place or network reached what it was asked to reach".

# The kinds. Each says what it is, the dimension it measures, and its label as the screen shows it.
fw:ValueAbsent a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "No value"; fw:inDimension fw:completeness.
fw:ValueUnreadable a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Not the declared kind"; fw:inDimension fw:readability.
fw:KeyAbsent a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "No key"; fw:inDimension fw:completeness;
  skos:definition "A row has no value in a column that identifies it.".
fw:KeyRepeated a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Key repeated"; fw:inDimension fw:uniqueness;
  skos:definition "Two or more rows share the values that should identify one.".
fw:ColumnUndescribed a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Column not described"; fw:inDimension fw:documentation;
  skos:definition "Nobody has said what a column means. Describing it is the practitioner's step.".
fw:DescriptionUnconfirmed a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Description not confirmed"; fw:inDimension fw:documentation;
  skos:definition "A description came with the source and the practitioner has not accepted it.".
fw:DictionaryMismatch a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Disagrees with the data dictionary"; fw:inDimension fw:consistency;
  skos:definition "The file and its data dictionary say different things about a column.".
fw:DeclarationAbsent a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Not declared"; fw:inDimension fw:documentation;
  skos:definition "Something a ruleset asks to be stated about the data, such as a citation, has not been.".
fw:DivisionByZero a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Divided by zero"; fw:inDimension fw:computability;
  skos:definition "A value a rule computes would divide by zero, and is left empty.".
fw:ConclusionsConflict a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Rules disagree"; fw:inDimension fw:consistency;
  skos:definition "Two rules gave one record different values in one column.".
fw:SiteUnreachable a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "No result"; fw:inDimension fw:coverage;
  skos:definition "A site is farther from the street network than the travel budget allows.".
fw:RoutedOffNetwork a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Routed off the network"; fw:inDimension fw:coverage;
  skos:definition "A site's leg to the network was charged as a straight line, past the limit.".
# The Data quality inspector's finer kinds: a value absent because the record lacks the field, or because the field
# is there and empty (kept apart at the practitioner's request, 2026-10-21), and a value beyond the quartile fence.
fw:FieldMissing a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Field missing"; skos:broader fw:ValueAbsent; fw:inDimension fw:completeness;
  skos:definition "The record does not carry the field at all, as with a tag nobody added.".
fw:ValueEmpty a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Empty"; skos:broader fw:ValueAbsent; fw:inDimension fw:completeness;
  skos:definition "The record carries the field and it is blank: somebody wrote the column and left it empty.".
fw:BeyondFence a fw:DataIssueKind; skos:inScheme fw:dataIssueKinds; skos:prefLabel "Beyond 1.5×IQR"; fw:inDimension fw:plausibility;
  skos:definition "A number more than 1.5 times the interquartile range beyond the first or third quartile. A value to look at, not an error: no distribution is assumed.".
fw:plausibility a dqv:Dimension; rdfs:label "Whether a value sits where most of its column does".
fw:inDimension a owl:ObjectProperty; rdfs:domain fw:DataIssueKind; rdfs:range dqv:Dimension;
  rdfs:label "measures";
  rdfs:comment "The dimension a kind of issue measures. DQV relates a metric to a dimension (dqv:inDimension); this relates the kind.".
