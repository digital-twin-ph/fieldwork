@prefix fw: <urn:fieldwork:>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix geo: <http://www.opengis.net/ont/geosparql#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
# The W3C Data Quality Vocabulary, a 2016 Interest Group Note and companion to DCAT. Adopted
# 2026-10-17 after researching whether a data-quality ontology already existed: one does, for
# ASSESSMENT. Nothing in it concerns repairing data -- see experiment 117 -- so the repair side
# below specialises PROV-O instead, which is where it belongs.
@prefix dqv: <http://www.w3.org/ns/dqv#>.
# W3C's Evaluation and Report Language, a 2011 Working Group Note. Adopted 2026-10-17 for the
# same reason as DQV: an assertion that something passed or failed a criterion is a thing W3C
# has already modelled, and EARL's outcome set is closed and includes earl:cantTell -- a test
# that ran and could not decide, which is a distinction this project reached independently in
# experiments 65 and 117. EARL says plainly it does not cover test criteria or requirements, so
# the threshold and the rule statements below are this project's and the rest is not.
@prefix earl: <http://www.w3.org/ns/earl#>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

# Bounded catchment primitives, experimental implementation (2026-10-07).
fw:VoronoiComputation a owl:Class;
  rdfs:label "Voronoi catchment computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Projected Euclidean nearest-site allocation; not observed facility use.".
fw:NetworkIsochrone a owl:Class;
  rdfs:label "Network isochrone computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Directed network reachability with explicit cost, snapping and corridor approximation.".
# Declared 2026-10-10 when the widget/ontology coupling was mechanised. These eleven
# terms had been asserted into receipts by sample_raster and buffer_point with nothing
# defining them: the release files described them in prose, and prose does not fail a build.
fw:sampledAttribute a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:string;
  rdfs:label "Raster attribute written onto each point".
fw:sampledValueUnit a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:string;
  rdfs:label "Unit of the sampled value, as stated by the practitioner";
  rdfs:comment "Absent when none was stated, which fw:valueUnitStatus records separately. A raster does not carry its own unit.".
fw:cellSizeX a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:decimal;
  rdfs:label "Raster cell width in the raster's own coordinate system".
fw:cellSizeY a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:decimal;
  rdfs:label "Raster cell height in the raster's own coordinate system";
  rdfs:comment "Emitted beside the width because a sampled value stands for the whole cell, so the cell's size is the resolution of the answer.".
fw:sampleConvention a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:string;
  rdfs:label "Rule by which a point takes a cell's value";
  rdfs:comment "Containing cell under PixelIsArea, with no interpolation: the point takes the value of the cell it falls in and neighbouring cells do not contribute.".
fw:sampledCount a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Points that took a value".
fw:noDataCount a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Points falling on a no-data cell";
  rdfs:comment "Inside the raster but unmeasured there, which is not the same as outside it.".
fw:outsideRasterCount a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Points falling outside the raster's extent".
fw:unlocatedCount a owl:DatatypeProperty; rdfs:domain fw:RasterPointSample; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Records with no coordinates, which could not be sampled";
  rdfs:comment "Counted separately from no-data and outside, because the three have different remedies.".
fw:sourcePoint a owl:DatatypeProperty; rdfs:domain fw:PointBuffer; rdfs:range xsd:string;
  rdfs:label "Identifier of the point a circle was drawn around".
fw:circleAreaFraction a owl:DatatypeProperty; rdfs:domain fw:PointBuffer; rdfs:range xsd:decimal;
  rdfs:label "Fraction of the true circle's area the polygon covers";
  rdfs:comment "A buffer is a polygon approximating a circle, so it is smaller than the circle it stands for. Emitted so the approximation is a number rather than a footnote.".
fw:MicroWorkflow a owl:Class;
  rdfs:label "Micro-workflow"; fw:implementationStatus "implemented"; rdfs:subClassOf prov:Plan;
  rdfs:comment "A composition of registry widgets used as one step. A plan rather than an operation: it computes nothing itself, and the members it arranges report their own work. Pinned by version, because what it arranged is only reproducible against the versions it named.".
fw:MicroWorkflowExpansion a owl:Class;
  rdfs:label "Micro-workflow expansion"; fw:implementationStatus "implemented"; rdfs:subClassOf prov:Activity;
  rdfs:comment "The act of replacing one composition node with its members before a run. It states the association between the members and the plan and asserts fw:claimsNoComputation, because a composition must not take credit for what its members did. Without it a run's receipts read as unrelated primitives, which is true but incomplete.".
fw:compositionId a owl:DatatypeProperty; rdfs:domain fw:MicroWorkflow; rdfs:range xsd:string;
  rdfs:label "Identifier of the composition".
fw:compositionVersion a owl:DatatypeProperty; rdfs:domain fw:MicroWorkflow; rdfs:range xsd:string;
  rdfs:label "Version of the composition as pinned";
  rdfs:comment "The version the workflow named, not the newest available. Drift is the difference between the two.".
fw:compositionStage a owl:DatatypeProperty; rdfs:domain fw:MicroWorkflow; rdfs:range xsd:string;
  rdfs:label "Workflow stage the composition's name asserts".
fw:governanceStatus a owl:DatatypeProperty; rdfs:domain fw:MicroWorkflow; rdfs:range xsd:string;
  rdfs:label "Whether the composition is private, shared or admitted";
  rdfs:comment "Carried into the run so that a result produced with an unreviewed composition says so, rather than a reader having to go and look.".
fw:memberCount a owl:DatatypeProperty; rdfs:domain fw:MicroWorkflowExpansion; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Members the composition arranged".
fw:claimsNoComputation a owl:DatatypeProperty; rdfs:domain fw:MicroWorkflowExpansion; rdfs:range xsd:boolean;
  rdfs:label "States that this activity performed no computation";
  rdfs:comment "Asserted rather than left to inference, so that a reader counting activities does not credit the arrangement with the work.".
fw:memberOf a owl:ObjectProperty; rdfs:range fw:MicroWorkflow;
  rdfs:label "Plan a member node belongs to";
  rdfs:subPropertyOf dcterms:isPartOf;
  rdfs:comment "A sub-property of dcterms:isPartOf rather than equivalent to it: this one is narrower, since its range is a micro-workflow plan and part-hood in general is not. src/spatial-coverage.ts already emits dcterms:isPartOf directly for a record belonging to a source, so the project was using the standard term in one place and its own in another for the same kind of relation.".
fw:memberNode a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Identifier of a member node within the run".
fw:compositionParameter a owl:ObjectProperty; rdfs:domain fw:MicroWorkflowExpansion;
  rdfs:label "A public parameter the composition was run with";
  rdfs:comment "Recorded as a name and a value because the composition's parameters are what a practitioner chose, while its members' parameters are derived from them.".
fw:parameterName a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Name of a composition parameter".
fw:parameterValue a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Value a composition parameter was given, as text";
  rdfs:comment "As text, deliberately: these are the values a practitioner typed, and preserving the form they were given in is more useful than a typed guess.".
fw:InteriorGapFill a owl:Class;
  rdfs:label "Interior gap fill"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Each polygon replaced by its outer ring, so enclosed gaps become solid. This enlarges the polygon and the added ground was never computed as covered, so anything measuring the result afterwards measures ground nothing reached. What a gap means depends on the source: in a travel corridor it is ground no street reached, and in an administrative boundary it would be a real enclave.".
fw:gapsFilled a owl:DatatypeProperty; rdfs:domain fw:InteriorGapFill; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Enclosed gaps filled".
fw:areaBeforeSquareMetres a owl:DatatypeProperty; rdfs:domain fw:InteriorGapFill; rdfs:range xsd:decimal;
  rdfs:label "Area before filling, in square metres".
fw:areaAfterSquareMetres a owl:DatatypeProperty; rdfs:domain fw:InteriorGapFill; rdfs:range xsd:decimal;
  rdfs:label "Area after filling, in square metres".
fw:areaAddedSquareMetres a owl:DatatypeProperty; rdfs:domain fw:InteriorGapFill; rdfs:range xsd:decimal;
  rdfs:label "Area claimed by filling that was not claimed before";
  rdfs:comment "Emitted so the size of the assertion is a number. Measured at 4 to 5 per cent of the corridor area on the case study this was derived from.".
fw:PolygonCollection a owl:Class;
  rdfs:label "Polygon collection"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Several polygon layers gathered into one with nothing merged, ordered largest first so smaller polygons draw on top. Unlike fw:CombinedArea it keeps what distinguished the parts, which is what lets a later summary count memberships per polygon.".
fw:layerCount a owl:DatatypeProperty; rdfs:domain fw:PolygonCollection; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Layers gathered".
fw:polygonCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Polygons acted on";
  rdfs:comment "No domain: asserted by fw:PolygonCollection and fw:InteriorGapFill.".
fw:bandedPolygonCount a owl:DatatypeProperty; rdfs:domain fw:PolygonCollection; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Polygons carrying a travel time";
  rdfs:comment "When every polygon carries one, the collection is a set of nested bands and a count per band is cumulative rather than disjoint.".
fw:drawOrder a owl:DatatypeProperty; rdfs:domain fw:PolygonCollection; rdfs:range xsd:string;
  rdfs:label "Order the polygons are given in, for drawing".
fw:TravelTimeBand a owl:Class;
  rdfs:label "Travel time band"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Narrows a reachable set to a shorter travel time and recomputes the budget left at each junction against it. Bands from one traversal are cumulative, not disjoint: a five minute band contains the one minute band.".
fw:bandMinutes a owl:DatatypeProperty; rdfs:domain fw:TravelTimeBand; rdfs:range xsd:decimal;
  rdfs:label "Travel time this band keeps, in minutes".
fw:bandBudgetMetres a owl:DatatypeProperty; rdfs:domain fw:TravelTimeBand; rdfs:range xsd:decimal;
  rdfs:label "Band budget, in metres".
fw:traversalBudgetMetres a owl:DatatypeProperty; rdfs:domain fw:TravelTimeBand; rdfs:range xsd:decimal;
  rdfs:label "Budget of the traversal being narrowed, in metres";
  rdfs:comment "Recovered from the junctions themselves rather than restated, and emitted so that a band can be seen to narrow rather than widen.".
fw:junctionsOffered a owl:DatatypeProperty; rdfs:domain fw:TravelTimeBand; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Junctions the traversal offered".
fw:junctionsInBand a owl:DatatypeProperty; rdfs:domain fw:TravelTimeBand; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Junctions within this band".
fw:ReachableCorridor a owl:Class;
  rdfs:label "Reachable corridor computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "A buffer around the street segments a traveller can enter within a budget, truncated where the budget runs out mid-block. The half-width is a claim that anywhere within it is reached, which includes the insides of buildings and the far side of walls.".
fw:corridorCount a owl:DatatypeProperty; rdfs:domain fw:ReachableCorridor; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Corridors produced, one per origin".
fw:enteredSegmentCount a owl:DatatypeProperty; rdfs:domain fw:ReachableCorridor; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Street segments entered at all".
fw:partialSegmentCount a owl:DatatypeProperty; rdfs:domain fw:ReachableCorridor; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Street segments entered only part-way";
  rdfs:comment "Where the budget ran out mid-block. This is what places the edge of the travel time between junctions rather than at them.".
fw:corridorHalfWidthMetres a owl:DatatypeProperty; rdfs:domain fw:ReachableCorridor; rdfs:range xsd:decimal;
  rdfs:label "Distance either side of a street counted as reached";
  rdfs:comment "25 metres in the case study this was derived from, passed as edge_buff with no reason recorded. Emitted because the reached area scales with it.".
fw:NetworkReachability a owl:Class;
  rdfs:label "Network reachability computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Cheapest-path traversal of a street network from an origin up to a travel budget, emitting the reached junctions with the budget left at each. Cost is supplied street length over one constant speed: a geometry of the graph, not a geography of access.".
fw:originCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Number of origins traversed from";
  rdfs:comment "No domain: asserted by both fw:NetworkReachability and fw:ReachableCorridor. Keeping the reachability domain would have made every corridor an inferred traversal, which it is not.".
fw:reachedNodeCount a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Reached junctions, summed over the origins".
fw:travelBudgetMetres a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:decimal;
  rdfs:label "Travel budget, in metres";
  rdfs:comment "The quantity actually traversed on. The minutes are this divided by the assumed speed.".
fw:travelBudgetMinutes a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:decimal;
  rdfs:label "Travel budget as asked for, in minutes".
fw:assumedSpeedMetresPerMinute a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:label "Single speed assumed for every traveller and every street";
  rdfs:comment "No domain: asserted by fw:NetworkReachability and by fw:TravelTimeBand, which restates the speed it was given rather than choosing one. Emitted beside the minutes so a reader can divide back out to the metres that were really used. A speed is an assumption about a place in a period and does not transfer between settings: the 75 metres per minute this project long defaulted to is 4.5 km/h from a case study of pedestrians in Soho in 1854.".
fw:travelMode a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:string;
  rdfs:label "Kind of travel the speed is meant to represent";
  rdfs:comment "One of walking, cycling, driving or other, checked against the speed so that a mode and a number cannot contradict each other. Public transport is not among them: it follows routes and a timetable rather than the street network.".
fw:travelDirection a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Whether travel was outbound from the origin or inbound to it";
  rdfs:comment "No domain, for the reason fw:originCount states. A corridor restates the direction it was given rather than choosing one.".
fw:attachedOriginCount a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Origins this step attached to the network itself";
  rdfs:comment "Distinct from fw:siteCount, which is domained to fw:NetworkSnap and counts every site that widget moved. This counts only the origins that arrived WITHOUT a junction and were attached here, so a run mixing attached and already-snapped origins reports a number smaller than its origin count. Reusing fw:siteCount would have read as the whole input and crossed a declared domain.".
fw:attachmentLimitMetres a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:decimal;
  rdfs:label "Distance past which an origin attached here is marked as crossing unmapped ground";
  rdfs:comment "Absent means no limit was set, and no origin is marked. An origin beyond the limit is attached anyway and marked, never dropped. The snap widget's equivalent is fw:snapLimitMetres, domained to fw:NetworkSnap.".
fw:edgeLengthSource a owl:DatatypeProperty; rdfs:domain fw:NetworkReachability; rdfs:range xsd:string;
  rdfs:label "Where the street lengths came from";
  rdfs:comment "This activity re-measures no geometry, so it needs no projected CRS and takes the lengths on trust. Naming the source is the only check available to a reader.".
fw:NetworkSnap a owl:Class;
  rdfs:label "Network snap computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Attaches each site to its nearest network node by straight-line distance in a projected CRS. The distance is recorded and not charged to any later travel time, so a site set back from the road is treated as if it were on it.".
fw:siteCount a owl:DatatypeProperty; rdfs:domain fw:NetworkSnap; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Number of sites snapped".
fw:snappedNodeCount a owl:DatatypeProperty; rdfs:domain fw:NetworkSnap; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Distinct network nodes the sites snapped to";
  rdfs:comment "Fewer than the site count means sites share a node and are indistinguishable to anything routed from there.".
fw:greatestSnapDistanceMetres a owl:DatatypeProperty; rdfs:domain fw:NetworkSnap; rdfs:range xsd:decimal;
  rdfs:label "Furthest any site moved to reach the network, in metres".
fw:snapLimitMetres a owl:DatatypeProperty; rdfs:domain fw:NetworkSnap; rdfs:range xsd:decimal;
  rdfs:label "Distance beyond which a site is refused rather than snapped".
fw:CombinedArea a owl:Class;
  rdfs:label "Combined area computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Union of areas in a projected CRS. Answers whether anywhere is covered, not how well: two areas overlapping meant two things reached the same ground, and combining them discards that along with whatever distinguished the parts.".
fw:partCount a owl:DatatypeProperty; rdfs:domain fw:CombinedArea; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Number of areas combined".
fw:combinedPieceCount a owl:DatatypeProperty; rdfs:domain fw:CombinedArea; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Separate pieces in the result";
  rdfs:comment "Areas that do not touch stay separate, so this is not always one.".
fw:partsAreaSquareMetres a owl:DatatypeProperty; rdfs:domain fw:CombinedArea; rdfs:range xsd:decimal;
  rdfs:label "Summed area of the parts, in square metres".
fw:combinedAreaSquareMetres a owl:DatatypeProperty; rdfs:domain fw:CombinedArea; rdfs:range xsd:decimal;
  rdfs:label "Area of the combination, in square metres";
  rdfs:comment "Emitted beside the summed parts so that overlap is a number rather than something a reader infers.".
fw:ConvexHull a owl:Class;
  rdfs:label "Convex hull computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "The smallest convex outline containing located points, computed in a projected CRS. An outline of what was observed, not a service area, a catchment or an agreed boundary. Convex: a distribution that is not is filled in, so the hull covers ground nothing was observed on.".
fw:hullVertexCount a owl:DatatypeProperty; rdfs:domain fw:ConvexHull; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Hull vertex count".
fw:hullAreaSquareMetres a owl:DatatypeProperty; rdfs:domain fw:ConvexHull; rdfs:range xsd:decimal;
  rdfs:label "Hull area in square metres";
  rdfs:comment "Stated rather than thresholded. Points on one meridian are collinear in degrees and not in metres, so they yield a correct hull of a few square metres spanning kilometres; a cutoff would also refuse a genuinely thin distribution.".
fw:hullSpanMetres a owl:DatatypeProperty; rdfs:domain fw:ConvexHull; rdfs:range xsd:decimal;
  rdfs:label "Greatest distance across the hull, in metres".
fw:areaSquareMetres a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:label "Enclosed area of a polygon, in square metres";
  rdfs:comment "Read FROM a record rather than recomputed: a widget that projected to metres attaches it, and one that worked in degrees attaches nothing. Distinct from fw:hullAreaSquareMetres, which states one hull's area in its own receipt; this is the quantity a later step can bind a rule to. Experiment 113.";
  fw:implementationStatus "implemented".
fw:spanMetres a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:label "Greatest distance across a geometry, in metres";
  rdfs:comment "Of the GEOMETRY, as fw:areaSquareMetres is. Distinct from fw:hullSpanMetres, which is a quantity of the hull COMPUTATION -- what that step measured -- and so is asserted of an activity. An activity has no width, which is why the two are separate terms rather than one related to the other: a subPropertyOf between them would entail that a computation spans metres.";
  fw:implementationStatus "implemented".
fw:areaKnown a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:label "Whether an area was measured for this subject";
  rdfs:comment "Asserted for every subject, including the ones with no area, because the rule subset excludes negation-as-failure: absence has to be a measured fact rather than an inference from silence. False concludes fw:Unknown, which is a result and not a failure. The companion of fw:distanceKnown, fw:alertKnown and fw:accessKnown; experiment 65 records why the pattern exists.";
  fw:implementationStatus "implemented".
fw:metricCRS a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Projected CRS a metric computation used";
  rdfs:comment "The projection an operation computed metres in, as this project's short form -- \"EPSG:32734\". The same fact is stated on the run with dcterms:conformsTo and the OGC register's IRI, which is the identifier a reader outside this vocabulary can resolve. From 2026-10-13 a workflow may declare only ONE of these: nine widgets project to metres and each carries its own zone, and two plausible zones differ by 0.58% on the same four points. ABSENCE IS A FACT: an operation that computed in longitude and latitude and projected nothing -- fw:PolygonClipping and fw:PolygonPointSummary both do -- must NOT assert this property, and states its frame with dcterms:conformsTo alone. Until 2026-10-13 those two asserted fw:metricCRS \"OGC:CRS84\", so a reader asking what a run measured in was answered \"degrees\", which measures no distance. Only a UTM zone satisfies this property; tests/metric-crs.test.mjs refuses anything else.";
  fw:implementationStatus "implemented".
fw:DonutGeomasking a owl:Class;
  rdfs:label "Donut geomasking"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation; rdfs:comment "Reproducible educational point displacement within a metre-valued annulus; not a privacy guarantee.".
fw:HexAggregation a owl:Class;
  rdfs:label "H3 cell aggregation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation; rdfs:comment "Aggregation of located points into H3 cells, with sparse cells omitted.".
fw:MovedPointDataset a owl:Class;
  rdfs:comment "A collection of displaced points from one geomasking execution. Displacement is seeded and predictable, and is not proven anonymity.";
  rdfs:label "Displaced point dataset"; rdfs:subClassOf geo:FeatureCollection, prov:Entity.
fw:MovedPoint a owl:Class;
  rdfs:comment "A derived point displaced from a source location by a geomasking operation. Derived geometry only; it does not carry the original coordinate.";
  rdfs:label "Displaced point"; rdfs:subClassOf geo:Feature.
fw:HexCellDataset a owl:Class;
  rdfs:comment "A collection of H3 cells with their counts. Cell occupancy is not an anonymity guarantee.";
  rdfs:label "H3 cell dataset"; rdfs:subClassOf geo:FeatureCollection, prov:Entity.
fw:HexCell a owl:Class;
  rdfs:comment "One indexed hexagonal cell at a stated H3 resolution. A cell is an index unit, not a nearest-site catchment.";
  rdfs:label "H3 cell"; rdfs:subClassOf geo:Feature.
fw:MeanCenterComputation a owl:Class;
  rdfs:label "Mean centre computation"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation; rdfs:comment "Arithmetic mean of projected point coordinates, returned as a CRS84 point. Unweighted unless a record attribute is named, in which case each point is weighted by it and the receipt asserts the field and the weight total.".
fw:MeanCenterResult a owl:Class;
  rdfs:comment "One arithmetic centre of a point set, computed in a projected CRS and returned in CRS84. Weighted by a named record attribute when one is given, unweighted otherwise. Not a privacy metric.";
  rdfs:label "Mean centre result"; rdfs:subClassOf prov:Entity.
fw:PointSetComparison a owl:Class;
  rdfs:label "Point-set comparison"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation; rdfs:comment "Compare unweighted projected mean centers and their distances with a contextual reference-point layer.".
fw:PointComparisonResult a owl:Class;
  rdfs:comment "The computed comparison of two point sets, their projected mean centres and their distances to reference sites. A private evaluation result, not a geomasking operation.";
  rdfs:label "Point-set comparison result"; rdfs:subClassOf prov:Entity.
fw:referenceCount a owl:DatatypeProperty.
fw:centerShift a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:originalNearestPumpDistance a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:movedNearestPumpDistance a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
# How far the individual points moved, measured by pairing the two layers in order. Recorded on
# the comparison rather than on the moved layer: a displacement published beside a moved point
# would let anyone holding the shareable file walk the mask backwards.
fw:displacementMinimum a owl:ObjectProperty; rdfs:range qudt:QuantityValue;
  rdfs:comment "Smallest distance any point moved, in the stated computation CRS.".
fw:displacementMedian a owl:ObjectProperty; rdfs:range qudt:QuantityValue;
  rdfs:comment "Median distance moved. Reported with the extremes because a band is not a distribution.".
fw:displacementMaximum a owl:ObjectProperty; rdfs:range qudt:QuantityValue;
  rdfs:comment "Largest distance any point moved. With the minimum it is the observed band a donut view draws, which is measured and not read from the masking widget's parameters.".
fw:originalMeanCenter a owl:ObjectProperty; rdfs:range geo:Geometry.
fw:movedMeanCenter a owl:ObjectProperty; rdfs:range geo:Geometry.
fw:originalNearestPumpId a owl:DatatypeProperty.
fw:movedNearestPumpId a owl:DatatypeProperty.
fw:innerRadius a owl:ObjectProperty.
fw:outerRadius a owl:ObjectProperty.
fw:randomSeed a owl:DatatypeProperty.
fw:h3Resolution a owl:DatatypeProperty.
fw:minimumOccupancy a owl:DatatypeProperty.
fw:inputCount a owl:DatatypeProperty.
# Asserted together, and only when a weight field was named. The count is of points; the total is
# of whatever the points carry. On the 1854 cholera data a death-weighted centre averages 250
# addresses holding 489 deaths, so either number alone misdescribes what was summarised.
fw:weightField a owl:DatatypeProperty;
  rdfs:comment "The record attribute a computation weighted by, named as the practitioner's data spells it.".
fw:weightTotal a owl:DatatypeProperty;
  rdfs:comment "The sum of the weights actually used. Not a record count: records weighted zero are included in the count and contribute nothing to the total.".
fw:outputCount a owl:DatatypeProperty.
fw:NetworkInput a owl:Class; fw:implementationStatus "implemented"; rdfs:subClassOf prov:Activity;
  rdfs:label "Read prepared street network";
  rdfs:comment "Validate and expose a previously prepared directed network for a run. Acquisition or file normalization happens in the input editor; this execution does not imply a new OSM request.".
fw:PolygonClipping a owl:Class;
  rdfs:comment "An execution that intersects polygons with a boundary. The clipping boundary is operation-specific and may differ from the study area.";
  rdfs:label "Polygon clipping"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation.
fw:PolygonPointSummary a owl:Class;
  rdfs:label "Polygon point summary"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Count point memberships and optionally sum a named numeric attribute; overlaps and missing values are explicit.".
fw:AreaBuffer a owl:Class;
  rdfs:label "Area buffer"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Expand an existing area by a stated distance, producing a second area and leaving the first unchanged. Restated 2026-10-17: this class was labelled an ACQUISITION buffer and described as generating an expanded acquisition boundary, which named one use and declared it the meaning. The practitioner settled that the study area is itself what bounds acquisition, and gave the use the narrow reading had hidden: an administrative boundary is not an epidemiological one, so an outbreak crossing a border -- Ebola from the DRC into Uganda -- is reasoned about by expanding the jurisdiction the surveillance is organised around. That is analysis, not acquisition. WHERE THE EDGE DECIDES MEMBERSHIP the approximation matters: see fw:PointBuffer, which records the fraction of the true circle its polygon covers, and note that this operation does not yet record its own.".
fw:bufferDistance a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:AreaCombination a owl:Class;
  rdfs:label "Area combination"; fw:implementationStatus "implemented"; rdfs:subClassOf fw:SpatialOperation;
  rdfs:comment "Two study areas carried through as the parts of one area. A touching border is NOT dissolved: a published outline is an authority's record of where a boundary lies, two authorities describe a shared border differently, and welding them would assert a third line that neither drew while still citing both. Every question this application asks of a study area -- is this point inside, what does an extract clip to, what are the bounds -- is answered identically by the parts. Added 2026-10-22 on the practitioner's reading that a study area is a polygon and two of them combined are still a study area.".
fw:ringCount a owl:DatatypeProperty;
  rdfs:comment "How many rings the combined geometry carries, which is how a reader sees that the parts were kept rather than merged.".
fw:parameters a owl:DatatypeProperty.
# Retired 2026-10-13: a second name for fw:metricCRS. Three widgets wrote this one and five wrote
# the other, so a query for the projection a run used got half an answer depending on which term it
# asked for -- the D2 duplicate, in the vocabulary rather than in the code.
fw:computationCRS a owl:DatatypeProperty;
  rdfs:label "Projected CRS a computation used (retired)";
  owl:deprecated true;
  dcterms:isReplacedBy fw:metricCRS;
  skos:changeNote "Retired 2026-10-13 as a duplicate of fw:metricCRS. The three widgets that wrote it now write fw:metricCRS; receipts made before that date carry this term.";
  fw:implementationStatus "retired".
fw:caveats a owl:DatatypeProperty.
fw:member a owl:ObjectProperty;
  owl:equivalentProperty rdfs:member;
  rdfs:comment "Membership of a collection, which rdfs:member already names. Aligned rather than renamed.".
fw:siteId a owl:DatatypeProperty.
fw:numericTotal a owl:DatatypeProperty.
fw:missingValueCount a owl:DatatypeProperty.
fw:summary a owl:DatatypeProperty.
fw:networkSnaps a owl:DatatypeProperty.
fw:unconnectedSiteCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Sites that got no result, because reaching the network spends the whole budget";
  rdfs:comment "Asserted by any operation that routes from sites over a street network. No domain: the isochrone and the reachability step both report it, and both are fw:SpatialOperation. Its presence means every count, area and summary from that activity is over the sites that reached something, not over the sites that were offered. Absence means none were in that position, which is a fact, not a silence. Distinct from fw:offNetworkSiteCount: those sites DID get a result.".
fw:unconnectedSites a owl:DatatypeProperty;
  rdfs:label "The sites with no result, with the walk and the budget that defeated it";
  rdfs:comment "A JSON array of site identifier, name, straight-line metres to the nearest junction and the travel budget in metres. Carried as a literal for the same reason fw:networkSnaps is: the receipt records what the run held.".
fw:offNetworkSiteCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Sites whose route began across ground no street covers";
  rdfs:comment "Sites further from the network than the snap limit allows, routed anyway with the first leg charged as a straight line at the street speed. Their results exist and are optimistic in a stated direction: a straight line assumes a walk nobody has checked, and the walked path in such places is routinely longer. The count is a reading of where the street data stops, not of where people are.".
fw:offNetworkSites a owl:DatatypeProperty;
  rdfs:label "The off-network sites, with the straight-line leg and the limit it passed";
  rdfs:comment "A JSON array of site identifier, name, straight-line metres charged and the snap limit that marked it.".
fw:offNetworkMetres a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:label "Straight-line metres charged to reach the network, on one result";
  rdfs:comment "Present on a catchment whose site lay beyond the snap limit, absent on one whose whole route ran on mapped streets. Absence is the claim that no leg was assumed, which is why it is omitted rather than written as zero.".
fw:sourceDescription a owl:DatatypeProperty.
fw:networkMetadata a owl:DatatypeProperty.
fw:networkNodeCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:networkEdgeCount a owl:DatatypeProperty; rdfs:range xsd:integer.

fw:TravelTimeEstimate a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Travel time estimated from a distance";
  rdfs:comment "One derivation of walking minutes from a straight-line distance at a stated speed. A PROXY and not a routed travel time: no street network, no barriers, no terrain, no waiting. Declared as its own activity rather than folded into a distance measurement, because minutes is a model and not a unit of distance -- putting it behind a unit selector would present an assumption as a unit. The assumed speed is recorded on every run.";
  fw:implementationStatus "implemented".
#
# Ports. Declared 2026-10-12, because this file had no port vocabulary at all: no fw:Port, no port
# type, nothing. The concepts were living in prose, in TypeScript types and in release JSON.
#
# **"Carrier" is deliberately absent, and was withdrawn the same day it was added.** It was asked
# for, defined as "a prov:Entity that travels between ports", and then withdrawn on the
# practitioner's challenge to show a standard that defines such a class. There is none. PROV-O,
# DCAT, DCMI Terms, GeoSPARQL, OGC Simple Features and ISO 19107 between them name no carrier, and
# the definition that was reached is derivable rather than new: an Entity prov:wasGeneratedBy one
# node's activity and prov:used by another's is already exactly that, and the graph already says it.
# Nothing consumed the class. fw:CarrierKind went with it -- a kind of a term that does not exist is
# a kind of nothing.
#
# What the word was doing was standing in for three things, and only the middle one earns a term:
#
#   the instance  -- already prov:Entity, asserted uniformly for every node output at
#                    src/evidence.ts:78. No local class needed.
#   fw:PortType   -- the declared name a connection is checked against. Thirteen of them, and two
#                    ports connect when these are equal. No standard names this, so it stays.
#   the structure -- whether a value is features with geometry, a keyed table, a raster or a graph.
#                    Each port type's instances already assert this where it matters:
#                    geo:FeatureCollection, fw:PointDataset (ontology/runtime.ttl:40), fw:DataTable.
#                    A second parallel taxonomy over the top of those added nothing.
#
# The audit of whether the class should exist, with the five figures that were wrong while it did,
# is in docs/audits/ontology-audit.md.

fw:Port a owl:Class;
  rdfs:label "Named connection point on a widget";
  rdfs:comment "One input or output of a widget, identified by a name within that widget. D7 asks that the name say what the port carries rather than what it is used for.";
  fw:implementationStatus "proposed".

fw:PortType a owl:Class;
  rdfs:label "Declared type of what a port carries";
  rdfs:comment "The name a port declares for what travels through it, and the thing a connection is checked against: two ports connect when their port types are equal. Thirteen are in the live set. A port type named after the widget that emits it rather than after what it carries is a custom stud under D4a -- gradedFacilities was one, retired on 2026-10-12.";
  fw:implementationStatus "proposed".

fw:portType a owl:ObjectProperty;
  rdfs:domain fw:Port; rdfs:range fw:PortType;
  rdfs:label "Port type a port declares";
  fw:implementationStatus "proposed".


# Two port types no live widget declares. They were the port types of widgets retired on 2026-10-12 --
# gradedFacilities emitted by xpert and consumed by access and facility_audit, and access emitted by
# access and consumed by access_policy -- and they survive in those widgets' own definitions, which
# a retired widget keeps so that a saved workflow can still be read. Declared here so the mapping
# from a port type to its term is total, and so the ontology records which port types were retired,
# which it had no way to say before.
#
# Retirement is stated twice on purpose, from 2026-10-13. `fw:implementationStatus` is what the
# application reads -- src/palette.ts derives the retired set from it -- and `owl:deprecated` is
# what every other tool reads, because OWL 2 already has a deprecation flag and a project does not
# need its own. The replacement is `dcterms:isReplacedBy`, which DCMI defines for exactly this, and
# the explanation is `skos:changeNote`. The practitioner's standing direction: where a standard
# exists, use it rather than invent a term, and establish the equivalence where both must coexist.
#
# `skos:hiddenLabel` is the term for an ARCHIVED NAME -- a label that must stay findable by search
# and must not be displayed. That is what an old identifier is after a rename, and it is why
# `samples` is recorded below against the port type it was never on, and in widgets/registry.json
# as `previousNodeTypes` for the widget identifiers, which are not yet ontology terms.
fw:GradedFacilitiesPort a fw:PortType; rdfs:label "gradedFacilities";
  rdfs:comment "Retired 2026-10-12. A producer-named port type -- D4a's custom stud -- replaced by a general point layer carrying the grading in each feature's attributes.";
  owl:deprecated true;
  dcterms:isReplacedBy fw:PointsPort;
  skos:changeNote "Retired 2026-10-12 as a producer-named port type under D4a. The grading now travels in each feature's attributes on a general point layer.";
  fw:implementationStatus "retired".
fw:AccessPort a fw:PortType; rdfs:label "access";
  rdfs:comment "Retired 2026-10-12 with the access widget, which was decomposed into a candidate filter on nearest, the shared nearest-neighbour search, and the travel_time primitive. Its rows travel as `distances` now.";
  owl:deprecated true;
  dcterms:isReplacedBy fw:DistancesPort;
  skos:changeNote "Retired 2026-10-12 with the access widget. Its rows travel as `distances`, emitted by the general nearest-neighbour search.";
  fw:implementationStatus "retired".
fw:PointsPort a fw:PortType; rdfs:label "points".
fw:AreaPort a fw:PortType; rdfs:label "area".
fw:PolygonsPort a fw:PortType; rdfs:label "polygons".
fw:DistancesPort a fw:PortType; rdfs:label "distances";
  rdfs:comment "Each subject with the nearest candidate, the distance in a declared unit, and optionally proxy minutes added by travel_time.".
fw:DecisionsPort a fw:PortType; rdfs:label "decisions".
fw:FacilitiesPort a fw:PortType; rdfs:label "facilities".
fw:CoverageCheckPort a fw:PortType; rdfs:label "coverage-check".
fw:MeanCenterPort a fw:PortType; rdfs:label "mean-center";
  rdfs:comment "The mean of point coordinates, which is NOT a polygon centroid. GeoSPARQL exposes centroid as a function and there is no class to be disjoint with, so the distinction is stated here.".
fw:PointComparisonPort a fw:PortType; rdfs:label "point-comparison".
fw:TablePort a fw:PortType; rdfs:label "table".
fw:RasterPort a fw:PortType; rdfs:label "raster".
fw:NetworkPort a fw:PortType; rdfs:label "network".
fw:AlertPort a fw:PortType; rdfs:label "alert".

fw:Ruleset a owl:Class;
  rdfs:subClassOf prov:Plan;
  rdfs:label "Declared ruleset";
  rdfs:comment "A versioned set of rules applied to facts projected from an input, together with its parameters, input contract, output vocabulary and the basis it rests on. It is a plan and not a computation: the widget projects, binds and extracts, and the engine derives. It is also not the published standard it may implement -- applying a hierarchy is not the hierarchy.";
  fw:implementationStatus "implemented".
fw:basisStatus a owl:ObjectProperty;
  rdfs:domain fw:Ruleset;
  rdfs:label "Status of the basis a ruleset rests on";
  rdfs:comment "One of published, practitioner-agreed, illustrative or proxy. Recorded so a reader can tell a ruleset with a source from one with a disclaimer; of the three rulesets shipped on 2026-10-12, one claims a published basis and none carries resolvable evidence for it.";
  fw:implementationStatus "implemented".
fw:unresolvedCitation a owl:DatatypeProperty;
  rdfs:domain fw:Ruleset;
  rdfs:label "Citation a reader cannot resolve";
  rdfs:comment "A bibliography entry held only as text, with no URL and no digested file. Emitted as unresolved rather than as an fw:EvidenceReference, because an entry nobody can open is not evidence and presenting it as one would overstate the basis in the place a reader goes to check it.";
  fw:implementationStatus "implemented".
fw:EvidenceReference a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "Evidence reference supplied by the workflow author";
  rdfs:comment "A citation documenting a node plan. Linked by dcterms:references; attaching it does not establish independent verification or make PDF contents a reasoning premise.";
  fw:implementationStatus "implemented".
fw:workflowNode a owl:ObjectProperty;
  rdfs:domain prov:Activity; rdfs:range prov:Plan;
  rdfs:comment "The run-specific snapshot of the visual node executed by this activity.".
fw:referenceRole a owl:ObjectProperty;
  rdfs:comment "The author's stated purpose for citing a source.".
fw:DataSourceReference a prov:Role; rdfs:label "Data source reference".
fw:MethodReference a prov:Role; rdfs:label "Method reference".
fw:AssumptionReference a prov:Role; rdfs:label "Assumption or parameter reference".
fw:ContextReference a prov:Role; rdfs:label "Background context reference".
fw:locator a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "A page, table, section or other locator supplied by the author.".
fw:sha256 a owl:DatatypeProperty; rdfs:range xsd:string.
fw:byteSize a owl:DatatypeProperty; rdfs:range xsd:integer;
  owl:equivalentProperty dcat:byteSize;
  rdfs:comment "The same property DCAT names dcat:byteSize. Aligned rather than renamed on 2026-10-12: an equivalence axiom costs no migration and no saved workflow, and a reader or a reasoner can substitute one for the other. Worth recording how this was found -- the dcat: prefix was already declared in this file and already used for dcat:Dataset, so a standard that had been imported was sitting beside a local term minted for the same thing.".
fw:filename a owl:DatatypeProperty; rdfs:range xsd:string.

fw:ontology a owl:Ontology;
  rdfs:label "Fieldwork study-area and spatial-operation vocabulary";
  owl:versionInfo "0.6 experimental, 2026-10-08";
  rdfs:comment "A bounded vocabulary for study areas and their reusable roles. A class declaration is not an implementation or validation constraint.".

fw:implementationStatus a owl:AnnotationProperty;
  rdfs:comment "Prototype implementation status attached to a class, not a capability inferred for an arbitrary activity.".
fw:StudyArea a owl:Class;
  rdfs:subClassOf geo:Feature;
  rdfs:label "Study area";
  rdfs:comment "A geographic feature used to scope one or more analyses. Its geometry is linked with geo:hasGeometry; it is not itself a clipping operation. The current widget draws one polygon. Proposed membership supports multiple named, disconnected features without requiring a dissolved aggregate geometry.";
  fw:implementationStatus "implemented".
fw:SpatialOperation a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Spatial operation execution";
  rdfs:comment "An execution that uses a spatial scope and optional datasets to produce derived entities. Workflow node configuration is distinct from its execution.".
fw:studyArea a owl:ObjectProperty;
  rdfs:subPropertyOf prov:used;
  rdfs:domain fw:SpatialOperation;
  rdfs:range fw:StudyArea;
  rdfs:label "uses study area".
fw:inputGeometry a owl:ObjectProperty;
  rdfs:subPropertyOf prov:used;
  rdfs:domain fw:SpatialOperation;
  rdfs:range geo:Geometry;
  rdfs:label "uses geometry representation".
fw:inputDataset a owl:ObjectProperty;
  rdfs:subPropertyOf prov:used;
  rdfs:domain fw:SpatialOperation;
  rdfs:range dcat:Dataset;
  rdfs:label "uses dataset".
fw:method a owl:DatatypeProperty;
  rdfs:domain prov:Activity;
  rdfs:range xsd:string;
  rdfs:label "calculation method description".

fw:AreaComputation a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Area calculation";
  rdfs:comment "Enriches the same study area with a polygon-area measurement, preserving feature and geometry identity. The workflow output remains a study area; the generated measurement records canonical square metres and provenance, with an independently chosen display unit.";
  fw:implementationStatus "implemented".
fw:AreaMeasurement a owl:Class;
  rdfs:comment "A measured quantity attached to one geometry, with its unit. The measurement describes the geometry it was computed from, not a later edited geometry.";
  rdfs:subClassOf prov:Entity, qudt:QuantityValue;
  rdfs:label "Computed area measurement".
fw:MapView a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Spatial map view";
  rdfs:comment "Displays boundaries, points, raster grids or catchment polygons as configured. Polygon plot and interactive map share upstream results and can include context points. Direct spatial mode computes display relations; reviewed and polygon modes reuse supplied results.";
  fw:implementationStatus "implemented".
fw:NearbyFacilitySelection a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Select nearby facilities";
  rdfs:comment "Select connected facility points at or within a spherical distance from the center of the study boundary bounding box. Requires text owner and serviceType attributes. Missing-coordinate records are counted and omitted from the candidate set without changing the input. This is not polygon containment, travel time or a service-availability inference.";
  fw:implementationStatus "implemented".
fw:searchRadiusKm a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:inputRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:missingLocationCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:selectedRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:GridSampleGeneration a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Generate demonstration grid points";
  rdfs:comment "Generates a bounded regular grid using local geographic spacing and polygon containment. Output is a GeoSPARQL feature collection, not observed households, population, or cases.";
  fw:implementationStatus "implemented".
fw:spacingMetres a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:generatedRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:Reprojection a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Coordinate transformation";
  rdfs:comment "Proposed operation transforming a geometry between known CRS definitions, recording the coordinate operation and generating a new geometry representation. Changing a CRS label is not a transformation.";
  fw:implementationStatus "proposed".
fw:measuredGeometry a owl:ObjectProperty;
  rdfs:domain fw:AreaMeasurement;
  rdfs:range geo:Geometry;
  rdfs:label "geometry measured by this result".

fw:ZonalStatistics a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Raster zonal statistics";
  rdfs:comment "Summarizes raster values within a zone. Requires explicit pixel inclusion, nodata, weighting, statistic, and coverage policies.";
  fw:implementationStatus "proposed".
fw:RasterClipping a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Raster polygon clipping";
  rdfs:comment "Implemented for bounded single-band WGS84 native GeoTIFF windows: cell-center or all-touched masking, optional native-pixel margin, independent cutline and tight crop. No resampling or global raster engine.";
  fw:implementationStatus "implemented".
fw:RemoteAssetRequest a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Remote asset request";
  rdfs:comment "Resolves a download location for a remote dataset and checks that a named credential is available. It yields a request, never bytes: this prototype cannot fetch a service that sends no cross-origin header, so the practitioner's own browser performs the download. It is therefore discovery and not acquisition, produces no fw:DownloadedAsset, records no digest, and cannot establish that a file later imported is the file it described. The licence of the requested dataset is carried as a dcterms:license IRI on a dcat:Dataset, because an obligation that travels only as prose does not travel. The credential is named by reference; the secret is never part of a request, a receipt or a run.";
  fw:implementationStatus "implemented".
fw:PointBuffer a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Point buffer";
  rdfs:comment "Defines a study area as everything within a stated distance of one named point. The result is a scope like any other and is typed fw:StudyArea, but it is a derived construct rather than a surveyed boundary: its edge is a decision and its radius an assumption of the question, so the source point and the distance are recorded. One point only; several distant points are never combined, because a bounding box spanning them makes a raster window too coarse to sample. The polygon approximates the circle, and the fraction of the true circle area it covers is recorded rather than implied.";
  fw:implementationStatus "implemented".
fw:RasterPointSample a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Raster point sample";
  rdfs:comment "Writes the value of the raster cell containing each point onto that point, under PixelIsArea at the raster's own resolution. A sampled value is the value of a cell, not a measurement at the point, and no interpolation is performed or claimed. Sampling creates no data missing from the source. No-data cells, points falling outside the raster and points without coordinates carry no value and are counted separately: a point outside is a question about coverage, a no-data cell is a statement by the source, and neither is zero.";
  fw:implementationStatus "implemented".
fw:CoverageSubsetting a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Multidimensional coverage subsetting";
  rdfs:comment "Selects coverage coordinates, variables and dimensions; for example a NetCDF spatial/time/depth subset. Polygon masking is an additional explicit operation when needed.";
  fw:implementationStatus "proposed".
fw:FeatureExtraction a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Spatial feature extraction";
  rdfs:comment "Selects features by a stated spatial relation, or creates clipped feature geometries under an explicit clipping mode. Intersects and within are distinct policies.";
  fw:implementationStatus "proposed".
fw:SpatialAggregation a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Spatial aggregation";
  rdfs:comment "Aggregates records into spatial reporting units using a stated measure, denominator, spatial predicate, and overlap/missing-data policy.";
  fw:implementationStatus "proposed".

# Candidate resource-planning vocabulary. No loader or budget enforcement yet.
fw:AssetSubsetPlan a owl:Class;
  rdfs:subClassOf prov:Plan;
  rdfs:label "Asset subset plan";
  rdfs:comment "A plan to acquire and decode a bounded portion of an asset before analysis. Requested area, retrieval geometry and precise mask may differ.";
  fw:implementationStatus "proposed".
fw:ResourceBudget a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "Browser resource budget";
  rdfs:comment "Explicit limits for a run, rather than assumptions about available browser resources.";
  fw:implementationStatus "proposed".
fw:ResourceEstimate a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "Estimated asset costs";
  rdfs:comment "Estimated transfer and decoded-memory costs with a documented method and uncertainty. Unknown cost is not zero.";
  fw:implementationStatus "proposed".
fw:requestedArea a owl:ObjectProperty;
  rdfs:domain fw:AssetSubsetPlan; rdfs:range fw:StudyArea.
fw:retrievalGeometry a owl:ObjectProperty;
  rdfs:domain fw:AssetSubsetPlan; rdfs:range geo:Geometry;
  rdfs:comment "Coarse retrieval scope, such as tile extent or bounding box, which may include pixels outside the requested polygon.".
fw:maskGeometry a owl:ObjectProperty;
  rdfs:domain fw:AssetSubsetPlan; rdfs:range geo:Geometry;
  rdfs:comment "Precise polygon used to mask or select analysis content after retrieval.".
fw:resourceBudget a owl:ObjectProperty; rdfs:range fw:ResourceBudget.
fw:resourceEstimate a owl:ObjectProperty;
  rdfs:domain fw:AssetSubsetPlan; rdfs:range fw:ResourceEstimate.
fw:maximumTransferBytes a owl:DatatypeProperty;
  rdfs:domain fw:ResourceBudget; rdfs:range xsd:nonNegativeInteger.
fw:maximumDecodedBytes a owl:DatatypeProperty;
  rdfs:domain fw:ResourceBudget; rdfs:range xsd:nonNegativeInteger.
fw:maximumCells a owl:DatatypeProperty;
  rdfs:domain fw:ResourceBudget; rdfs:range xsd:nonNegativeInteger.
fw:estimatedTransferBytes a owl:DatatypeProperty;
  rdfs:domain fw:ResourceEstimate; rdfs:range xsd:nonNegativeInteger.
fw:estimatedDecodedBytes a owl:DatatypeProperty;
  rdfs:domain fw:ResourceEstimate; rdfs:range xsd:nonNegativeInteger.

fw:StreamingSpatialSubset a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Streaming spatial subset ingestion";
  rdfs:comment "A proposed ingest operation that incrementally selects or clips incoming content before registering the completed derivative. It does not imply reduced network transfer.";
  fw:implementationStatus "proposed".
fw:DerivedSpatialDataset a owl:Class;
  rdfs:subClassOf dcat:Dataset, prov:Entity;
  rdfs:label "Derived spatial dataset";
  rdfs:comment "A derived dataset linked to upstream assets with prov:wasDerivedFrom and its operation with prov:wasGeneratedBy. Registration as usable requires a separate completion check.";
  fw:implementationStatus "proposed".
fw:ResourceObservation a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "Observed resource costs";
  rdfs:comment "Measured costs of an ingest or computation, with definitions of counters and their availability; distinct from estimates.";
  fw:implementationStatus "proposed".
fw:receivedBodyBytes a owl:DatatypeProperty;
  rdfs:domain fw:ResourceObservation; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "Bytes delivered to the application's response-body reader, not necessarily compressed network transfer bytes.".
fw:retainedBytes a owl:DatatypeProperty;
  rdfs:domain fw:ResourceObservation; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "Bytes retained in the resulting persisted asset.".

fw:SpatialCoverageCheck a owl:Class;
  rdfs:subClassOf fw:SpatialOperation;
  rdfs:label "Spatial coverage check";
  rdfs:comment "Checks point records against a study area. Outside and missing-location records require review. This is not a statistical outlier detector or evidence that a record is incorrect.";
  fw:implementationStatus "implemented".
fw:checkedRecord a owl:ObjectProperty;
  rdfs:domain fw:SpatialCoverageCheck; rdfs:range geo:Feature.
fw:spatialRelation a owl:ObjectProperty; rdfs:range fw:SpatialRelationValue;
  rdfs:comment "Application classification of a record against a boundary. Geometric relations also use GeoSPARQL predicates when coordinates exist.".
fw:coverageDecision a owl:ObjectProperty; rdfs:range fw:CoverageDecisionValue;
  rdfs:comment "Application policy outcome of a coverage check.".

# Value sets declared 2026-10-10. Both properties above named their values in a prose
# comment and nothing declared them, which is the pattern the widget/ontology coupling
# check exists to end: a reasoner meeting fw:Inside found nothing saying what it is.
fw:SpatialRelationValue a owl:Class; rdfs:label "Spatial relation value";
  rdfs:comment "Where a record falls against a boundary. MissingLocation is not a place: it records that the question could not be asked of that record.".
fw:Inside a owl:NamedIndividual, fw:SpatialRelationValue; rdfs:label "Inside the boundary".
fw:Boundary a owl:NamedIndividual, fw:SpatialRelationValue; rdfs:label "On the boundary";
  rdfs:comment "Kept distinct from Inside because whether an edge counts is a decision the check states rather than assumes.".
fw:Outside a owl:NamedIndividual, fw:SpatialRelationValue; rdfs:label "Outside the boundary".
fw:MissingLocation a owl:NamedIndividual, fw:SpatialRelationValue; rdfs:label "No coordinates to place".

fw:CoverageDecisionValue a owl:Class; rdfs:label "Coverage decision value";
  rdfs:comment "What a coverage check concluded about a record. Excluded is a practitioner's direction in the current check, never deletion of the input.".
fw:Accept a owl:NamedIndividual, fw:CoverageDecisionValue; rdfs:label "Accepted into the analysis".
fw:Excluded a owl:NamedIndividual, fw:CoverageDecisionValue; rdfs:label "Excluded from the analysis".

fw:AccessDecisionValue a owl:Class; rdfs:label "Access policy decision value";
  rdfs:comment "What the access rules concluded about a place. Unknown is a result, not a failure: missing evidence stays unknown rather than defaulting to no flag.".
fw:NoFlag a owl:NamedIndividual, fw:AccessDecisionValue; rdfs:label "Not flagged".
fw:Unknown a owl:NamedIndividual, fw:AccessDecisionValue; rdfs:label "Not determinable from the evidence given".
fw:Review a owl:NamedIndividual, fw:CoverageDecisionValue, fw:AccessDecisionValue;
  rdfs:label "Needs a human to look";
  rdfs:comment "One individual in two value sets, deliberately: a coverage check and the access rules both end in the same place, which is a person deciding.".
fw:decision a owl:ObjectProperty; rdfs:range fw:AccessDecisionValue;
  rdfs:label "Decision the rules reached".

# The heat-outreach reasoning vocabulary. These appear in the N3 rules the reasoner runs,
# not only in receipts, so they were the least declared and the most load-bearing terms
# in the application.
fw:distanceKnown a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:label "Whether a distance could be computed for this place";
  rdfs:comment "Asserted separately from the distance so that an absent distance is a stated fact rather than a missing triple.".
fw:distanceKm a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:label "Distance to the nearest centre, in kilometres".
fw:alertKnown a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:label "Whether an alert state was supplied".
fw:heatAlert a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:label "Whether a heat alert is in force".

fw:sourceFile a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Name of the file a table was read from".
fw:sourceDigest a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "SHA-256 of the file as read";
  rdfs:comment "Recorded so a table can be shown to be the one the analysis used, rather than a file with the same name.".
fw:requestOrigin a owl:ObjectProperty;
  rdfs:label "Origin a network request was sent to";
  rdfs:comment "The scheme and host actually contacted, which is what a reader needs to judge whether a retrieval left the device and where to.".
fw:requiresReview a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:excluded a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:comment "User-directed exclusion in the current check, never automatic deletion of the input record.".
fw:exclusionReason a owl:DatatypeProperty; rdfs:range xsd:string.
fw:attribute a owl:ObjectProperty;
  rdfs:comment "Links a feature to an input attribute described by a local field key and rdf:value, or an explicit missing-value flag. User field keys are not assumed to be shared domain concepts.".
fw:fieldKey a owl:DatatypeProperty; rdfs:range xsd:string.
fw:missingValue a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:comment "The record HAS this field and it is null or empty. Somebody wrote the column and left it blank.".
fw:fieldAbsent a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:comment "The record does not have this field at all. Distinct from fw:missingValue because the two are different findings with different remedies, and because a reader of a receipt must not have to assume which one a silence meant. Added 2026-10-21, when a table was showing the words 'Not supplied' for both while the receipt asserted neither.".
fw:absentFieldCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:emptyValueCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.

fw:TableView a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Point table presentation";
  rdfs:comment "Displays source coordinates and attributes, existing coverage decisions or catchment summaries. Does not infer new spatial relationships or exclude records.";
  fw:implementationStatus "implemented".

fw:ChartView a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Categorical chart presentation";
  rdfs:comment "Presents categorical record counts or upstream polygon counts/numeric totals. Cumulative catchments are not disjoint time bands. Polygon presentation reuses upstream summaries.";
  fw:implementationStatus "implemented".
fw:ChartSpecification a owl:Class;
  rdfs:subClassOf prov:Plan;
  rdfs:label "Bounded chart presentation specification";
  rdfs:comment "Configured presentation of an exact upstream result. Mark and orientation affect appearance; field and measure kind disclose the already-computed quantity. The specification is not a statistical computation or an arbitrary Vega-Lite program.";
  fw:implementationStatus "implemented".
fw:layerCount a owl:DatatypeProperty; rdfs:domain fw:MapSpecification; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "How many layers this map draws";
  rdfs:comment "A map draws LAYERS: whatever arrives at one of its input ports, each with its own symbology, over or under the others. The count and the kinds were derivable before this term existed -- prov:used reaches each source and fw:portType says what it emits -- but the join is fragile: a node appears under two IRI forms and the activity uses itself, so a naive query returned four sources for a two-layer map. Asserted here so the question does not require knowing that. See the Map widget page, docs/widget-specs/map_output.md.".
fw:layer a owl:ObjectProperty; rdfs:domain fw:MapSpecification;
  rdfs:label "One layer this map draws";
  rdfs:comment "Carries the port the layer arrived at, the port type it carries, its index in the drawing order, and the activity that generated it. The index is the order the ports are declared, which is the order they are drawn today; when a practitioner can state the order, that order belongs here instead.".
fw:layerIndex a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "Where this layer falls in the drawing order".
fw:layerPort a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "The input port this layer arrived at".
fw:layerKind a owl:ObjectProperty;
  rdfs:label "What kind of thing this layer draws";
  rdfs:comment "fw:BasemapLayer, fw:AreaLayer, fw:PolygonsLayer, fw:PointsLayer, fw:RasterLayer or fw:NetworkLayer. The kind decides HOW a layer is drawn, not whether it may be there. Distinct from a port type on purpose: ports receive or transmit, layers are displayed -- the practitioner's distinction of 2026-10-14. A map with two ports can draw four layers.".
fw:layerFeatureCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:label "How many features this layer draws".
fw:layerRole a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "What this layer is in the map's reading";
  rdfs:comment "observations, sites, context. A READING and not a property of the data: the same pumps are the subject of a map asking where the pumps are and context in a map asking how deaths fell around one. Recorded because the renderer takes its emphasis from these names -- it draws sites red at radius 3.5 and observations gray at 2.7 -- so a reader can see which way round the map was built.".
fw:layerWithin a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "The port whose value carried this layer, when it arrived at no port of its own";
  rdfs:comment "summarize_polygons keeps the points it counted on the value it returns, so 250 death locations reach a map that was never wired to them. Such a layer is displayed and has no port, and saying so is the difference between a count of what is shown and a count of what is connected.".
fw:layerTileProvider a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The tile service a basemap layer is drawn from: osm or topo. A third origin beside fw:layerPort and fw:layerWithin, for a layer that arrives from a configured service rather than from the workflow at all. Its tiles are fetched by the reader's browser and are not in the SVG export, so this records what a reader saw and not what the figure carries.".
fw:BasemapLayer a owl:Class;
  rdfs:label "Third-party map tiles drawn beneath the data";
  rdfs:comment "Layer index 0 when present. Counted as a layer from 2026-10-14: a basemap is displayed, and recording it only as fw:mapBasemap made the layer that carries all the geographic context read as a setting on the specification. Offered on 1 of the 10 maps in the published worked examples, and off by default there, because the control is reachable only from the interactive presentation of the polygons input -- see docs/widget-specs/map_output.md.".
fw:AreaLayer a owl:Class; rdfs:label "A boundary drawn as a layer".
fw:PolygonsLayer a owl:Class; rdfs:label "Polygons drawn as a layer".
fw:PointsLayer a owl:Class; rdfs:label "Points drawn as a layer".
fw:RasterLayer a owl:Class; rdfs:label "A raster drawn as a layer".
fw:NetworkLayer a owl:Class; rdfs:label "A street network drawn as a layer".
# Applying rules the practitioner wrote, rather than a ruleset this build publishes.
#
# A declared ruleset is cited by id, version and basis: the artefact exists and a reader can go
# and read it. An authored one has no artefact, so its receipt carries the rules themselves and
# the bindings that make them mean anything. Experiment 106; built 2026-10-15.
#
# The terms the RULES use are not here and never will be. A practitioner authoring rules mints
# vocabulary -- waitMinutes, Short, LongOrClosed -- and it lives in urn:fieldwork:authored:,
# under the fwa: prefix, so that a word somebody coined this afternoon is never mistaken for one
# this application defines. These terms describe the ACT of applying such rules, which is the
# application's business and so is declared.
fw:RuleApplication a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Applying a ruleset to the records it judges";
  rdfs:comment "Carries the rules when they were authored in the workflow, and cites the artefact when they were published as one.".
fw:ruleSource a owl:DatatypeProperty; rdfs:domain fw:RuleApplication; rdfs:range xsd:string;
  rdfs:comment "authored, for rules written in this workflow. A published ruleset is cited instead, by id and version.".
fw:rulesetTitle a owl:DatatypeProperty; rdfs:domain fw:RuleApplication; rdfs:range xsd:string;
  rdfs:comment "What the practitioner called these rules. A name, not an identifier: authored rules have no identity outside the workflow that holds them.".
fw:mustNotBeReadAs a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What a classification must not be taken for. Required of every published ruleset and of every authored one: applying a hierarchy is not the same as being it, and a classification is not a decision anyone has taken.".
fw:unmatchedSubjectCount a owl:DatatypeProperty; rdfs:domain fw:RuleApplication; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "How many records no rule fired on. A ruleset may decline to classify; reading that silence as a conclusion is what this count exists to prevent.".
# What the records could not tell a rule application, declared because the application asserts
# it. A step that applies rules to a value it cannot read tells the rules the value is not
# recorded, which is the honest thing to do and is invisible in the result: the conclusion for
# such a record is a conclusion about an absence, and reads exactly like a conclusion about a
# number. The two reasons a value could not be read are distinguished, because they call for
# different actions -- one is data nobody collected, the other is data somebody collected that
# this step could not use.
fw:ReadingProblem a owl:Class;
  # A measurement of one metric over one resource, which is exactly what DQV models. Declared as
  # a subclass rather than reinvented: a reader with DQV tooling can read these without knowing
  # this ontology, and the counts below are the measurement's value.
  rdfs:subClassOf dqv:QualityMeasurement;
  rdfs:label "A bound field the records could not supply";
  rdfs:comment "Counted per field and per reason, over the records one rule application judged. Its presence does not make a result unusable; it says which part of the result is a judgement about an absence.".
fw:readingProblem a owl:ObjectProperty; rdfs:domain fw:RuleApplication; rdfs:range fw:ReadingProblem;
  rdfs:comment "A field this application could not read for some of its records. Absent when every bound value was readable.".
fw:ValueProblemKind a owl:Class;
  rdfs:label "Why a bound value could not be read";
  rdfs:comment "A closed pair. Both produce the same fact for the reasoner -- that the value is not recorded -- and they are not the same finding for a reader.".
fw:ValueAbsent a fw:ValueProblemKind;
  rdfs:label "No value was recorded";
  rdfs:comment "The record carries nothing for this attribute. Nobody collected it, or it was collected and lost before this workflow saw it.".
fw:ValueUnreadable a fw:ValueProblemKind;
  rdfs:label "A value was recorded that is not the declared kind";
  rdfs:comment "The record carries something this step could not read as the kind its binding declares -- a count written as text, most often. Somebody collected this value and the rules did not see it.".
fw:affectedRecordCount a owl:DatatypeProperty; rdfs:domain fw:ReadingProblem; rdfs:range xsd:nonNegativeInteger;
  rdfs:subPropertyOf dqv:value;
  rdfs:comment "How many of the judged records were affected. The measurement's value, in DQV's terms.".

# The two metrics these measurements are of, and the dimensions they sit in. DQV deliberately
# does not say what quality means -- it is a frame -- so the dimensions are named here.
#
# They are NOT the same dimension, which is the distinction a practitioner asked for on
# 2026-10-16 and which missingno does not draw: it knows null from not-null and nothing else. A
# count written "3" is present and unusable, which is a conformance failure rather than an
# absence, and the two call for different actions.
fw:completeness a dqv:Dimension;
  rdfs:label "Whether a value was recorded at all".
fw:readability a dqv:Dimension;
  rdfs:label "Whether a recorded value can be read as the kind it was declared to be".
fw:absentValues a dqv:Metric; dqv:inDimension fw:completeness;
  dqv:expectedDataType xsd:nonNegativeInteger;
  rdfs:comment "Records carrying no value for a bound field.".
fw:unreadableValues a dqv:Metric; dqv:inDimension fw:readability;
  dqv:expectedDataType xsd:nonNegativeInteger;
  rdfs:comment "Records carrying a value that is not the declared kind. Present and unusable, which is not the same as absent.".
fw:consideredRecordCount a owl:DatatypeProperty; rdfs:domain fw:ReadingProblem; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "How many records were judged in all, so the count above can be read as a proportion rather than as a number on its own.".
fw:problemKind a owl:ObjectProperty; rdfs:domain fw:ReadingProblem; rdfs:range fw:ValueProblemKind;
  rdfs:comment "Which of the two reasons applies. Recorded rather than inferred: the step knows which it found, and a reader cannot tell them apart from the result.".
# A column read as a different kind than the file held it, because a practitioner asked for it.
# Experiment 117. Declared because the records a workflow emits after a repair are not the
# records the file held, and a reader has to be able to learn that from the run rather than from
# having been present when somebody pressed the button. The repair is never automatic: this
# application refuses to convert silently, and a cast from "3" to 3 is the same class of act as
# a unit conversion.
fw:ColumnRepair a owl:Class;
  # DQV has no term for repair -- researched 2026-10-17 against the vocabulary itself, and the
  # nearest thing it offers is feedback ABOUT quality. PROV-O has the shape, so this specialises
  # prov:Revision: the records handed on are a revision of the records held, and this says what
  # the revision was.
  rdfs:subClassOf prov:Revision;
  rdfs:label "A column read as a kind other than the one the file held";
  rdfs:comment "States what was cast, how much of it, and what could not be cast and was left alone. The source file is never written to; this describes what the workflow does to the records on their way through it.".
fw:columnRepair a owl:ObjectProperty; rdfs:range fw:ColumnRepair;
  rdfs:comment "A repair this input carries. Absent when the records are exactly as the file held them.".
fw:repairedAs a owl:DatatypeProperty; rdfs:domain fw:ColumnRepair; rdfs:range xsd:string;
  rdfs:comment "The kind the values were read as: number, boolean or term.".
fw:repairedRecordCount a owl:DatatypeProperty; rdfs:domain fw:ColumnRepair; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "How many values were cast.".
fw:unrepairedRecordCount a owl:DatatypeProperty; rdfs:domain fw:ColumnRepair; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "How many could not be read and were left exactly as they were. These records stay unrecorded to the rules, which is the honest outcome and not a failure of the repair.".
fw:unrepairedExample a owl:DatatypeProperty; rdfs:domain fw:ColumnRepair; rdfs:range xsd:string;
  rdfs:comment "Up to three of the values that could not be read, as they appear, so a reader recognises them without opening the file.".
fw:repairedAt a owl:DatatypeProperty; rdfs:domain fw:ColumnRepair; rdfs:range xsd:string;
  rdfs:comment "When the practitioner asked for it.".
# Cartographic design rules, applied while a visualisation is assembled and stated in its
# receipt. The practitioner's decision, 2026-10-17: "We can embed the map or visualization design
# rules in widgets and apply them during visualization assembly ... Then the N3 receipts can
# include which rules were applied."
#
# WCAG needs no translating: its success criteria already carry stable IRIs, which is what
# earl:test points at for a measured rule. A rule that is this project's own judgement rather
# than a published criterion points at itself, and the difference is visible to a reader.
fw:DesignRule a owl:Class;
  rdfs:label "A rule a visualisation is held to";
  rdfs:comment "Carried in the receipt rather than cited, for the same reason an authored ruleset carries its rules: there is no published artefact to point at. A reader who can see an outcome and not the rule has been told a verdict.".
fw:DesignRuleApplication a owl:Class;
  rdfs:subClassOf earl:Assertion;
  rdfs:label "One design rule, applied to one thing, with its outcome";
  rdfs:comment "Emitted for every rule including the inapplicable ones. A reader seeing four rules in one receipt and two in another cannot otherwise tell whether the missing two passed, were skipped, or do not exist.".
fw:designRule a owl:ObjectProperty; rdfs:domain fw:DesignRuleApplication; rdfs:range fw:DesignRule;
  rdfs:comment "Which rule was applied.".
fw:designRuleApplication a owl:ObjectProperty; rdfs:range fw:DesignRuleApplication;
  rdfs:comment "A rule application carried by a map specification.".
fw:ruleKind a owl:DatatypeProperty; rdfs:domain fw:DesignRule; rdfs:range xsd:string;
  rdfs:comment "measured or categorical. It decides what the outcome is worth: a measured rule computes a number a reader can re-derive, a categorical one reports a judgement that was coded in. Stated because every toast tone in this application failed a contrast threshold on 2026-10-17 and no categorical rule would have found it -- arithmetic did.".
fw:conformanceThreshold a owl:DatatypeProperty; rdfs:domain earl:TestResult;
  rdfs:comment "The value the measurement was held to. EARL records that something failed a criterion and does not carry the criterion's threshold, by its own statement of scope, so this supplies it.".
fw:conformanceLevel a owl:DatatypeProperty; rdfs:domain fw:DesignRule; rdfs:range xsd:string;
  rdfs:comment "The criterion's own conformance level, A, AA or AAA, where it binds to a published criterion.".
fw:ruleStatement a owl:DatatypeProperty; rdfs:domain fw:DesignRule; rdfs:range xsd:string;
  rdfs:comment "What the rule requires, in the words a reader should see.".
fw:appliedTo a owl:DatatypeProperty; rdfs:domain fw:DesignRuleApplication; rdfs:range xsd:string;
  rdfs:comment "What was tested -- a role, a layer, or a pair of colours.".
# A decision the practitioner made, among alternatives that were all defensible.
#
# "It's a user preference, and the audit is in the N3 receipts in case anybody else wants it. FW
# is not multi-user, it only caters to the one user holding the browser, so N of 1 ... The user
# can audit that decision him/herself." -- 2026-10-17.
#
# Recorded separately from a rule not out of doubt about the judgement, but so a reader -- most
# often the same practitioner, later -- can tell "this map is sequential because the variable is
# ordered" from "this map is sequential because I prefer it". Both are legitimate; only one is a
# statement about the data.
fw:DesignChoice a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "A design decision taken by the practitioner";
  rdfs:comment "A choice among alternatives the application considered defensible. Not a rule, and not a setting: a setting records a value, and this records that a judgement was exercised and what it was exercised over.".
fw:designChoice a owl:ObjectProperty; rdfs:range fw:DesignChoice;
  rdfs:comment "A choice carried by a map specification.".
fw:decisionBasis a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What a design decision stands on. A rule states measured or categorical through fw:ruleKind; a practitioner's decision states SELECTED, and never preferred. A preference is a disposition -- a claim that this person tends to choose this -- and a single act cannot evidence one: 'We can not even infer preference from a single mouse click, we can only say selected. If selected so happens to map to a particular pattern choice, then we have stronger evidence to say preference' (2026-10-17). These receipts hold the observations; a preference would be an inference across many of them, and would need its own statement of what it rests on.".
fw:choiceSetting a owl:DatatypeProperty; rdfs:domain fw:DesignChoice; rdfs:range xsd:string;
  rdfs:comment "What was being decided, as the Inspector names it.".
fw:choiceMade a owl:DatatypeProperty; rdfs:domain fw:DesignChoice; rdfs:range xsd:string;
  rdfs:comment "What the practitioner chose.".
fw:choiceOffered a owl:DatatypeProperty; rdfs:domain fw:DesignChoice; rdfs:range xsd:string;
  rdfs:comment "What else was available. A choice between alternatives nobody can see is a setting rather than a judgement, and recording it as a judgement would overstate it.".

# The four rules, declared in full here rather than only in the code that applies them.
#
# They were bare `a fw:DesignRule` lines until 2026-10-17, when the SHACL shape written the same
# day refused them for carrying no kind and no statement -- which was the shape doing its job on
# the first graph it was pointed at, and that graph was this one. A rule whose statement lives
# only in TypeScript is vocabulary the ontology does not have.
#
# src/map-conformance.ts must agree with these, and tests/map-conformance.test.mjs checks that it
# does: two copies with no check between them is how a declaration and its implementation drift.
fw:MapTextContrast a fw:DesignRule; fw:ruleKind "measured";
  rdfs:comment "Text drawn on a map must reach 4.5:1 against the ground it sits on.";
  earl:test <https://www.w3.org/TR/WCAG22/#contrast-minimum>; fw:conformanceLevel "AA"; rdfs:seeAlso <https://www.w3.org/TR/WCAG22/#contrast-minimum>.
fw:MapMarkContrast a fw:DesignRule; fw:ruleKind "measured";
  rdfs:comment "A mark that carries meaning must reach 3:1 against the ground, or a reader cannot find it.";
  earl:test <https://www.w3.org/TR/WCAG22/#non-text-contrast>; fw:conformanceLevel "AA"; rdfs:seeAlso <https://www.w3.org/TR/WCAG22/#non-text-contrast>.
fw:CategoricalPaletteIsColourBlindSafe a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "Categories are drawn from a palette chosen to remain distinguishable under the common colour vision deficiencies.";
  dcterms:source "Brewer, on perceptual ordering and accessible palette choice; the palette itself is Okabe and Ito\u2019s".
fw:UnknownIsNotAHue a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "Absence of data is drawn in a neutral, never in a hue, because it is not a category and must not compete with one.";
  dcterms:source "Bertin, on the visual variables: hue is selective but not ordered, so spending it on an absence makes that absence compete as a category".

# The figure's own parts, added 2026-10-25 (experiment 136). Five of the six are CONDITIONAL and
# report inapplicable rather than failing: the cartographic canon holds that a north arrow and a
# scale bar are unnecessary on some maps and wrong on others, and that only a title is required
# of every map.
fw:FigureHasTitle a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "A figure states what it is. A reader who meets it outside the text it was written for has only its own parts to read it by.";
  dcterms:source "Buckley (Esri), who holds a north arrow and a scale bar to be unnecessary on some maps and harmful on others, and an appropriate title to be necessary on all of them".
fw:EveryMarkIsInTheKey a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "Every mark a figure draws is named in its key, or the reader is left to guess what it stands for.";
  dcterms:source "APA Publication Manual 7th edition, on the figure legend: it explains any symbols used in the figure image".
fw:FigureStatesItsSource a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "A figure names where its content came from, in the figure rather than in the text around it.";
  dcterms:source "APA Publication Manual 7th edition, on the figure note: it carries what the title, image and legend cannot, including attribution".
fw:OrientationIsStatedWhereItIsNotObvious a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "A map whose north is not up says which way is north. A north-up map does not need to, and a north arrow on a projection whose meridians converge is wrong rather than redundant.";
  dcterms:source "Ordnance Survey, that readers assume the top of a map is north unless told otherwise; Buckley, that north is true only along the central meridian of a conic or equal-area projection and a graticule should be shown instead of an arrow".
fw:ScaleStatementSurvivesItsProjection a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "A scale a figure claims says what it holds for. On unprojected coordinates scale varies with latitude, so a bar alone is true at one latitude and false elsewhere.";
  dcterms:source "Buckley, on scale varying across a projection, so that a single bar is true only where it was computed".
fw:BasemapIsCredited a fw:DesignRule; fw:ruleKind "categorical";
  rdfs:comment "A figure that draws a basemap carries that basemap\u2019s credit, because the credit is a condition of using it and not a courtesy.";
  dcterms:source "ODbL, the licence of OpenStreetMap-derived tiles, which requires attribution of the source database wherever the derived work is published".

fw:fieldBinding a owl:ObjectProperty; rdfs:domain fw:RuleApplication;
  rdfs:comment "Which attribute of a record supplies which predicate the rules read. Nothing is guessed from a column name, so a ruleset over arbitrary records is possible only because this is declared.".
fw:boundAttribute a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "The attribute on the record, as imported".
fw:boundPredicate a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "The predicate the rules use for it, in the authored namespace".
fw:boundKind a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "number, boolean or term. Decides how the value is written as a fact, and whether a comparison or a match can read it.".
fw:MapSpecification a owl:Class;
  rdfs:subClassOf prov:Plan;
  rdfs:label "Bounded map communication specification";
  rdfs:comment "Title, subtitle, legend visibility and source note for an existing spatial result. Does not compute, transform or validate geography. An interactive view exports local geometry as a static SVG, without basemap tiles.";
  fw:implementationStatus "implemented".
fw:mapSpecification a owl:ObjectProperty; rdfs:domain fw:MapView; rdfs:range fw:MapSpecification.
fw:mapLegend a owl:DatatypeProperty; rdfs:domain fw:MapSpecification; rdfs:range xsd:boolean.
fw:mapPresentation a owl:DatatypeProperty; rdfs:domain fw:MapSpecification; rdfs:range xsd:string.
fw:mapBasemap a owl:DatatypeProperty; rdfs:domain fw:MapSpecification; rdfs:range xsd:string;
  rdfs:comment "None uses local geometry offline; OSM and OpenTopoMap request third-party viewport tiles with visible attribution. Tiles are not included in the SVG export.".
fw:mapSourceNote a owl:DatatypeProperty; rdfs:domain fw:MapSpecification; rdfs:range xsd:string;
  rdfs:comment "Authored note or connected-source and method fallback; not a verified citation.".
fw:chartSpecification a owl:ObjectProperty; rdfs:domain fw:ChartView; rdfs:range fw:ChartSpecification.
fw:chartRenderer a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartMark a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartOrientation a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartField a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartMeasureKind a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartUnitStatus a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string;
  rdfs:comment "Record-count and location-membership-count have explicit counting units. Numeric totals whose source unit is unavailable are marked source-unit-not-specified; no physical unit is inferred.".
fw:chartLegend a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:boolean;
  rdfs:comment "True means categories are color encoded and a corresponding legend is shown.".
fw:chartXAxisTitle a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartYAxisTitle a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:chartSourceNote a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string;
  rdfs:comment "Authored source/method label or fallback result/run identifier shown with the chart. Not a verified citation.".
# A street network drawn as itself, rather than routed over. Declared 2026-10-13 when the Map
# gained a network input: four widgets consumed a network and none was an output, so a downloaded
# graph could not be looked at.
fw:networkJunctionCount a owl:DatatypeProperty; rdfs:domain fw:MapView; rdfs:range xsd:integer;
  rdfs:label "Junctions in the network drawn";
  rdfs:comment "Nodes in the street graph this view drew. A count of the graph, not of anything observed on the ground.";
  fw:implementationStatus "implemented".
fw:networkSegmentCount a owl:DatatypeProperty; rdfs:domain fw:MapView; rdfs:range xsd:integer;
  rdfs:label "Directed segments in the network drawn";
  rdfs:comment "Directed edges in the street graph this view drew. A walkable street is normally present twice, once in each direction, so this is about twice the number of streets.";
  fw:implementationStatus "implemented".

fw:rendererSpecification a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string;
  rdfs:comment "Exact generated renderer JSON for the bounded, executable view; data values are inline from the recorded count bins.".
fw:chartRendererVersion a owl:DatatypeProperty; rdfs:domain fw:ChartSpecification; rdfs:range xsd:string.
fw:CategoricalCount a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Categorical frequency computation";
  rdfs:comment "Counts each source record once, retaining zero categories and reporting unclassified values separately. Does not estimate population.";
  fw:implementationStatus "implemented".
fw:CountBin a owl:Class;
  rdfs:comment "One category and its count within a categorical summary. The count is of records or memberships, never of population.";
  rdfs:label "Count bin"; rdfs:subClassOf prov:Entity.
fw:countBin a owl:ObjectProperty; rdfs:range fw:CountBin.
fw:groupingField a owl:DatatypeProperty; rdfs:range xsd:string.
fw:categoryKey a owl:DatatypeProperty; rdfs:range xsd:string.
fw:recordCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
# How many records a source returned that stand outside the study area's own outline. Every
# facility source is bounded by a RECTANGLE -- Overpass takes one, Overture is read by extent, a
# country export is clipped to one -- and a rectangle is not a jurisdiction: on North Kivu, 526 of
# 961 stood in Uganda and Rwanda. The widget keeps what is inside the outline and states here what
# it set aside, because "how many did the source return that were not in my area" is a question a
# reviewer asks of a figure like this.
fw:outsideStudyAreaCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.

# Keeping the points that are in the area, as an operation rather than as a report.
#
# The predicate has existed since the coverage check -- `pointRelation`, with the OGC names below
# -- and the OPERATION did not: eleven widgets emit a point layer and none of them answered "keep
# the ones inside this area", so the decision was made privately inside whichever widget needed
# it. The practitioner, 2026-10-20: "We do not have a point in polygon process ... I mean widget."
fw:PointInPolygonClip a owl:Class; rdfs:subClassOf prov:Activity;
  rdfs:comment "Keeping the points of a layer that fall inside an area, by the same test the coverage check and the map use."@en.
# Which OGC Simple Features predicate the kept set answers to: sfWithin for strictly inside, and
# boundary points are sfTouches, which is why whether they are kept is stated rather than assumed.
fw:spatialPredicate a owl:DatatypeProperty; rdfs:range xsd:string.
fw:boundaryPointsKept a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:insideCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:boundaryCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:outsideCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.

# HOW a map distinguished one thing from another, not only WHAT it drew.
#
# The practitioner, 2026-10-20: "in the ontology do we have UI representations of differences?" and
# then "make sure there are N3 receipts for them". A map already asserted its layers; it did not
# assert what its channels were claiming, so a reader could see two sources in two colours and had
# no way to check what the colours meant.
#
# The marks are OGC Symbology Encoding's own WellKnownName terms, cited rather than minted. What
# is minted here is the BINDING -- which channel carries which variable, under which palette, and
# whether a practitioner chose it -- because SE says how to draw and has no vocabulary for what the
# drawing asserts. SymCore (18-067r3) is the conceptual model above SE and is deliberately not
# implemented: it assumes a styling pipeline applying symbolizers to features, and these maps are
# drawn by a renderer reading ports.
fw:encoding a owl:ObjectProperty;
  rdfs:comment "A binding of one visual channel to one variable, with the vocabulary it uses."@en.
fw:visualChannel a owl:DatatypeProperty; rdfs:range xsd:string.
fw:encodesVariable a owl:DatatypeProperty; rdfs:range xsd:string.
fw:palette a owl:DatatypeProperty; rdfs:range xsd:string.
fw:paletteAuthority a owl:ObjectProperty.
# Whether the palette is published as distinguishable under the common colour vision deficiencies.
# Stated because a map that needs it and does not have it is a map a reader may not be able to use.
fw:colourVisionSafe a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:fillMeaning a owl:DatatypeProperty; rdfs:range xsd:string.
fw:layerSymbol a owl:ObjectProperty;
  rdfs:comment "How one layer was drawn: its mark, its colour, and whether each was chosen or derived."@en.
fw:layerSource a owl:DatatypeProperty; rdfs:range xsd:string.
fw:layerLabel a owl:DatatypeProperty; rdfs:range xsd:string.
fw:mark a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "A graphic mark, named by the vocabulary fw:markVocabulary gives -- OGC Symbology Encoding 1.1 WellKnownName: square, circle, triangle, star, cross, x."@en.
fw:markVocabulary a owl:ObjectProperty.
fw:symbolColour a owl:DatatypeProperty; rdfs:range xsd:string.
# Chosen by a practitioner, or derived from the layer's position. "A triangle because somebody
# chose a triangle" and "a triangle because it was the second layer" are different claims about
# the same picture, and a reader auditing a figure needs to tell them apart.
fw:markChosen a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:colourChosen a owl:DatatypeProperty; rdfs:range xsd:boolean.

fw:RasterDataset a owl:Class;
  rdfs:comment "A raster held as a bounded window of native cells with its metadata. Cell values are not automatically interpretable as population or any other measure."; rdfs:subClassOf prov:Entity; rdfs:label "Raster dataset".
fw:RasterWindowAcquisition a owl:Class;
  rdfs:comment "An execution that retains a bounded native-resolution window of a source raster. No resampling or reprojection is performed."; rdfs:subClassOf prov:Activity; rdfs:label "Native raster window acquisition".
fw:RasterInputReading a owl:Class; rdfs:subClassOf prov:Activity;
  rdfs:label "Read retained raster input"; fw:implementationStatus "implemented";
  rdfs:comment "Read and verify a previously retained GeoTIFF window. This run activity is distinct from the earlier local-file acquisition and does not claim a fresh download or national-file checksum.".

fw:LocalFileDescriptor a owl:Class; rdfs:subClassOf prov:Entity; rdfs:label "Local source file descriptor"; rdfs:comment "Filename, size and metadata supplied with a retained subset; not a full-file checksum or embedded original.".
fw:rasterWidth a owl:DatatypeProperty.
fw:rasterHeight a owl:DatatypeProperty.
fw:validCellCount a owl:DatatypeProperty.
fw:insideCellCount a owl:DatatypeProperty.
fw:sourceBytes a owl:DatatypeProperty.
fw:pixelSizeX a owl:DatatypeProperty.
fw:pixelSizeY a owl:DatatypeProperty.
fw:rasterMaskMethod a owl:DatatypeProperty;
  rdfs:label "Raster mask method";
  rdfs:comment "The author-selected inclusion method: cell-center, all-touched, or bounding-window for an unmasked acquisition. The name alone does not fix the rule; fw:rasterMaskConvention identifies which rule the run applied.".
fw:rasterMaskConvention a owl:DatatypeProperty;
  rdfs:label "Raster mask convention";
  rdfs:comment "Identifies the exact inclusion rule a run applied, so receipts produced under different rules are not mistaken for each other. \"native-window/1\" retains a bounding window without masking. \"cell-centre/1\" includes a cell when its centre lies inside or on the cutline. \"positive-area/1\" includes a cell when the cutline covers part of its area or crosses its interior, which aligns with GDAL ALL_TOUCHED except where a cutline vertex lies exactly on a cell border. Receipts exported before 2026-10-08 carry no convention and were produced by an earlier, more inclusive all-touched rule.".
fw:rasterMaskMarginPixels a owl:DatatypeProperty;
  rdfs:label "Raster mask outer margin";
  rdfs:comment "The outer margin in native pixels applied to the inclusion test, between 0 and 1. A margin is a grid distance, not metres, and is this prototype\u2019s own extension with no GDAL equivalent.".
fw:rasterMarginPixels a owl:DatatypeProperty; rdfs:domain fw:RasterClipping; rdfs:range xsd:decimal;
  rdfs:comment "Outward cutline margin measured in native raster pixel coordinates, not metres.".
fw:clipGeometry a owl:ObjectProperty; rdfs:domain fw:SpatialOperation; rdfs:range geo:Geometry;
  rdfs:comment "The actual cutline used by a raster clipping activity, distinct from the shared study area.".
fw:sourcePixelWindow a owl:DatatypeProperty.
fw:rasterCRS a owl:ObjectProperty.

fw:pixelValueUnits a owl:DatatypeProperty; rdfs:label "Source-reported pixel value units".
fw:sourceAccessed a owl:DatatypeProperty; rdfs:label "Source access date entered by author".
fw:metadataOrigin a owl:DatatypeProperty; rdfs:label "Origin of descriptive metadata".
fw:travelTimeMinutes a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:label "Cumulative network travel-time threshold in minutes";
  rdfs:comment "Time budget of a computed catchment; not an observed journey duration or disjoint time band.".

# Added 2026-10-08. Terms the audit procedure requires to remain distinct but which had no
# class, and the disjointness axioms that make those distinctions checkable rather than
# merely documented. See docs/experiments/42-ontology-structure-and-meaning.md.

fw:ClippingBoundary a owl:Class;
  rdfs:subClassOf geo:Feature;
  rdfs:label "Clipping boundary";
  rdfs:comment "An operation-specific cutline. It may differ from the study area, and a clip must not be read as a statement about the reporting boundary. Raster and polygon clipping already emit their cutline under its own geometry identity, so the distinction holds in practice; this class names it. Receipts do not yet type the cutline with this class.";
  fw:implementationStatus "proposed".

fw:AcquisitionBoundary a owl:Class;
  rdfs:subClassOf geo:Feature;
  rdfs:label "Acquisition boundary";
  rdfs:comment "An expanded scope used to reduce boundary effects while acquiring data, distinct from the study area used for reporting. Buffer receipts currently type their output fw:StudyArea, so this distinction is not yet honoured at runtime; adopting this class would change those receipts and needs its own migration.";
  fw:implementationStatus "proposed".

fw:Presentation a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Presentation";
  rdfs:comment "An execution that displays existing results. A presentation preserves the values, geometry, CRS and missing-data decisions of the operation that produced them, and performs no scientific inference of its own.";
  fw:implementationStatus "implemented".
fw:MapView rdfs:subClassOf fw:Presentation.
fw:TableView rdfs:subClassOf fw:Presentation.
fw:ChartView rdfs:subClassOf fw:Presentation.

# Axioms about runtime plan and widget classes live in runtime.ttl beside those classes, so
# that file is self-consistent when a reader or reasoner loads it on its own.
# Disjointness, asserted only where both terms describe the same kind of thing and no graph
# this prototype emits types one individual as both. Cross-kind conflations, such as an
# activity that is also an entity, are PROV-O's own axioms and are checked by merging PROV-O
# in the Validation Lab rather than by restating them here.
fw:StudyArea owl:disjointWith fw:ClippingBoundary, fw:AcquisitionBoundary, fw:Catchment.
fw:ClippingBoundary owl:disjointWith fw:AcquisitionBoundary, fw:Catchment.
fw:AcquisitionBoundary owl:disjointWith fw:Catchment.
fw:Presentation owl:disjointWith fw:SpatialOperation.

# Fieldwork's boundary features are PROV entities as well as GeoSPARQL features. Stating this
# locally, rather than asserting it of geo:Feature in general, lets a reasoner see that a
# boundary cannot also be an execution: PROV-O declares prov:Entity and prov:Activity
# disjoint, and without this link the two hierarchies never meet.
fw:StudyArea rdfs:subClassOf prov:Entity.
fw:ClippingBoundary rdfs:subClassOf prov:Entity.
fw:AcquisitionBoundary rdfs:subClassOf prov:Entity.
fw:Catchment rdfs:subClassOf prov:Entity.
# Tabular input, added 2026-10-08. A table is keyed data without geometry; see
# docs/experiments/48-tabular-input.md.
fw:DataTable a owl:Class;
  rdfs:subClassOf prov:Entity, dcat:Dataset;
  rdfs:label "Data table";
  rdfs:comment "Rows identified by a tuple of declared key fields, carrying one declared value field, in long format. A data table has no geometry and no coordinate reference system: latitude and longitude columns, if present, are ordinary columns with no spatial meaning. It is not a point dataset, not a multi-measure cube and not a join.";
  fw:implementationStatus "implemented".
fw:TabularInput a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Tabular input";
  rdfs:comment "An execution that reads a long-format table, validates its declared key and value fields and retains it. It performs no calculation, no aggregation and no inference, and declaring a unit does not verify it.";
  fw:implementationStatus "implemented".
fw:keyField a owl:DatatypeProperty; rdfs:domain fw:DataTable; rdfs:range xsd:string;
  rdfs:label "Key field";
  rdfs:comment "One declared key column, emitted once per key in the order declared. Together the key fields identify a row uniquely; a duplicate key tuple is rejected on import.".
fw:valueField a owl:DatatypeProperty; rdfs:domain fw:DataTable; rdfs:range xsd:string;
  rdfs:label "Value field"; rdfs:comment "The single declared value column. One table carries one measure.".
fw:valueUnitStatus a owl:DatatypeProperty; rdfs:domain fw:DataTable; rdfs:range xsd:string;
  rdfs:label "Value unit status";
  rdfs:comment "Whether the workflow author stated a unit for the value field. A unit is author-stated and never inferred, and an unstated unit is recorded as unstated rather than assumed dimensionless.".
fw:valueUnit a owl:DatatypeProperty; rdfs:domain fw:DataTable; rdfs:range xsd:string;
  rdfs:label "Value unit"; rdfs:comment "The author-stated unit, present only when one was stated.".
fw:tableRowCount a owl:DatatypeProperty; rdfs:domain fw:DataTable; rdfs:range xsd:integer; rdfs:label "Table row count".
fw:tableMissingValueCount a owl:DatatypeProperty; rdfs:domain fw:DataTable; rdfs:range xsd:integer;
  rdfs:label "Missing value count";
  rdfs:comment "Rows whose value cell was empty. These are retained as unknown and never zero-filled, because zero is a measurement and absence is not.".

# A keyed table is not a point dataset. This is the distinction the admission review turns on.
fw:DataTable owl:disjointWith fw:PointDataset.

# RECORD LINKAGE. The vocabulary follows `EPIAI RECORDLINK` in the epi-info-ai repository, which
# the practitioner wrote and pointed this work at on 2026-10-21 rather than let it invent a second
# set of words for the same thing. A candidate is a pair the blocking rule retained; a class is
# what the thresholds proposed; a decision is what a person answered where the proposal was not
# confident enough to act on.
# A table and a boundary are two tables, one of which has a geometry column. Experiment 138.
fw:KeyedAreaJoin a owl:Class; rdfs:subClassOf prov:Activity;
  rdfs:label "Keyed area join";
  rdfs:comment "Putting a value from each row of a table onto the part of a study area that row names. Matching is EQUALITY after a declared normalisation: no similarity, no threshold, and no part is matched by resemblance. Distinct from record linkage, which decides whether two records are one subject and may ask a person; this decides nothing and reports every condition it met.".
fw:JoinFinding a owl:Class;
  rdfs:label "Join finding";
  rdfs:comment "A condition the join met and did not resolve: a part no row names, a row naming no part, two raw keys that normalise together, or two parts sharing one name. A finding is not an error. A boundary part with no row is a fact about the data, and the part is still drawn.".
fw:joinFinding a owl:ObjectProperty; rdfs:domain fw:KeyedAreaJoin; rdfs:range fw:JoinFinding;
  rdfs:comment "Each condition the join reported, carried individually rather than as a count, because a reader cannot act on \"32 of 32 matched\".".
fw:findingCode a owl:DatatypeProperty; rdfs:domain fw:JoinFinding;
  rdfs:comment "Which condition, from the closed set the join reports: missing-data-key, unmatched-data-key, unmatched-boundary, duplicate-boundary-key, ambiguous-data-key, multiple-data-rows.".
fw:findingSubject a owl:DatatypeProperty; rdfs:domain fw:JoinFinding;
  rdfs:comment "The name the condition is about, as the source wrote it rather than as the join folded it, so a reader can find it in their own file.".
fw:joinKeyField a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "The table column holding the name of a part.".
fw:joinValueField a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "The column whose value is put onto the boundary.".
fw:joinNormalisation a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "How a key was folded before comparison: exact trims and lowercases; fuzzy also replaces every run of non-alphanumerics with one space. Declared because it decides the match. Measured on Snow's South London, 2026-10-25: 23 of 32 sub-districts match exact and 32 of 32 fuzzy, the nine differing only in a comma.".
fw:boundaryPartCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Parts of the boundary offered to the join. Parts, not features: an undissolved boundary of 33 rings over 32 named places has 33.".
fw:tableRowCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Rows the table offered.".
fw:matchedPartCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Parts that carry a value.".
fw:matchedRowCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Distinct keys that reached a part. Lower than the matched part count where two parts share a name.".
fw:unmatchedPartCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Parts no row names. They are drawn and left empty, never omitted: a hole reads as a different claim than an absence of data.".
fw:unmatchedRowCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Rows naming no part of this boundary.".
fw:sharedPartCount a owl:DatatypeProperty; rdfs:domain fw:KeyedAreaJoin;
  rdfs:comment "Parts whose name is held by another part, and which therefore carry the same value. True of a rate, which is an intensity; NOT true of a count, which the same move would double.".
fw:RecordDeduplication a owl:Class; rdfs:subClassOf prov:Activity;
  rdfs:label "Record deduplication";
  rdfs:comment "Comparing records across point sources and merging the pairs that agree. Compares across sources only: duplicates within one source are not looked for.".
fw:LinkageCandidate a owl:Class;
  rdfs:label "Linkage candidate";
  rdfs:comment "One pair of records the blocking rule retained, with what each comparison said about it. A candidate is not a finding: the class it was given says whether the thresholds were confident enough to act.".
fw:nameField a owl:DatatypeProperty; rdfs:range xsd:string.
fw:nameMatchMethod a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Either exact after normalisation, or the Jaro-Winkler similarity: four-character prefix, scaling 0.1, applied when the Jaro similarity exceeds 0.7.".
fw:fuzzyThreshold a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:blockDistanceM a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:comment "Pairs further apart than this were never compared.".
fw:nearDistanceM a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:matchThreshold a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:reviewThreshold a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:comparedPairCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:blockedPairCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:matchedPairCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:awaitingDecisionCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "Pairs in the review band that nobody has decided. They stay two records.".
fw:mergedRecordCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger.
fw:linkageCandidate a owl:ObjectProperty; rdfs:range fw:LinkageCandidate.
fw:candidateClass a owl:DatatypeProperty; rdfs:range xsd:string.
fw:candidateScore a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:matchedName a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:matchedDistanceM a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:nameComparable a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:comment "False where a record has no name: a missing value never agrees with another missing value.".
fw:decisionReason a owl:DatatypeProperty; rdfs:range xsd:string.

# ---------------------------------------------------------------------------
# CAPS. Every magnitude in this application that can refuse a practitioner's work, as a term
# rather than as a constant with a comment. The practitioner, 2026-10-22, having met six of them
# one at a time over two days: "Caps should also be queryable in the ontology and receipts."
#
# A run asserts fw:governedBy against the caps that were in force, with the value that was in
# force, so a reader of a receipt can ask what bounded it and what that number was derived from.
# Generated from widgets/caps.json and gated by scripts/validate-caps.mjs.
# ---------------------------------------------------------------------------
fw:Cap a owl:Class;
  rdfs:label "Cap";
  rdfs:comment "A magnitude this application enforces. Carries the number, its unit, what it refuses, where the number came from, and the test that would replace it with a measurement.".
fw:capValue a owl:DatatypeProperty; rdfs:domain fw:Cap; rdfs:label "cap value".
fw:capUnit a owl:DatatypeProperty; rdfs:domain fw:Cap; rdfs:label "cap unit".
fw:capBasis a owl:DatatypeProperty; rdfs:domain fw:Cap;
  rdfs:comment "measured, derived or undderived. The third says the number was chosen.".
fw:capKind a owl:DatatypeProperty; rdfs:domain fw:Cap;
  rdfs:comment "artefact, platform or discovery. An artefact cap bounds something this application makes and is reasonable by construction; a platform cap reports a limit the environment imposes; a DISCOVERY cap bounds what a practitioner can find out, and decides in advance the answer to a question this project exists to ask.".
fw:capEvidence a owl:DatatypeProperty; rdfs:domain fw:Cap;
  rdfs:comment "What was measured, or what it was computed from, with the date.".
fw:capRefuses a owl:DatatypeProperty; rdfs:domain fw:Cap;
  rdfs:comment "What a practitioner is refused by it. \"Nothing\" is an answer and several caps give it.".
fw:capLiftTest a owl:DatatypeProperty; rdfs:domain fw:Cap;
  rdfs:comment "What would replace this number with a measured one, or retire it.".
fw:governedBy a owl:ObjectProperty; rdfs:range fw:Cap;
  rdfs:comment "A run was bounded by this cap. Asserted with the value in force at the time, which for a knob is not the declared default.".
fw:capValueInForce a owl:DatatypeProperty;
  rdfs:comment "The value a cap actually had for this run, where a practitioner can change it.".

<urn:fieldwork:cap:storage-quota> a fw:Cap;
  rdfs:label "storage-quota";
  fw:capKind "platform";
  fw:capValue 5226496;
  fw:capUnit "bytes";
  fw:capBasis "measured";
  fw:capEvidence "localStorage accepted 5,226,496 bytes in both engines, probed 2026-10-19. docs/experiments/121-storage-beyond-local-storage.md.";
  fw:capRefuses "A workflow whose saved form does not fit the browser's small store.";
  fw:capLiftTest "Workflows move to the large store, at which point this governs nothing.".
<urn:fieldwork:cap:geometry-bytes> a fw:Cap;
  rdfs:label "geometry-bytes";
  fw:capKind "discovery";
  fw:capValue 1048576;
  fw:capUnit "bytes";
  fw:capBasis "derived";
  fw:capEvidence "One extent as JSON against the measured quota; about 26,000 vertices at the measured 39.2 bytes each.";
  fw:capRefuses "A single study-area outline too large to save.";
  fw:capLiftTest "The same as storage-quota: geometry leaves localStorage.".
<urn:fieldwork:cap:area-bytes> a fw:Cap;
  rdfs:label "area-bytes";
  fw:capKind "discovery";
  fw:capValue 1572864;
  fw:capUnit "bytes";
  fw:capBasis "derived";
  fw:capEvidence "Every extent one area has had, doubled by the two writes per save, leaving about 40% of the quota free.";
  fw:capRefuses "A study area whose revision history is too large to save.";
  fw:capLiftTest "The same as storage-quota.".
<urn:fieldwork:cap:graph-limit-default> a fw:Cap;
  rdfs:label "graph-limit-default";
  fw:capKind "discovery";
  fw:capValue 50000;
  fw:capUnit "junctions";
  fw:capBasis "derived";
  fw:capEvidence "Bunia normalizes to 42,796 junctions and Buvuma Island to 11,359, measured 2026-10-20; the default must not refuse a town.";
  fw:capRefuses "Nothing by itself. It is the default value of a knob a practitioner sets.";
  fw:capLiftTest "Not a cap to lift: a default to re-derive when a larger real area is measured.".
<urn:fieldwork:cap:graph-limit-ceiling> a fw:Cap;
  rdfs:label "graph-limit-ceiling";
  fw:capKind "discovery";
  fw:capValue 1000000;
  fw:capUnit "junctions";
  fw:capBasis "undderived";
  fw:capEvidence "Chosen 2026-10-21 to sit past what a public Overpass instance will serve in one request. It was 50,000 -- the default itself -- so the knob could be lowered and never raised, and the byte cap derived from it could never be raised either. That is the cap that cost two days.";
  fw:capRefuses "A graph limit a practitioner tries to set above it.";
  fw:capLiftTest "A measured response size at which a browser actually fails, replacing a chosen number with a met one.".
<urn:fieldwork:cap:download-bytes-per-junction> a fw:Cap;
  rdfs:label "download-bytes-per-junction";
  fw:capKind "discovery";
  fw:capValue 600;
  fw:capUnit "bytes per junction";
  fw:capBasis "derived";
  fw:capEvidence "270 and 272 bytes per junction measured on two extents 2026-10-13, carried at roughly double as headroom. A province measured 163 on 2026-10-21, so the padding is nearly fourfold at that scale.";
  fw:capRefuses "Nothing directly; it sizes the download byte cap from the graph limit.";
  fw:capLiftTest "Re-derive from province-scale measurements rather than neighbourhood ones.".
<urn:fieldwork:cap:predicted-bytes-per-element> a fw:Cap;
  rdfs:label "predicted-bytes-per-element";
  fw:capKind "discovery";
  fw:capValue 150;
  fw:capUnit "bytes per element";
  fw:capBasis "measured";
  fw:capEvidence "1.42 MB over 9,458 elements is 150 B; 7.39 MB over 50,791 is 145 B. Unpadded, because it predicts a response rather than bounding one.";
  fw:capRefuses "A download whose predicted size, from the service's own count, exceeds the byte cap.";
  fw:capLiftTest "Nothing to lift: it is a measurement used to refuse before bytes are spent, which is the cheap place to refuse.".
<urn:fieldwork:cap:features-per-junction> a fw:Cap;
  rdfs:label "features-per-junction";
  fw:capKind "discovery";
  fw:capValue 4;
  fw:capUnit "features per junction";
  fw:capBasis "derived";
  fw:capEvidence "1.80 and 1.87 features per junction measured 2026-10-13, carried at roughly double.";
  fw:capRefuses "Nothing directly; it sizes the feature cap from the graph limit.";
  fw:capLiftTest "Re-derive at province scale.".
<urn:fieldwork:cap:segments-per-junction> a fw:Cap;
  rdfs:label "segments-per-junction";
  fw:capKind "discovery";
  fw:capValue 2.5;
  fw:capUnit "directed segments per junction";
  fw:capBasis "derived";
  fw:capEvidence "2.19 measured on real street data (11,497 over 5,249); 2.04 measured on a province 2026-10-21.";
  fw:capRefuses "Nothing now. It sized a graph refusal that was removed on 2026-10-21.";
  fw:capLiftTest "Not a cap any more; kept because the pair is still reported.".
<urn:fieldwork:cap:download-floor-bytes> a fw:Cap;
  rdfs:label "download-floor-bytes";
  fw:capKind "discovery";
  fw:capValue 16000000;
  fw:capUnit "bytes";
  fw:capBasis "derived";
  fw:capEvidence "Twice the largest extent this project had measured (7.39 MB), so the floor cannot refuse an example it ships.";
  fw:capRefuses "Nothing: it is a floor under the byte cap, not a ceiling over it.";
  fw:capLiftTest "Not applicable.".
<urn:fieldwork:cap:download-floor-features> a fw:Cap;
  rdfs:label "download-floor-features";
  fw:capKind "discovery";
  fw:capValue 120000;
  fw:capUnit "features";
  fw:capBasis "derived";
  fw:capEvidence "Twice the 50,791 features of that same extent.";
  fw:capRefuses "Nothing: a floor.";
  fw:capLiftTest "Not applicable.".
<urn:fieldwork:cap:edge-length> a fw:Cap;
  rdfs:label "edge-length";
  fw:capKind "discovery";
  fw:capValue 1000000;
  fw:capUnit "metres";
  fw:capBasis "undderived";
  fw:capEvidence "Raised from 100,000 on 2026-10-22, when 2 of 314,955 segments in a province's driving network were over it, the longest 100,723 m. A collapsed chain between junctions in rural Ituri is genuinely that long. 1,000 km is kept as a unit check: a length in degrees, or kilometres read as metres, lands orders of magnitude away.";
  fw:capRefuses "A single street segment longer than 1,000 km.";
  fw:capLiftTest "A unit declared on the field, at which point the magnitude check has nothing left to catch.".
<urn:fieldwork:cap:isochrone-measured-junctions> a fw:Cap;
  rdfs:label "isochrone-measured-junctions";
  fw:capKind "discovery";
  fw:capValue 2000;
  fw:capUnit "junctions";
  fw:capBasis "measured";
  fw:capEvidence "A 1 km square of central London normalizes to 5,249 junctions and exhausted a 4 GB heap during isochrone construction, 2026-10-13. The threshold sits below what failed.";
  fw:capRefuses "Nothing. Above it the isochrone step warns, and its own worker timeout reports what happened.";
  fw:capLiftTest "An isochrone implementation measured past it -- the street engine drew one over 1,152,974 junctions in 0.14 s on 2026-10-22, in WebAssembly and not in this code.".
<urn:fieldwork:cap:raster-window-cells> a fw:Cap;
  rdfs:label "raster-window-cells";
  fw:capKind "discovery";
  fw:capValue 16777216;
  fw:capUnit "cells";
  fw:capBasis "measured";
  fw:capEvidence "Measured 2026-10-22 in a Chromium tab against WorldPop Botswana 2025 at 100 m, a real 11,248 by 10,953 LZW GeoTIFF: 262,144 cells read in 77 ms, 14.4M in 1,217 ms, 36M in 2,625 ms, and the whole 123.2M-cell raster in 8,382 ms with every value touched and held live. Nothing degraded at any size. The previous value, 262,144, carried no evidence at all and was about 470 times below what a browser does comfortably; it would have refused a population denominator for Ituri, which needs about 14.4M cells.";
  fw:capRefuses "A study area whose window on a raster is larger than about 4,096 by 4,096 cells. A province at 100 m fits; a country does not.";
  fw:capLiftTest "The costs beyond the read: keeping a grid of this size in the payload store, carrying it through a project export, and drawing it. Only the read is measured, so only the read is claimed.".
<urn:fieldwork:cap:interactive-segments> a fw:Cap;
  rdfs:label "interactive-segments";
  fw:capKind "artefact";
  fw:capValue 200000;
  fw:capUnit "segments drawn";
  fw:capBasis "measured";
  fw:capEvidence "Measured 2026-10-22 in a Chromium tab with Leaflet's canvas renderer and straight two-point segments: 100,000 added in 76 ms and zoomed in 29 ms, 250,000 zoomed in 185 ms, 500,000 in 274 ms and 1,011,401 in 824 ms. Cost climbs steeply past a quarter of a million because every pan and zoom reprojects every segment, and a real edge carries geometry which multiplies it further. Ituri arrived the same day with 2,022,803 directed segments and the interactive map tried to draw all of them.";
  fw:capRefuses "Nothing. Beyond it the map draws an even sample and the layer control says how many of how many.";
  fw:capLiftTest "Not applicable: a limit on a drawing. The graph is untouched -- every junction is routed over, measured and exported.".
<urn:fieldwork:cap:bundle-bytes> a fw:Cap;
  rdfs:label "bundle-bytes";
  fw:capKind "discovery";
  fw:capValue 500000000;
  fw:capUnit "bytes";
  fw:capBasis "measured";
  fw:capEvidence "The largest project or bundle that may be read back in. It was 20,000,000, carrying no evidence, and the practitioner met it moving their own work from Safari to Chrome after Chrome would no longer open it. Raised to 500,000,000 on 2026-10-23 at their direction and measured rather than inferred: a project document of 2.6 million junctions serialises to 505,485,882 characters and parses in 3.3 seconds, and a 465 MB indented document was read and parsed in a Chromium tab in 1.1 seconds. V8 refuses a string past 536,870,888 characters -- asked directly, not assumed -- so a file at this limit sits about six per cent under the ceiling it would meet first, and the practitioner's own 472 MB workflow about twelve. Exports are compressed since 2026-10-22 and compact since 2026-10-23, so a file near this limit is an older uncompressed one.";
  fw:capRefuses "A project or bundle larger than 500 MB, or a compressed one that expands past it. The margin to the string ceiling above is small, and the failure there is \"Invalid string length\".";
  fw:capLiftTest "The rest of the import, which is unmeasured: validating the document and writing its payloads to the store. The better answer is a backup that does not carry data which can be downloaded again -- recorded as the direction a-backup-carries-the-work-not-the-data.".
<urn:fieldwork:cap:pdf-bytes> a fw:Cap;
  rdfs:label "pdf-bytes";
  fw:capKind "artefact";
  fw:capValue 5000000;
  fw:capUnit "bytes";
  fw:capBasis "derived";
  fw:capEvidence "One cited PDF attached to a workflow as evidence. A reference document, not data under analysis.";
  fw:capRefuses "A single attached PDF over 5 MB.";
  fw:capLiftTest "A measured distribution of the documents practitioners actually cite.".
<urn:fieldwork:cap:workflow-pdf-bytes> a fw:Cap;
  rdfs:label "workflow-pdf-bytes";
  fw:capKind "artefact";
  fw:capValue 10000000;
  fw:capUnit "bytes";
  fw:capBasis "derived";
  fw:capEvidence "Every cited PDF in one workflow together, so a workflow's evidence stays something a reader can receive.";
  fw:capRefuses "A workflow whose attached PDFs exceed 10 MB in total.";
  fw:capLiftTest "The same measurement as pdf-bytes, taken across a workflow.".
<urn:fieldwork:cap:preview-segments> a fw:Cap;
  rdfs:label "preview-segments";
  fw:capKind "artefact";
  fw:capValue 20000;
  fw:capUnit "segments drawn";
  fw:capBasis "derived";
  fw:capEvidence "A 292-pixel Inspector figure. A province's 3,755,832 segments would be tens of megabytes of path data and thousands of strokes per pixel.";
  fw:capRefuses "Nothing. Beyond it the picture is an even sample and the caption says so.";
  fw:capLiftTest "Not applicable: a limit on a drawing, not on data.".
<urn:fieldwork:cap:json-editor-elements> a fw:Cap;
  rdfs:label "json-editor-elements";
  fw:capKind "artefact";
  fw:capValue 20000;
  fw:capUnit "nodes plus directed edges";
  fw:capBasis "measured";
  fw:capEvidence "Measured 2026-10-22 on the Ituri extract in the Inspector: 113,485 nodes and 289,080 directed edges serialise to 41.8 MB pretty-printed and 59.7 MB after escaping, about 203 MB of UTF-16 held per render, in a collapsed <details> that showed none of it. Chrome killed the renderer. 20,000 elements is about 1.9 MB, the limit this same control already states for upload.";
  fw:capRefuses "Nothing about the network. Above it the hand-edit textarea is not offered and the panel says so; the file input stays and the graph is still held, drawn, run and exported.";
  fw:capLiftTest "Not applicable: a limit on a text box, not on data.".
<urn:fieldwork:cap:download-measured-junctions> a fw:Cap;
  rdfs:label "download-measured-junctions";
  fw:capKind "discovery";
  fw:capValue 27181;
  fw:capUnit "junctions";
  fw:capBasis "measured";
  fw:capEvidence "The largest graph this project has downloaded from the service, parsed and drawn: 27,181 junctions from a 7.39 MB response, 2026-10-13.";
  fw:capRefuses "Nothing. Above it the download warns that nothing larger has been tried.";
  fw:capLiftTest "A larger response downloaded, parsed and drawn, which replaces the figure.".
<urn:fieldwork:cap:extract-measured-junctions> a fw:Cap;
  rdfs:label "extract-measured-junctions";
  fw:capKind "discovery";
  fw:capValue 122061;
  fw:capUnit "junctions";
  fw:capBasis "measured";
  fw:capEvidence "A province's driving network read from a 416 MB published extract and taken into this application's structures, 2026-10-22. Held, not yet drawn, routed over or snapped to.";
  fw:capRefuses "Nothing. It is what the extract control reports having been measured to.";
  fw:capLiftTest "A larger extract-built graph drawn and routed over, which replaces the figure.".
<urn:fieldwork:cap:buffer-batch> a fw:Cap;
  rdfs:label "buffer-batch";
  fw:capKind "artefact";
  fw:capValue 25;
  fw:capUnit "geometries per batch";
  fw:capBasis "undderived";
  fw:capEvidence "Chosen so buffering many geometries yields to the event loop rather than blocking it. No measurement recorded.";
  fw:capRefuses "Nothing. It is a batch size, and a smaller one is only slower.";
  fw:capLiftTest "A measurement of frame time against batch size, which would replace the choice with a number.".
<urn:fieldwork:cap:preview-width> a fw:Cap;
  rdfs:label "preview-width";
  fw:capKind "artefact";
  fw:capValue 252;
  fw:capUnit "pixels";
  fw:capBasis "derived";
  fw:capEvidence "The Inspector panel is 292 pixels wide; the figure is that less its padding.";
  fw:capRefuses "Nothing. It is the width of a drawing.";
  fw:capLiftTest "Not applicable: a panel dimension, not a limit on data.".
<urn:fieldwork:cap:preview-height> a fw:Cap;
  rdfs:label "preview-height";
  fw:capKind "artefact";
  fw:capValue 168;
  fw:capUnit "pixels";
  fw:capBasis "derived";
  fw:capEvidence "Two thirds of the figure's width, so a square extent is not stretched.";
  fw:capRefuses "Nothing. It is the height of a drawing.";
  fw:capLiftTest "Not applicable: a panel dimension, not a limit on data.".
<urn:fieldwork:cap:corridor-buckets> a fw:Cap;
  rdfs:label "corridor-buckets";
  fw:capKind "artefact";
  fw:capValue 6;
  fw:capUnit "buckets";
  fw:capBasis "derived";
  fw:capEvidence "How finely a partial edge's corridor is approximated. Measured 2026-10-14 against an exact construction: 161,044 m2 against 160,785, a symmetric difference of 0.16%, and not purely conservative -- which the code states rather than assumes.";
  fw:capRefuses "Nothing. It trades area accuracy for work, and the error is measured.";
  fw:capLiftTest "Not applicable: an approximation parameter with its error stated, not a limit on data.".
<urn:fieldwork:cap:attempt-seconds> a fw:Cap;
  rdfs:label "attempt-seconds";
  fw:capKind "discovery";
  fw:capValue 180000;
  fw:capUnit "milliseconds";
  fw:capBasis "derived";
  fw:capEvidence "A RESPONSE budget, and only that since 2026-10-22. Raised 2026-10-19 from 20,000 after a one-line probe to overpass-api.de took 14.2, 27.3 and 26.3 seconds while answering 200 every time -- which showed 20 seconds was too short and nothing more. The replacement was borrowed from OSMnx, where 180 seconds is passed to Python requests, and there it is not a limit on a download at all: requests raises only when no bytes have arrived for that long. Imported here as a total elapsed deadline it meant something else, and aborted a transfer that was working.";
  fw:capRefuses "A service that has not begun to answer within three minutes. It no longer refuses a transfer that is arriving; STALL_MS governs that, which is what the borrowed number always meant.";
  fw:capLiftTest "A measured time at which a response of a given size actually arrives, so the budget follows the size rather than a borrowed default.".
<urn:fieldwork:cap:stall-seconds> a fw:Cap;
  rdfs:label "stall-seconds";
  fw:capKind "artefact";
  fw:capValue 90000;
  fw:capUnit "milliseconds";
  fw:capBasis "derived";
  fw:capEvidence "When the panel says in so many words that the service has gone quiet. It was 180,000 -- inherited from the response budget it replaced -- which meant a stalled transfer showed its last byte count for three minutes and looked exactly like one still arriving. Ninety seconds is the practitioner's, 2026-10-22: \"180s may be too long to wait to say it's stalled. 90s, time to give feedback.\" The faster half of the feedback is the transfer rate, said every second, which falls on its own the moment chunks stop.";
  fw:capRefuses "Nothing. It is when a sentence appears. A download that has begun to arrive is ended only by the practitioner pressing Stop.";
  fw:capLiftTest "Not applicable: a threshold for a status line, not a limit on data.".
<urn:fieldwork:cap:rate-window> a fw:Cap;
  rdfs:label "rate-window";
  fw:capKind "artefact";
  fw:capValue 5000;
  fw:capUnit "milliseconds";
  fw:capBasis "derived";
  fw:capEvidence "How much history the transfer rate is averaged over, so the number is not noise between chunks and still falls while someone is watching it. The practitioner, 2026-10-22: \"Feedback could also be bytes/sec download speed. If the user sees it going down, that's immediate feedback.\"";
  fw:capRefuses "Nothing. It is the width of an average shown in a status line.";
  fw:capLiftTest "Not applicable: a display window, not a limit on data.".
<urn:fieldwork:cap:total-seconds> a fw:Cap;
  rdfs:label "total-seconds";
  fw:capKind "discovery";
  fw:capValue 300000;
  fw:capUnit "milliseconds";
  fw:capBasis "derived";
  fw:capEvidence "Five minutes across the probe, the count, the failover attempts and any wait for a free slot. It is consulted between attempts and to bound a wait, never during a transfer: a stream that is delivering is governed by STALL_MS alone.";
  fw:capRefuses "A download whose attempts together run past five minutes before a service begins to answer.";
  fw:capLiftTest "The same measurement: a budget derived from response size rather than chosen.".
<urn:fieldwork:cap:status-timeout> a fw:Cap;
  rdfs:label "status-timeout";
  fw:capKind "artefact";
  fw:capValue 12000;
  fw:capUnit "milliseconds";
  fw:capBasis "undderived";
  fw:capEvidence "How long this client waits for an instance's /api/status before calling it unreachable for the purposes of choosing one. Chosen.";
  fw:capRefuses "Nothing a practitioner asked for: a slow status read only removes an instance from the preference order.";
  fw:capLiftTest "Not applicable: it bounds this client's own impatience, not what can be found.".
