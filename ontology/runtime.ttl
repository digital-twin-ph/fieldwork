@prefix fw: <urn:fieldwork:>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix geo: <http://www.opengis.net/ont/geosparql#>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<urn:fieldwork:ontology:runtime> a owl:Ontology; owl:versionInfo "0.6 experimental, 2026-10-09";
  rdfs:comment "Implemented run bindings and bounded network/catchment receipts. No learner/game runtime is implied.".
fw:WidgetDefinition a owl:Class;
  rdfs:comment "A versioned description of a reusable operation and interface contract. A definition is not a configured plan and not an execution.";
  rdfs:label "Widget definition"; rdfs:subClassOf prov:Entity.
fw:WorkflowNodePlan a owl:Class;
  rdfs:comment "The configuration identity of a node as observed in a completed run. Distinct from an unfinished canvas plan, which carries no execution claim.";
  rdfs:label "Workflow node plan"; rdfs:subClassOf prov:Plan.
fw:WorkflowStep a owl:Class;
  rdfs:label "Workflow step"; rdfs:subClassOf prov:Activity;
  rdfs:comment "Execution envelope connecting a node plan, upstream outputs and operation-specific receipt activities; not an additional generating activity for an already generated entity.".
fw:widget a owl:ObjectProperty; rdfs:range fw:WidgetDefinition.
# The practitioner's point of 2026-10-14: the ontology entry for a widget should point to that
# widget's page of the manual, so "where is the documentation for this?" is a question the graph
# answers rather than a convention a reader has to know.
#
# Declared as a sub-property of rdfs:seeAlso rather than minted free-standing, which is the
# vocabulary rule this project follows: rdfs:seeAlso already means "a resource that may provide
# additional information", and a tool that knows only RDFS still finds the page. What seeAlso does
# not say is WHICH kind of further reading, and a widget has several -- a lab notebook, an
# experiment record, a release file. This names the one written for someone using the widget.
fw:userManual a owl:ObjectProperty;
  rdfs:subPropertyOf rdfs:seeAlso;
  rdfs:domain fw:WidgetDefinition;
  rdfs:label "Manual page for this widget";
  rdfs:comment "The page of the distributed user manual that describes this widget: what to connect, what to set, what it assumes, and what it refuses. Distinct from fw:diveDeeperNotebook, which is the lab material for a reader who wants to understand the method, and from the release file, which is the contract. One page per widget, browsable inside the application.";
  fw:implementationStatus "implemented".
fw:nodeType a owl:DatatypeProperty; rdfs:range xsd:string.
fw:catalogVersion a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Observed descriptor version bundled with the application, not a request to dispatch an old executable.".
fw:catalogDigest a owl:DatatypeProperty; rdfs:range xsd:string.
fw:widgetDefinitionSource a owl:DatatypeProperty; rdfs:domain fw:WorkflowNodePlan; rdfs:range xsd:string;
  rdfs:comment "Where the executed definition came from: \"host-registry\" for a definition compiled into the application, \"pack\" for one supplied by an admitted widget pack. Stated positively so that a receipt asserting host provenance can be falsified rather than assumed from silence.".
fw:PackCatalog a owl:Class;
  rdfs:label "Widget pack catalog"; rdfs:subClassOf prov:Entity;
  rdfs:comment "The curated pack catalog a build was made from, identified by its version and the digest of its file. Recorded metadata about the build, not a rule premise, not a claim that any pack was reviewed, admitted, available or used, and not a dataset the run took as evidence.".
fw:packCatalogVersion a owl:DatatypeProperty; rdfs:domain fw:PackCatalog; rdfs:range xsd:string.
fw:packCatalogDigest a owl:DatatypeProperty; rdfs:domain fw:PackCatalog; rdfs:range xsd:string;
  rdfs:comment "SHA-256 of the catalog file as built, so a receipt can be compared with the catalog in the repository.". 
fw:resultEntity a owl:ObjectProperty; rdfs:domain fw:WorkflowStep; rdfs:range prov:Entity.
fw:receiptActivity a owl:ObjectProperty; rdfs:domain fw:WorkflowStep; rdfs:range prov:Activity.

fw:PointInput a owl:Class;
  rdfs:comment "Point data supplied to an operation through a typed port. The port guarantees shape, not scientific suitability.";
  rdfs:label "Point input"; rdfs:subClassOf prov:Activity; fw:implementationStatus "implemented".
fw:PointDataset a owl:Class;
  rdfs:comment "A collection of point features with their attributes. Records without coordinates are retained and remain explicitly unknown.";
  rdfs:label "Point dataset"; rdfs:subClassOf geo:FeatureCollection, dcat:Dataset, prov:Entity.
fw:PolygonDataset a owl:Class;
  rdfs:comment "A collection of polygon features with their attributes. Parts are not dissolved: a boundary of 33 rings over 32 named places stays 33 features, and two parts of one place each carry that place's value. Features without a value are retained and remain explicitly unknown, as the point dataset does for coordinates.";
  rdfs:label "Polygon dataset"; rdfs:subClassOf geo:FeatureCollection, dcat:Dataset, prov:Entity.
fw:sourceMetadata a owl:DatatypeProperty; rdfs:comment "Supplemental source metadata JSON; author supplied, not independently verified.".
fw:missingLocation a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:StreetNetwork a owl:Class;
  rdfs:comment "A directed graph of street segments with metre lengths, from an upload or a bounded download. Reachability is modelled under the graph’s own assumptions; it is not observed travel.";
  rdfs:label "Street network"; rdfs:subClassOf dcat:Dataset, prov:Entity.
fw:NetworkVertex a owl:Class;
  rdfs:comment "A node of a street network graph with its location. Vertex identity comes from the source graph and is not reinterpreted.";
  rdfs:label "Network vertex"; rdfs:subClassOf geo:Feature.
fw:NetworkEdge a owl:Class;
  rdfs:label "Network edge"; rdfs:subClassOf prov:Entity;
  rdfs:comment "Directed edge with supplied cost length; optional curved geometry. Parallel edges remain distinct.".
fw:networkNode a owl:ObjectProperty; rdfs:domain fw:StreetNetwork; rdfs:range fw:NetworkVertex.
fw:networkEdge a owl:ObjectProperty; rdfs:domain fw:StreetNetwork; rdfs:range fw:NetworkEdge.
fw:fromVertex a owl:ObjectProperty; rdfs:range fw:NetworkVertex.
fw:toVertex a owl:ObjectProperty; rdfs:range fw:NetworkVertex.
fw:directed a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:edgeLength a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:CatchmentDataset a owl:Class;
  rdfs:comment "A collection of modelled catchment features produced by one computation. Membership models allocation or reachability under stated assumptions, not observed service use.";
  rdfs:label "Catchment dataset"; rdfs:subClassOf geo:FeatureCollection, dcat:Dataset, prov:Entity.
fw:Catchment a owl:Class;
  rdfs:label "Catchment"; rdfs:subClassOf geo:Feature;
  rdfs:comment "Modeled region for a source site. A network threshold is cumulative, not an observed service catchment.".
fw:sourceSite a owl:ObjectProperty; rdfs:range geo:Feature.
fw:countSemantics a owl:DatatypeProperty; rdfs:range xsd:string.
fw:travelTime a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:timeBudget a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:walkingSpeed a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:corridorWidth a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:snapLimit a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:fillInteriorHoles a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:travelDirection a owl:DatatypeProperty; rdfs:range xsd:string.
fw:NetworkSnap a owl:Class;
  rdfs:comment "The association of a site with a network vertex, with the snapping distance. Snap distance is not charged as travel time.";
  rdfs:label "Network snap"; rdfs:subClassOf prov:Entity.
fw:snap a owl:ObjectProperty; rdfs:range fw:NetworkSnap.
fw:networkVertexId a owl:DatatypeProperty; rdfs:range xsd:string.
fw:snapDistance a owl:ObjectProperty; rdfs:range qudt:QuantityValue.
fw:boundaryPolicy a owl:DatatypeProperty; rdfs:range xsd:string.
fw:valueField a owl:DatatypeProperty; rdfs:range xsd:string.

# THE SHAPE A TABULAR FILE WAS READ IN, asserted on the reading rather than on the table.
# A wide file is melted at the door -- one row per subject becomes one row per subject per
# variable -- so the long table a run computes over is not the shape the practitioner supplied.
# The distinction is about the ACTIVITY, which is why these hang off fw:TabularInput and not
# off fw:DataTable: the table is long in both cases and only the reading differs.
fw:readAs a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Either \"wide\" or \"long\": the shape the source file was read in. Asserted for both, because a file that was already long is as much a fact about the reading as a melt is.".
fw:subjectKeyField a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "A column of a wide file identifying the subject of a row. One row per subject, so these together identify a row before the melt.".
fw:meltedValueField a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "A column of a wide file taken as a variable and melted into the measure key. NAMED rather than inferred from what is left over, so a column the file gains later is absent from the analysis by decision; its absence here is therefore meaningful.".
fw:measureKeyField a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The key column of the resulting long table that holds the melted columns' names.".
fw:meltedValueFieldCount a owl:DatatypeProperty; rdfs:range xsd:integer.

# A MEASURE CALLED WHAT THE ANALYSIS CALLS IT. A published file's header is a machine name --
# `population_1851`, `deaths_southwark_vauxhall` -- and an analysis has its own vocabulary. The
# melt may be told one per column, and the renaming is RECORDED rather than only applied: a reader
# who meets "population" in a result and `population_1851` in the file has to be able to follow one
# to the other, and the reason for melting during the run rather than in a dialog was that the melt
# becomes a step with a receipt.
fw:measureRenaming a owl:ObjectProperty;
  rdfs:comment "One column renamed on the way into the measure key, as a blank node carrying fw:fromColumn and fw:toMeasure. Absent where a melt took every column under its own name.".
fw:fromColumn a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The column of the source file, as the file spells it.".
fw:toMeasure a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What that column is called in the analysis. Author-stated and never inferred from the column name: replacing underscores with spaces is right for \"deaths 1849\" and wrong for \"deaths pump-wells\", and a rule cannot tell which.".

# A PUBLISHED POLYGON LAYER, read rather than derived.
#
# Declared 2026-10-28 with `polygon_input`. Seven producers of polygons derived them from something
# else, so nothing in the evidence had to distinguish a read shape from a computed one. Now one
# does, and fw:readAsPublished is the assertion a reader needs: it says the vertices are the
# author's and that nothing in this application clipped, simplified or reprojected them.
fw:PolygonLayer a owl:Class;
  rdfs:comment "A layer of polygon features read from a published file, as published. Distinct from every other value on the polygons port, each of which was DERIVED -- allocated to cells, joined to an area, hulled, buffered or stacked.".
fw:featureCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "How many features the layer holds.".
fw:vertexCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "Positions across every ring of every feature. Stated because it is the measure of what was NOT simplified: a layer whose vertex count changed between the file and the figure was altered on the way in.".
fw:readAsPublished a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:comment "True where the geometry is the author's own, unclipped, unsimplified and unreprojected. Clipping to a study area is a separate step with its own receipt, so that what was cut is a choice a reader can see rather than something that happened at the door.".
fw:namedBy a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The property each feature was named by, chosen by the practitioner. Never inferred from a property name: the same rule the records table states, and a name the file does not carry is a refusal rather than a fallback.".
fw:layerFile a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The file the layer was read from, as the practitioner's filesystem spelled it.".
fw:layerFileDigest a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "SHA-256 of that file's bytes, so a figure can be traced to the geometry it was drawn from rather than to a filename somebody could have changed under it.".

# RELATING TWO TABLES, and the decision a practitioner made about the rows that did not match.
#
# The counts were computed from this widget's first release and reached the panel only; a reader of
# the evidence got nothing. Declared here from 2026-10-28 so the join is machine readable, which
# matters most for fw:retainedShare: an inner join multiplies a rate of one variable over another
# by exactly the ratio of their retained shares, so these numbers let somebody reconcile a figure
# they did not expect against the join that produced it, from the receipt alone.
fw:TableRelate a owl:Class;
  rdfs:comment "One relate step: a key column brought from a second table onto the rows of a first, matched on a shared key. Epi Info's RELATE and deliberately not its MERGE -- the row count does not change, because a category brought across can only be a key column.".
fw:matchedOn a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "A key column both tables carry, as the tables spell it. Stated once per key column: since 2026-11-05 a relate may match on several together, a row relating only where all of them agree.".
fw:broughtColumn a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The second table's column added to the first table's rows.".
fw:keyComparison a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "How key cells were compared: \"exact\" after trimming, or \"punctuation-folded\". Stated because it decides WHICH rows matched -- 23 of Snow's 32 sub-districts match the published boundaries exactly and 32 of 32 once punctuation is folded, every difference a single comma.".
fw:offeredRowCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "Rows the first table brought in. The denominator the other counts mean something against, and absent from the result table, which holds only what survived.".
fw:relatedRowCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "Rows that found a match in the second table.".
fw:droppedRowCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "Rows excluded because the second table had no row for their key, at the practitioner's declared choice. Never a default: the run refuses until the choice is made.".
fw:keptRowCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "Rows retained under a declared category despite having no match. Zero unless the practitioner chose to keep them.".
fw:unmatchedKey a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "One key of the first table that the second had no row for, by its raw spelling. Named rather than counted, because a name is what a practitioner can go and look for in the file.".
fw:unmatchedDecision a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What the practitioner decided about the unmatched rows: \"drop\" or \"keep\". Recorded because the two give different totals and the result table cannot be read for which was chosen.".
# fw:decisionReason is NOT declared here. `deduplicate_points` already declared it in
# fieldwork.ttl for the same thing -- why a practitioner decided as they did -- and a second
# declaration would be a second term's worth of maintenance for one meaning.
fw:declaredCategory a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The category the kept rows carry, in the practitioner's own words. Nothing here invents a stratum the data never measured; a declared one is attributable.".
fw:retainedShare a owl:ObjectProperty;
  rdfs:comment "What the join did to one numeric variable, as a blank node carrying fw:ofVariable, fw:offeredTotal, fw:relatedTotal and fw:retainedFraction. One per variable the table holds.".
fw:VariableShare a owl:Class;
  rdfs:comment "The totals of one numeric variable before and after a join, and the fraction retained.".
fw:ofVariable a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Which numeric variable this share is of: a value of the table's measure key, or its value field where nothing names one.".
fw:offeredTotal a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:comment "This variable's total over every row the first table offered.".
fw:relatedTotal a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:comment "This variable's total over the rows that matched.".
fw:retainedFraction a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:comment "fw:relatedTotal divided by fw:offeredTotal. Absent where the variable totals nothing to divide by. Where two of these differ, the rows that did not match are not a random sample of what is being measured, and a rate of one variable over another is multiplied by the ratio of their fractions.".
fw:machinedNote a owl:ObjectProperty;
  rdfs:comment "A note this widget machined for the write-up, as a blank node carrying fw:noteSection and fw:noteText. The sibling of a quoted note: a quoted note carries an author's own sentence, a machined one carries the application's account of what it did.".
fw:MachinedNote a owl:Class;
  rdfs:comment "Prose generated by a widget for a part of a write-up, rather than for the interface. IMRAD names the body -- introduction, methods, results, discussion -- and a title and an abstract are front matter, so \"IMRAD section\" is too narrow a term for the field's range.".
fw:noteSection a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The part of a write-up the note belongs under, spelled as the quoted notes spell it -- capitalised, because that schema had a spelling first and two kinds of note that cannot be grouped together cannot be read in one place. A join maps to \"Methods\": it is a thing done to the data, and the count of what it excluded is Methods prose in an epidemiology paper. Ranges over the IMRAD body only: a title and an abstract are front matter AND are assembled from declarations across a workflow rather than owned by one node, so neither is a value here.".
fw:noteText a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The note itself, written as sentences for a reader of the paper.".
fw:noteFunction a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "What the note does inside its section";
  rdfs:comment "Reconciled by the practitioner on 2026-10-29 against a prototype: context, rationale, source, method, verification, finding, limitation. DELIBERATELY NOT A CLOSED SET IN THE SHAPE, which is the position fw:creditRole's comment already records -- the set is open because its producers were still being written. An artifact's self-description states NO function at all, because none of the seven describes what it does and coining an eighth to file it under is how a vocabulary gets withdrawn; absent is therefore a legitimate value and the shape requires at most one, not at least one. Declared 2026-10-30, having been named in a comment since 2026-10-29 and declared nowhere.".
fw:figureNumber a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:label "The number a figure carries in a rendered document";
  rdfs:comment "DECLARED SO THAT A SHAPE CAN FORBID IT ON A MACHINED NOTE, which is this project's habit of asserting an absence rather than leaving a silence. A number depends on where an artifact sits in the outline and on the venue's convention, so it is computed when a document is rendered: set one figure aside and the ones after it move up. A number written into machined prose would be right when it was machined and wrong the first time somebody moved a card. The rule is structural and not a pattern over the text, because \"Map 2, 1855\" is the NAME of Snow's plate and any pattern that caught a figure number would catch it too -- found by a unit test on 2026-10-30.".

# --- WHAT A STEP PUBLISHED, and the account it owes of it (experiment 141) ------------------
#
# The practitioner, 2026-10-30, four times across one afternoon: *"charts, maps and tables are
# not there"*. They were not, and nothing in the record said so -- a step could draw a table,
# record a receipt for it, and put nothing in the write-up, and every gate stayed green because
# no rule said a published artifact owes a reader anything.
fw:publishesArtifact a owl:ObjectProperty;
  rdfs:label "An artifact this step published for a reader";
  rdfs:comment "A table, a chart or a map that a step PUBLISHED, as distinct from a value it passed on. The distinction is the widget's own: only an output widget publishes, which is why a table computed mid-chain is kept for inspection and is not an artifact here.".
fw:PublishedArtifact a owl:Class; rdfs:subClassOf prov:Entity;
  rdfs:label "Published artifact";
  rdfs:comment "A thing a reader of the write-up meets as a figure or a table. It declares its kind and the shape a reader needs to interpret it, and the step that published it owes it a machined note.".
fw:figureSection a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:label "Where the step's figure goes in the write-up";
  rdfs:comment "The part of the write-up that a published table, chart or map is filed under: Introduction, Methods, Results or Discussion. Asserted on the step that published it, beside its machined note, and held equal to that note's fw:noteSection by fw:FigureFiledWhereDeclaredShape. References holds works and is not a value here. The practitioner, 2026-11-05: all output widgets may have default IMRAD sections, but it should be flexible.".
fw:figureSectionDeclared a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:label "Whether the section was chosen";
  rdfs:comment "True when the practitioner chose the section on the output widget, false when it is the widget's fw:defaultFigureSection. A figure in Results by default and one placed there deliberately are the same placement and different decisions.".
fw:defaultFigureSection a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:domain fw:WidgetDefinition;
  rdfs:label "Where an output widget's figure goes unless the practitioner chooses otherwise";
  rdfs:comment "Generated into ontology/widgets.ttl from DEFAULT_FIGURE_SECTIONS in src/notes.ts, the constant the application applies, so the ontology and the application cannot state different defaults.".
fw:artifactKind a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "table, chart or map. A CLOSED set, unlike fw:noteFunction: these three are the output widgets this application has, and a fourth would be a new widget rather than a new word for an existing one.".
fw:artifactRowCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "Rows in a published table, as the table reports them rather than as a figure drew them -- a figure may draw fewer and says so.".
fw:artifactBarCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "Bars in a published chart. A bar at zero is counted: a withheld value and a measured zero are drawn the same way, and the count is what lets a reader find the difference in the table.".
fw:artifactLayerCount a owl:DatatypeProperty; rdfs:range xsd:nonNegativeInteger;
  rdfs:comment "Layers a published map DREW, which is not the number connected to it. fw:layerDrawn exists so a receipt can tell a map that showed three of five layers from one only ever wired to three.".

# --- THE METHOD A COMPUTATION USED, cited or stated as uncitable (experiment 151) -----------
fw:citesMethod a owl:ObjectProperty;
  rdfs:label "An estimator this computation used, with its source";
  rdfs:comment "Named rather than left to be read out of the prose, so an aggregate References part does not have to recover works by matching text against sentences -- which would break the first time a citation style changed, and a venue changes citation style on purpose.".
fw:MethodCitation a owl:Class;
  rdfs:label "Method citation";
  rdfs:comment "One estimator and what is known about where it comes from. It carries EITHER a rendered reference OR a stated reason there is none, never neither: a reader meeting a short list cannot tell a method nobody has looked up from a method with nothing to look up, and that is the distinction fw:epiInfoLabelSource exists to keep, one field over.".
fw:methodName a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The estimator as the implementation names it -- \"Katz log\", \"Wald unpooled\" -- which is the key its reference is held under.".
fw:methodReference a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The work, rendered in the citation style the application uses. Absent where no primary source has been read; a half-rendered reference is refused entirely, because one looks checkable and is not.".
fw:methodUncited a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Why this estimator carries no reference, in words a reader can act on. Present exactly when fw:methodReference is absent. A plausible-looking reference would be worse than none: it is the point at which a reader stops checking.".

# A SCANNED OR PUBLISHED MAP, drawn as ground. Typed apart from fw:Raster on purpose: a raster
# carries measurements and may be clipped and sampled, and a plate carries a printer's ink. The
# port type makes the wrong connection impossible; this makes the distinction readable.
fw:MapImageInput a owl:Class; rdfs:subClassOf prov:Activity;
  rdfs:label "Map image input";
  rdfs:comment "Reading a georeferenced image into a workflow as context. Not an acquisition of measurements.".
fw:MapImage a owl:Class; rdfs:subClassOf prov:Entity;
  rdfs:label "Map image";
  rdfs:comment "A georeferenced image drawn under a workflow. CONTEXT, never frame: its pixels are ink, so sampling them returns the colour of a line rather than a measurement, and joining data to what it depicts is not supported.".
fw:imageDigest a owl:DatatypeProperty; rdfs:range xsd:string.
fw:imagePixelWidth a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:imagePixelHeight a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:groundResolutionMetres a owl:DatatypeProperty; rdfs:range xsd:decimal;
  rdfs:comment "Metres on the ground for one pixel, at the middle of the extent. What the plate can and cannot show.".
fw:westBound a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:southBound a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:eastBound a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:northBound a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:layerRole a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What a drawn layer is for. \"context\" means it may not be measured or joined to.".

# WHERE AN INPUT CAME FROM AND WHAT IT MAY BE USED FOR, asserted on the input that incurs it.
# The practitioner's rule of 2026-10-27: all inputs carry their provenance and licence with them.
# Before this, a figure decided whether to credit OpenStreetMap by testing whether its method
# description contained the word "Dijkstra" -- an obligation discharged by substring-matching a
# sentence written for a human to read.
fw:licence a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "An SPDX identifier, \"none-applies\" where a positive claim is made that no terms attach, or \"unstated\" where nobody has said. Never blank: the three are different claims and a blank field has been read as all of them.".
fw:licenceSource a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Where the licence was read, so a reader can check the claim rather than trust it.".
fw:requiredAttribution a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The exact text a figure redistributing this data must carry.".
fw:shareAlike a owl:DatatypeProperty; rdfs:range xsd:boolean;
  rdfs:comment "Whether the licence carries its terms onward to derived work. Absent where the licence is one nobody has encoded, which is not the same as false.".
fw:describedAs a owl:DatatypeProperty; rdfs:range xsd:string.
fw:retrievedFrom a owl:DatatypeProperty; rdfs:range xsd:string.
fw:retrievedAt a owl:DatatypeProperty; rdfs:range xsd:string.
fw:represents a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The period the data represents, which is not when it was retrieved: a boundary fetched in 2026 may represent 1855.".

# THE WORK AN INPUT CAME FROM, ASSERTED AS FIELDS RATHER THAN AS A RENDERED SENTENCE.
# Experiment 144. A receipt that recorded only "Snow J. On the mode... 1855." would be the
# free-text problem one layer down: a reader could not re-render it in their own citation style.
# So each part is its own statement, and the three styles are rendered by the reader rather than
# baked in by the writer. Standard terms are used where they exist -- dcterms:title, creator,
# publisher, isPartOf, issued -- and only what Dublin Core does not name is minted here.
fw:citationType a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What kind of work the origin is: book, chapter, article, map, dataset, report or webpage. Each citation style punctuates the kinds differently and two of them add a bracketed designator for the non-print ones, so the kind is recorded rather than inferred from which fields are filled.".
fw:publicationPlace a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The place of publication, as a citation prints it. Not a geography: \"London\" here is part of a reference and is never read as a location.".
fw:volume a owl:DatatypeProperty; rdfs:range xsd:string.
fw:issue a owl:DatatypeProperty; rdfs:range xsd:string.
fw:pages a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The page range as printed, including the dash the source used. A string rather than two integers, because a reference may read \"S12-S19\" or \"e0123456\".".
fw:doi a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The DOI, bare: 10.1016/j.healthplace.2006.01.001, never a doi.org URL. Preferred over a URL wherever one exists, because a DOI still resolves after a publisher moves its site. A malformed DOI is refused rather than asserted: a broken one looks resolvable.".

# The edition actually read, where that is not the publication. Snow's second edition is 1855 and
# the Project Gutenberg transcription of it was released 2024-02-07; a citation says both, and an
# ordering by literature uses the first.
fw:editionStatement a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The edition as a citation style prints it: \"2nd\", \"rev.\". Distinct from the edition's own date and publisher, which are the two properties below.".
fw:editionIssued a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "When the edition read was released, which is not when the work was published.".
fw:editionPublisher a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Who released the edition read, where that is not the work's own publisher -- a transcription, a reprint, a digitisation.".

fw:matchedRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:outsideRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:multipleMembershipCount a owl:DatatypeProperty; rdfs:range xsd:integer.

fw:CanvasNodePlan a owl:Class; rdfs:subClassOf prov:Plan; rdfs:label "Canvas node plan"; rdfs:comment "Editable, possibly incomplete configuration. Does not assert that execution or scientific validation occurred.".
fw:CanvasConnection a owl:Class;
  rdfs:comment "A declared link between two canvas node plans on an input port. Endpoint existence is checked; compatible port types and executability are application checks."; rdfs:label "Canvas connection".
fw:configuration a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:comment "JSON configuration snapshot; operation-specific configuration checks remain application checks.".
fw:fromPlan a owl:ObjectProperty; rdfs:range fw:CanvasNodePlan.
fw:toPlan a owl:ObjectProperty; rdfs:range fw:CanvasNodePlan.
fw:inputPort a owl:DatatypeProperty; rdfs:range xsd:string.
fw:selectionMode a owl:ObjectProperty; rdfs:comment "Boundary drawing method, not a CRS or a geometry type.".
fw:geometryValidated a owl:DatatypeProperty; rdfs:range xsd:boolean; rdfs:comment "Passed the widget's bounded geometry checks; not general topological certification.".
fw:geometryAsPublished a owl:DatatypeProperty; rdfs:range xsd:boolean; rdfs:comment "True when the geometry is byte-for-byte what the cited source published; false when it was edited in this workflow, so the source is what it derives from and not the author of this shape.".
fw:west a owl:DatatypeProperty; rdfs:comment "Western longitude of the CRS84 bounding envelope in degrees.".
fw:east a owl:DatatypeProperty; rdfs:comment "Eastern longitude of the CRS84 bounding envelope in degrees.".
fw:south a owl:DatatypeProperty; rdfs:comment "Southern latitude of the CRS84 bounding envelope in degrees.".
fw:north a owl:DatatypeProperty; rdfs:comment "Northern latitude of the CRS84 bounding envelope in degrees.".
fw:readyForSpatialAnalysis a owl:DatatypeProperty; rdfs:range xsd:boolean; rdfs:comment "Conclusion of the bounded study-area readiness rule, not scientific fitness certification.".

# A draft plan, an observed plan and a widget definition are different kinds of thing. Asserted
# here rather than in the core vocabulary so this file carries the constraints on its own
# classes; the urn: ontology IRIs do not resolve, so owl:imports is not available.
fw:CanvasNodePlan owl:disjointWith fw:WorkflowNodePlan.
fw:WidgetDefinition owl:disjointWith fw:CanvasNodePlan, fw:WorkflowNodePlan.
fw:CaseSeries a owl:Class;
  rdfs:label "Case series"; rdfs:subClassOf prov:Entity;
  rdfs:comment "Counts of cases per period, by one declared kind of date. A series states what it is a series of: a curve by date of death is not a curve by date of onset, and the two are not interchangeable. Periods with no cases are retained, because a gap is a fact about the outbreak rather than an absence of data to be compressed away.".
fw:CaseSeriesComputation a owl:Class;
  rdfs:label "Case series computation"; rdfs:subClassOf prov:Activity;
  rdfs:comment "Counts input records into periods, optionally weighted by a declared attribute where one record stands for several cases. Records without a parseable ISO 8601 date are excluded and counted, never redistributed across periods.".
fw:SeriesBin a owl:Class;
  rdfs:label "Series bin"; rdfs:subClassOf prov:Entity;
  rdfs:comment "One period of a case series and its count. The count is a number of cases, which equals the number of records only when each record stands for one case.".
fw:eventDateField a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The input attribute read as the event date. Nothing is inferred from a column name.".
fw:eventDateKind a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "Which date this is: onset, report, death, specimen-collection or other. Required, because series of different kinds must never be merged or compared as though they were the same quantity.".
fw:seriesPeriod a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "Series period".
fw:caseWeightField a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "The attribute holding how many cases a record stands for. Absent means one case per record, which is a claim about the data and not a default to be assumed quietly.".
fw:seriesTotal a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:SatelliteCatalogSearch a owl:Class; rdfs:subClassOf prov:Entity;
  rdfs:label "Satellite catalog search";
  rdfs:comment "A STAC search for a chosen product over a study area's extent and a date range: catalog records only, no file read. So how many pixels a file holds over the area, and of what quality, is not known from it: fw:completenessRead false says so. Adapted from JLT's STAC Browser. Experiment 179.".
fw:searchBBox a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:string; rdfs:label "search bounding box";
  rdfs:comment "West, south, east, north, in degrees: the study area's extent, which is what a catalog search can take.".
fw:searchAreaFrom a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:string; rdfs:label "search area from";
  rdfs:comment "Where the searched extent came from: \"study area\", a connected Study area's extent, or \"typed extent\", four edges typed in the dialog. Absent on searches saved before 0.28.1, which could only come from a Study area.".
fw:searchFrom a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:date; rdfs:label "search from".
fw:searchUntil a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:date; rdfs:label "search until".
fw:itemsReturned a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:integer; rdfs:label "items returned";
  rdfs:comment "Items the catalog returned for the area and dates, before keeping only the chosen product.".
fw:itemsMatched a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:integer; rdfs:label "items matched".
fw:itemsKept a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:integer; rdfs:label "items kept".
fw:searchTruncated a owl:DatatypeProperty; rdfs:domain fw:SatelliteCatalogSearch; rdfs:range xsd:boolean; rdfs:label "search truncated";
  rdfs:comment "True when the search stopped at its item limit with more to read.".
fw:completenessRead a owl:DatatypeProperty; rdfs:range xsd:boolean; rdfs:label "completeness read";
  rdfs:comment "Whether pixels were read to count coverage and quality. A search reads none, so this is false: absence of an overpass is known, absence of a retrieval or of quality is not. A satellite point sample reads them, so it is true there. No domain since 0.29.0, when the sample began to state it.".
fw:SatelliteAreaSample a owl:Class; rdfs:subClassOf prov:Entity; rdfs:label "satellite area sample";
  rdfs:comment "A gridded satellite product read over areas, or at points as the cell containing each: one row per place per period per platform, with the cells counted, the quality rule stated and nothing filled. Experiment 180.".
fw:cellConvention a owl:DatatypeProperty; rdfs:domain fw:SatelliteAreaSample; rdfs:range xsd:string; rdfs:label "cell convention";
  rdfs:comment "Which cells of a grid a place is read from: those whose centre is inside or on an area, or the one containing a point.".
fw:qualityRule a owl:DatatypeProperty; rdfs:domain fw:SatelliteAreaSample; rdfs:range xsd:string; rdfs:label "quality rule";
  rdfs:comment "The rule a cell's quality bits passed, in words naming the bits read; a product that documents bits and no rule gets a rule the practitioner chose.".
fw:unitAsStated a owl:DatatypeProperty; rdfs:domain fw:SatelliteAreaSample; rdfs:range xsd:string; rdfs:label "unit as stated";
  rdfs:comment "The unit the file states, where the result is reported in another: MODIS states kelvin.".
fw:unitConversion a owl:DatatypeProperty; rdfs:domain fw:SatelliteAreaSample; rdfs:range xsd:string; rdfs:label "unit conversion";
  rdfs:comment "The conversion applied, in words: degrees Celsius = kelvin - 273.15. Exact; nothing else changed.".
fw:placesSampled a owl:DatatypeProperty; rdfs:domain fw:SatelliteAreaSample; rdfs:range xsd:integer; rdfs:label "places sampled".
fw:rowsNoCell a owl:DatatypeProperty; rdfs:domain fw:SatelliteAreaSample; rdfs:range xsd:integer; rdfs:label "rows with no cell";
  rdfs:comment "Rows for a place no cell centre of the file falls in: a gap of its own, not a missing reading.".
fw:SatellitePointSample a owl:Class; rdfs:subClassOf prov:Entity; rdfs:label "satellite point sample";
  rdfs:comment "Values read from satellite files at points, one per point per overpass, with the quality rule applied and each gap named. Sample satellite files at points. Experiment 179.".
# SHARED BY BOTH SAMPLES, so no domain: an area sample stating its files read is not thereby a point sample (2026-11-06).
fw:sampledRoute a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "sampled route".
fw:sampledVariable a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "sampled variable";
  rdfs:comment "The variable's path in the file, as the file spells it.".
fw:satelliteValueUnit a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "satellite value unit";
  rdfs:comment "The unit as the file's own units attribute states it.".
fw:pixelConvention a owl:DatatypeProperty; rdfs:domain fw:SatellitePointSample; rdfs:range xsd:string; rdfs:label "pixel convention".
fw:qualityVariable a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "quality variable".
fw:qualityThreshold a owl:DatatypeProperty; rdfs:domain fw:SatellitePointSample; rdfs:range xsd:decimal; rdfs:label "quality threshold".
fw:qualityOperator a owl:DatatypeProperty; rdfs:domain fw:SatellitePointSample; rdfs:range xsd:string; rdfs:label "quality operator";
  rdfs:comment "\">=\" or \">\": the product's documents differ, and only at exactly the threshold, so which was applied is stated.".
fw:filesRead a owl:DatatypeProperty; rdfs:range xsd:integer; rdfs:label "files read".
fw:pointsSampled a owl:DatatypeProperty; rdfs:domain fw:SatellitePointSample; rdfs:range xsd:integer; rdfs:label "points sampled".
fw:rowsWritten a owl:DatatypeProperty; rdfs:range xsd:integer; rdfs:label "rows written".
fw:rowsPassing a owl:DatatypeProperty; rdfs:range xsd:integer; rdfs:label "rows passing".
fw:rowsBelowQuality a owl:DatatypeProperty; rdfs:range xsd:integer; rdfs:label "rows below quality".
fw:rowsNoRetrieval a owl:DatatypeProperty; rdfs:range xsd:integer; rdfs:label "rows with no retrieval".
fw:rowsNoOverpass a owl:DatatypeProperty; rdfs:domain fw:SatellitePointSample; rdfs:range xsd:integer; rdfs:label "rows with no overpass".
fw:imputed a owl:DatatypeProperty; rdfs:range xsd:boolean; rdfs:label "imputed";
  rdfs:comment "Whether any value was filled. A reader never fills: imputation is a declared step of its own (experiment 179, provisional statement 2).".
fw:SatelliteProductChoice a owl:Class; rdfs:subClassOf prov:Entity;
  rdfs:label "Satellite product choice";
  rdfs:comment "Which satellite product a practitioner chose for a research topic, and what was and was not read about it. A choice, not data: nothing is downloaded by the step that makes it. Routes are curated in JLT's EO Satellite Guide (eo:STACCollection in its vocabulary, vendored in examples/eo) and in Fieldwork's additions. Experiment 179.".
fw:researchTopic a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "research topic".
fw:satelliteRoute a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "satellite route".
fw:stacCatalog a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "STAC catalog".
fw:stacCollection a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "STAC collection".
fw:productType a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "product type";
  rdfs:comment "Where one collection holds several products, which one: Sentinel-5P's L2__NO2___ beside L2__O3____.".
fw:measuredQuantity a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "measured quantity";
  rdfs:comment "column, optical-depth, index or surface; unread where nobody has read it. A satellite column, an optical depth and a surface concentration are different quantities, and a ground monitor measures the last.".
fw:observationKind a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "observation kind";
  rdfs:comment "observation or model. A gap-filled product or a reanalysis is a model, never an observation.".
fw:signIn a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "sign-in";
  rdfs:comment "none, anonymous-token or account; unread where nobody has checked.".
fw:licenceRead a owl:ObjectProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:label "licence read";
  rdfs:comment "The licence as read from the licence itself, with where and when. A catalog's licence field is not enough: Sentinel-5P's says proprietary and links a dead host, while the notice grants free, full and open access.".
fw:licenceName a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "licence name".
fw:licenceReadAt a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "licence read at".
fw:licenceReadOn a owl:DatatypeProperty; rdfs:range xsd:date; rdfs:label "licence read on".
fw:licenceOpen a owl:DatatypeProperty; rdfs:range xsd:boolean; rdfs:label "licence open".
fw:licenceUnread a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:boolean; rdfs:label "licence unread";
  rdfs:comment "Nobody has read this route's licence. Said, so an unread licence is not read as an open one.".
fw:citationRead a owl:ObjectProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:label "citation read";
  rdfs:comment "The dataset citation as the producer asks for it, read from the producer's own page with where and when, and which files it covers: a DOI is per processor version. Planetary Computer's collection record carries none.".
fw:citationText a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "citation text".
fw:citationDoi a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "citation DOI".
fw:citationAppliesTo a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "citation applies to";
  rdfs:comment "Which files the citation covers, such as processor 2.x.".
fw:citationReadAt a owl:DatatypeProperty; rdfs:range xsd:string; rdfs:label "citation read at".
fw:citationReadOn a owl:DatatypeProperty; rdfs:range xsd:date; rdfs:label "citation read on".
fw:citationUnread a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:boolean; rdfs:label "citation unread";
  rdfs:comment "Nobody has read this route's dataset citation. Said, so a missing reference is visible rather than silent.".
fw:curatedBy a owl:DatatypeProperty; rdfs:domain fw:SatelliteProductChoice; rdfs:range xsd:string; rdfs:label "curated by";
  rdfs:comment "eo-satellite-guide or fieldwork: whose curated list the route came from.".
fw:PointsFromTable a owl:Class; rdfs:subClassOf prov:Entity;
  rdfs:label "Points read from a table";
  rdfs:comment "Point data read at run time from a table a workflow computed, one point per row from the row's x (longitude) and y (latitude) columns, in CRS84: geopandas' points_from_xy. A row whose coordinates are empty, not numbers or out of range is kept with no geometry and counted, never a refusal of the table. Experiment 178.".
fw:xAttribute a owl:DatatypeProperty; rdfs:domain fw:PointsFromTable; rdfs:range xsd:string;
  rdfs:label "x attribute"; rdfs:comment "The column read as x, the longitude. Named by the practitioner, never inferred from a column name.".
fw:yAttribute a owl:DatatypeProperty; rdfs:domain fw:PointsFromTable; rdfs:range xsd:string;
  rdfs:label "y attribute"; rdfs:comment "The column read as y, the latitude.".
fw:placedRecordCount a owl:DatatypeProperty; rdfs:domain fw:PointsFromTable; rdfs:range xsd:integer;
  rdfs:label "placed record count".
fw:unplacedRecordCount a owl:DatatypeProperty; rdfs:domain fw:PointsFromTable; rdfs:range xsd:integer;
  rdfs:label "unplaced record count"; rdfs:comment "Rows kept with no geometry because a coordinate was empty, not a number, or outside the longitude and latitude range.".
fw:distinctPositionCount a owl:DatatypeProperty; rdfs:domain fw:PointsFromTable; rdfs:range xsd:integer;
  rdfs:label "distinct position count"; rdfs:comment "How many different positions the placed rows hold. Fewer than the rows placed means rows share a position: on a table of one row per site and day, the sign it needs totalling to one row per site first.".
fw:datedRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:undatedRecordCount a owl:DatatypeProperty; rdfs:range xsd:integer;
  rdfs:comment "Records excluded for want of a usable date. Reported rather than silently dropped: a curve computed from fewer records than were supplied is a different curve.".
fw:seriesBin a owl:ObjectProperty; rdfs:domain fw:CaseSeries; rdfs:range fw:SeriesBin.
fw:periodKey a owl:DatatypeProperty; rdfs:domain fw:SeriesBin; rdfs:range xsd:string.
fw:caseCount a owl:DatatypeProperty; rdfs:domain fw:SeriesBin; rdfs:range xsd:decimal.
fw:RateComputation a owl:Class;
  rdfs:label "Rate computation"; rdfs:subClassOf prov:Activity;
  rdfs:comment "Divides counted events by a declared population at risk. The denominator's unit is part of the result, not a presentation detail: deaths per house is not a mortality rate, and a rate whose denominator is unstated cannot be compared with any other rate.".
fw:RateResult a owl:Class;
  rdfs:label "Rate result"; rdfs:subClassOf prov:Entity;
  rdfs:comment "Rates by group, each carrying its own numerator and denominator so a reader can see what was divided by what. Groups whose denominator is below the stated minimum report no rate rather than an unstable one.".
fw:RateGroup a owl:Class;
  rdfs:label "Rate group"; rdfs:subClassOf prov:Entity;
  rdfs:comment "One group's numerator, denominator and rate. A group with no rate is reported with its counts, because suppressing the rate is a decision the reader must be able to see.".
fw:RateRatioComputation a owl:Class;
  rdfs:label "Rate ratio computation"; rdfs:subClassOf prov:Activity;
  owl:deprecated true; dcterms:isReplacedBy fw:TwoByTwo; fw:implementationStatus "retired";
  skos:changeNote "Retired 2026-11-05 with the Rate ratio widget. The rate ratio is computed by the two-by-two's rate layout, which reads events and units at risk from a table.";
  rdfs:comment "Divides one group's rate by another's. Both rates must be per the same thing: a per-house rate over a per-person rate is arithmetic on two different quantities. A group with no events is refused rather than given an undefined interval, because adding half an event to make one is an assumption and not a measurement.".
fw:RateRatio a owl:Class;
  rdfs:label "Rate ratio"; rdfs:subClassOf prov:Entity;
  owl:deprecated true; dcterms:isReplacedBy fw:TwoByTwo; fw:implementationStatus "retired";
  skos:changeNote "Retired 2026-11-05 with the Rate ratio widget. A rate ratio is now an fw:EpiEstimate on an fw:TwoByTwo whose cells are events and units at risk.";
  rdfs:comment "A ratio of two rates, with an interval, carrying both counts and both denominators so a reader can see what was compared. It is dimensionless: the multiplier the rates were reported with cancels, and there is deliberately no multiplier on this entity. The interval states its level and method; it is not a p-value, and the ratio is a contrast between two populations rather than a measured effect.".
fw:comparedGroup a owl:DatatypeProperty; rdfs:label "compared group";
  rdfs:domain fw:RateRatio; rdfs:comment "The group whose rate is the numerator -- the one a claim is being made about. Not named for exposure: an exposure is one use of a rate ratio, and two districts or two periods compared with each other are not one.".
fw:referenceGroup a owl:DatatypeProperty; rdfs:label "reference group";
  rdfs:domain fw:RateRatio; rdfs:comment "The group compared to. Naming it is not optional: a ratio and its reciprocal are the same finding and not the same sentence.".
fw:comparedEventCount a owl:DatatypeProperty; rdfs:label "compared event count"; rdfs:domain fw:RateRatio.
fw:comparedUnitsAtRisk a owl:DatatypeProperty; rdfs:label "compared units at risk"; rdfs:domain fw:RateRatio.
fw:referenceEventCount a owl:DatatypeProperty; rdfs:label "reference event count"; rdfs:domain fw:RateRatio.
fw:referenceUnitsAtRisk a owl:DatatypeProperty; rdfs:label "reference units at risk"; rdfs:domain fw:RateRatio.
fw:ratioValue a owl:DatatypeProperty; rdfs:label "ratio value"; rdfs:domain fw:RateRatio.
fw:intervalLower a owl:DatatypeProperty; rdfs:label "interval lower bound"; rdfs:domain [ owl:unionOf ( fw:RateRatio fw:EpiEstimate ) ].
fw:intervalUpper a owl:DatatypeProperty; rdfs:label "interval upper bound"; rdfs:domain [ owl:unionOf ( fw:RateRatio fw:EpiEstimate ) ].
fw:intervalLevel a owl:DatatypeProperty; rdfs:label "interval level";
  rdfs:domain [ owl:unionOf ( fw:RateRatio fw:EpiEstimate ) ]; rdfs:comment "As a percentage. A 90% interval and a 95% interval are different claims, so the level is carried rather than assumed.".
fw:intervalMethod a owl:DatatypeProperty; rdfs:label "interval method";
  rdfs:domain [ owl:unionOf ( fw:RateRatio fw:EpiEstimate ) ]; rdfs:comment "Named so a reader is never left guessing which interval they are looking at.".
fw:numeratorField a owl:DatatypeProperty; rdfs:range xsd:string.
fw:denominatorField a owl:DatatypeProperty; rdfs:range xsd:string.
fw:denominatorUnit a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "What the denominator counts: people, houses, households, person-time or other. Required, because a number per house and a number per person are different quantities that look identical once printed.".
fw:rateKind a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "A proportion, whose numerator is part of its denominator and so cannot exceed it, or a ratio of events per unit, which can. Snow's data yields both and they are not interchangeable.".
fw:rateMultiplier a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:minimumDenominator a owl:DatatypeProperty; rdfs:range xsd:decimal.
fw:numeratorPeriod a owl:DatatypeProperty; rdfs:range xsd:string.
fw:denominatorVintage a owl:DatatypeProperty; rdfs:range xsd:string;
  rdfs:comment "When the population at risk was counted. Recorded beside the numerator's period so a reader can see whether the two describe the same moment; they often do not.".
fw:vintagesAgree a owl:DatatypeProperty; rdfs:range xsd:boolean.
fw:suppressedGroupCount a owl:DatatypeProperty; rdfs:range xsd:integer.
fw:rateGroup a owl:ObjectProperty; rdfs:domain fw:RateResult; rdfs:range fw:RateGroup.
fw:groupLabel a owl:DatatypeProperty; rdfs:domain fw:RateGroup; rdfs:range xsd:string.
fw:numeratorCount a owl:DatatypeProperty; rdfs:domain fw:RateGroup; rdfs:range xsd:decimal.
fw:denominatorCount a owl:DatatypeProperty; rdfs:domain fw:RateGroup; rdfs:range xsd:decimal.
fw:rateValue a owl:DatatypeProperty; rdfs:domain fw:RateGroup; rdfs:range xsd:decimal.
fw:RateResult owl:disjointWith fw:PointDataset, fw:CaseSeries.

fw:CaseSeries owl:disjointWith fw:PointDataset.

fw:PackCatalog owl:disjointWith fw:WidgetDefinition, fw:WorkflowNodePlan, fw:CanvasNodePlan.

# The epi kernel's two-by-two, 2026-10-26. Patterned after Epi Info's TABLES output and
# deliberately not claiming agreement with it: every estimate names the method that produced it,
# and `fw:epiInfoLabelStatus` records that nobody has verified what Epi Info displays for the
# same quantity. See docs/directions.json, recognisable-not-identical-an-epi-kernel-of-our-own.
fw:StudyDesign a owl:Class;
  rdfs:label "Study design"; rdfs:subClassOf prov:Entity;
  rdfs:comment "What kind of study a workflow is, DECLARED by a practitioner and never inferred from data. A design is not a property of a table: the same four counts arise from a cohort, a case-control study and a cross-sectional survey, and which measures are estimable differs in each, so nothing here reads a design off the numbers. Six are admitted, each one reachable with the computations this application has; a seventh that licenses nothing would be a declaration doing no work. What a design licenses is carried on this entity rather than left to a reader, because the refusal it causes downstream has to be explainable.".
fw:studyDesignKind a owl:DatatypeProperty; rdfs:label "study design kind";
  rdfs:domain fw:StudyDesign; rdfs:range xsd:string;
  rdfs:comment "One of cohort, case-control, cross-sectional, ecological or case-series. A closed set: an open one would let a workflow declare a design that gates nothing, which is indistinguishable from declaring none.".
fw:studyPeriod a owl:DatatypeProperty; rdfs:label "study period";
  rdfs:domain fw:StudyDesign; rdfs:range xsd:string;
  rdfs:comment "When the study ran, as a practitioner writes it for a reader -- 1854, or July-September 1854. A property of the STUDY and not of any one computation, which is why it is here rather than beside a numerator or a denominator vintage. Free text, so it can fill a title's time element; checking that a denominator period COVERS a numerator period needs a structured period and is not built, and the check `rate` performs today is string equality where the condition is coverage.".
fw:unitOfAnalysis a owl:DatatypeProperty; rdfs:label "unit of analysis";
  rdfs:domain fw:StudyDesign; rdfs:range xsd:string;
  rdfs:comment "What one row counts. An ecological design counts groups and not people, and a relation between group-level measures need not hold between individuals -- the inference this property exists to make visible on the result rather than in a textbook.".
fw:licensedEstimate a owl:DatatypeProperty; rdfs:label "licensed estimate";
  rdfs:domain fw:StudyDesign; rdfs:range xsd:string;
  rdfs:comment "An estimate this design can support, by the name this application gives it. Written once per permitted estimate, and written NOT AT ALL where a design permits none -- a case series has no comparison group, and a receipt omitting the property is then saying so rather than predating it. In a case-control design only the odds ratio appears, because the row totals are artefacts of how many cases and controls were sampled.".
fw:withheldEstimate a owl:DatatypeProperty; rdfs:label "withheld estimate";
  rdfs:range xsd:string;
  rdfs:comment "A measure the declared design licenses and the practitioner chose not to report. Written so that a measure left out on purpose can be told from one nobody ran." .
fw:designStopped a owl:DatatypeProperty; rdfs:label "design stopped";
  rdfs:domain fw:StudyDesign; rdfs:range xsd:boolean;
  rdfs:comment "Investigators allocated exposure, so no study design is declared: the five designs are observational." .
fw:refinementAnswer a owl:DatatypeProperty; rdfs:label "refinement answer";
  rdfs:domain fw:StudyDesign; rdfs:range xsd:string;
  rdfs:comment "The option chosen for one stage 2 question, by its identifier. A claim by the practitioner, which the application records and cannot check." .
fw:noDesignDeclared a owl:DatatypeProperty; rdfs:label "no design declared";
  rdfs:domain [ owl:unionOf ( fw:TwoByTwo fw:RegressionModel ) ];
  rdfs:comment "No study design was connected to this two-by-two, so its measures carry neutral names." ;
  rdfs:range xsd:boolean .
fw:notEstimable a owl:DatatypeProperty; rdfs:label "not estimable";
  rdfs:domain fw:TwoByTwo; rdfs:range xsd:string;
  rdfs:comment "A measure the declared design cannot support, as distinct from one the practitioner withheld. Under case-control sampling the risk ratio and the risk difference are not estimable." .
fw:TwoByTwo a owl:Class;
  rdfs:label "Two-by-two table"; rdfs:subClassOf prov:Entity;
  rdfs:comment "Four counts -- two groups by two outcomes -- and the estimates computed from them. The two groups are NAMED rather than taken as the first two values present, because a table may hold more: Snow's people-denominated table has three water supply strata, 16 of 32 sub-districts having been supplied by both companies. Any stratum left out is carried on this entity, since a stratum silently excluded from a comparison is the commonest way a two-by-two misleads. A contrast between two groups as they were supplied, not a measured effect: nothing adjusts for anything the two groups did not share.".
# Regression, 2026-11-04 (experiment 176). The fit a Regression step made, described so the N3 & evidence view shows
# it as it shows a two-by-two. Its coefficients are fw:EpiEstimate, the same class as the two-by-two's estimates, and
# fw:estimate, fw:exposureAttribute and fw:outcomeAttribute are shared by widening their domains to either class.
fw:RegressionModel a owl:Class;
  rdfs:label "Regression model"; rdfs:subClassOf prov:Entity;
  rdfs:comment "A logistic or Poisson regression of an outcome column on an exposure column, adjusted for other columns, as fitted by a Regression step: the family, each term and how it entered the model, strata, an offset, how the intervals were made, and the rows used. An adjusted ratio is only as meaningful as what it is adjusted for, so every adjustment is stated. Under a declared study design the measure carries the name the design licenses; with none declared it keeps its neutral name, and fw:noDesignDeclared says so.".
fw:modelFamily a owl:DatatypeProperty; rdfs:label "model family";
  rdfs:domain fw:RegressionModel; rdfs:range xsd:string;
  rdfs:comment "logistic or poisson. A logistic model estimates odds ratios, a Poisson model rate ratios.".
fw:exposureTerm a owl:ObjectProperty; rdfs:label "exposure term"; rdfs:domain fw:RegressionModel;
  rdfs:comment "The exposure as it entered the model: its column, and whether as a number, as categories against a reference, or as a spline.".
fw:adjustmentTerm a owl:ObjectProperty; rdfs:label "adjustment term"; rdfs:domain fw:RegressionModel;
  rdfs:comment "One column the estimate is adjusted for, and how it entered the model.".
fw:termAttribute a owl:DatatypeProperty; rdfs:label "term attribute"; rdfs:range xsd:string.
fw:termEntry a owl:DatatypeProperty; rdfs:label "term entry"; rdfs:range xsd:string;
  rdfs:comment "numeric, categorical or spline. The same column entered two ways is two different models.".
fw:termReference a owl:DatatypeProperty; rdfs:label "term reference"; rdfs:range xsd:string;
  rdfs:comment "For a categorical term, the category every other is compared with.".
fw:termDegreesOfFreedom a owl:DatatypeProperty; rdfs:label "term degrees of freedom"; rdfs:range xsd:integer;
  rdfs:comment "For a spline term, how many columns it was given.".
fw:stratumAttribute a owl:DatatypeProperty; rdfs:label "stratum attribute"; rdfs:domain fw:RegressionModel; rdfs:range xsd:string;
  rdfs:comment "The column whose values are strata, absorbed by the conditional Poisson likelihood rather than estimated.".
fw:offsetAttribute a owl:DatatypeProperty; rdfs:label "offset attribute"; rdfs:domain fw:RegressionModel; rdfs:range xsd:string;
  rdfs:comment "The column holding the log of person-time or population, for a Poisson rate.".
fw:errorMethod a owl:DatatypeProperty; rdfs:label "error method"; rdfs:domain fw:RegressionModel; rdfs:range xsd:string;
  rdfs:comment "How the standard errors and intervals were made: model-based (Wald), likelihood-ratio (profile), scaled by the Pearson dispersion, or HAC (Newey-West) with its lag.".
fw:usedRecordCount a owl:DatatypeProperty; rdfs:label "used record count"; rdfs:domain fw:RegressionModel; rdfs:range xsd:integer.
fw:leftOutRecordCount a owl:DatatypeProperty; rdfs:label "left-out record count"; rdfs:domain fw:RegressionModel; rdfs:range xsd:integer;
  rdfs:comment "Rows not in the fit. The step states why each was left out; a control group not chosen is not a missing value.".
fw:usedStratumCount a owl:DatatypeProperty; rdfs:label "used stratum count"; rdfs:domain fw:RegressionModel; rdfs:range xsd:integer.
fw:droppedStratumCount a owl:DatatypeProperty; rdfs:label "dropped stratum count"; rdfs:domain fw:RegressionModel; rdfs:range xsd:integer;
  rdfs:comment "Strata with no events, which carry no information in a conditional Poisson model.".
fw:iterationCount a owl:DatatypeProperty; rdfs:label "iteration count"; rdfs:domain fw:RegressionModel; rdfs:range xsd:integer.
fw:modelTerm a owl:DatatypeProperty; rdfs:label "model term"; rdfs:domain fw:EpiEstimate; rdfs:range xsd:string;
  rdfs:comment "Which coefficient of a regression this estimate is, in R's naming: o3_lag02_10, or age_group7 70+ against the reference.".
fw:EpiEstimate a owl:Class;
  rdfs:label "Epidemiological estimate"; rdfs:subClassOf prov:Entity;
  rdfs:comment "One estimate with its interval, its level and the method that produced it. Carried even when it has no value: a zero cell removes an odds ratio and leaves a risk difference perfectly well defined, so an estimate states why it is unavailable rather than being omitted, which a reader cannot tell from an estimate nobody computed.".
fw:exposureAttribute a owl:DatatypeProperty; rdfs:label "exposure attribute";
  rdfs:domain [ owl:unionOf ( fw:TwoByTwo fw:RegressionModel ) ]; rdfs:comment "The column the exposure was read from. Declared, never inferred from a column name.".
fw:outcomeAttribute a owl:DatatypeProperty; rdfs:label "outcome attribute";
  rdfs:domain [ owl:unionOf ( fw:TwoByTwo fw:RegressionModel ) ].
fw:exposedGroup a owl:DatatypeProperty; rdfs:label "exposed group"; rdfs:domain fw:TwoByTwo.
fw:unexposedGroup a owl:DatatypeProperty; rdfs:label "unexposed group"; rdfs:domain fw:TwoByTwo.
fw:caseValue a owl:DatatypeProperty; rdfs:label "case value";
  rdfs:domain fw:TwoByTwo; rdfs:comment "Which value of the outcome column counts as a case. A two-by-two with the outcome the other way round is a different table and not a relabelled one.".
fw:exposedCaseCount a owl:DatatypeProperty; rdfs:label "exposed case count"; rdfs:domain fw:TwoByTwo.
fw:exposedNonCaseCount a owl:DatatypeProperty; rdfs:label "exposed non-case count"; rdfs:domain fw:TwoByTwo.
fw:unexposedCaseCount a owl:DatatypeProperty; rdfs:label "unexposed case count"; rdfs:domain fw:TwoByTwo.
fw:unexposedNonCaseCount a owl:DatatypeProperty; rdfs:label "unexposed non-case count"; rdfs:domain fw:TwoByTwo.
fw:unitsAtRiskValue a owl:DatatypeProperty; rdfs:label "units at risk value"; rdfs:range xsd:string;
  rdfs:domain fw:TwoByTwo; rdfs:comment "The value of the outcome column holding the units at risk, in a two-by-two read as events and units at risk rather than cases and non-cases. Its presence is what says the table is of rates: a denominator is not a non-case count, because a unit can hold more than one event and person-time counts nobody.".
fw:exposedUnitsAtRisk a owl:DatatypeProperty; rdfs:label "exposed units at risk"; rdfs:domain fw:TwoByTwo; rdfs:range xsd:double.
fw:unexposedUnitsAtRisk a owl:DatatypeProperty; rdfs:label "unexposed units at risk"; rdfs:domain fw:TwoByTwo; rdfs:range xsd:double.
fw:subjectCount a owl:DatatypeProperty; rdfs:label "subject count";
  rdfs:domain fw:TwoByTwo; rdfs:comment "The subjects in the two named groups, which is NOT the size of the table when a stratum was left out.".
fw:stratumLeftOut a owl:DatatypeProperty; rdfs:label "stratum left out";
  rdfs:domain fw:TwoByTwo; rdfs:comment "A value of the exposure column that this comparison did not name. Those subjects are in neither group; they are excluded, not controlled for.".
fw:estimate a owl:ObjectProperty; rdfs:label "estimate";
  rdfs:domain [ owl:unionOf ( fw:TwoByTwo fw:RegressionModel ) ]; rdfs:range fw:EpiEstimate.
fw:estimateName a owl:DatatypeProperty; rdfs:label "estimate name";
  rdfs:domain fw:EpiEstimate; rdfs:comment "What the estimate is, in this project's words: \"risk ratio\", not \"RR\".".
fw:estimateValue a owl:DatatypeProperty; rdfs:label "estimate value"; rdfs:domain fw:EpiEstimate.
fw:estimateUnavailable a owl:DatatypeProperty; rdfs:label "estimate unavailable";
  rdfs:domain fw:EpiEstimate; rdfs:comment "Why this estimate has no value. Present only when it has none, and never a substitute for a repaired cell: adding half a case to make a ratio computable is an assumption and not a measurement.".
fw:epiInfoLabel a owl:DatatypeProperty; rdfs:label "Epi Info label";
  rdfs:domain fw:EpiEstimate; rdfs:comment "What Epi Info displays for the same quantity, where somebody has verified it. SEPARATE from the method name on purpose, because the two can disagree: epi-info-ai's method contract records that its legacy Breslow-Day odds ratio ports a Woolf weighted log-odds dispersion which the legacy output labels \"Breslow-Day test for Odds\". One label field would force a choice between being correct and being recognisable.".
fw:epiInfoLabelStatus a owl:DatatypeProperty; rdfs:label "Epi Info label status";
  rdfs:domain fw:EpiEstimate; rdfs:comment "\"deduced\" when the label was read from a rendering of Epi Info rather than from Epi Info, \"verified\" when read from Epi Info itself, and \"unread\" when no source has been read at all. Written rather than omitted, so a receipt states which of the three it is instead of being silent about a field this project requires.".
fw:epiInfoLabelSource a owl:DatatypeProperty; rdfs:label "Epi Info label source";
  rdfs:domain fw:EpiEstimate; rdfs:comment "Where the label was read. \"epi-info-ai-results-panel\" is the classic TABLES estimate table in epi-info-ai/wasm/demo/app.ts, a sibling project whose epi kernel was synthesized from Epi Info -- a good deduction and not a verification. Carried BESIDE the label because a deduced label and a verified one are different claims, and conflating them is the same class of error as the Breslow-Day mislabelling that fw:epiInfoLabel exists to survive.".
