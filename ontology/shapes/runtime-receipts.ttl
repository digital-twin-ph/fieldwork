@prefix fw: <urn:fieldwork:>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix geo: <http://www.opengis.net/ont/geosparql#>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

# Runtime evidence profile, not widget configuration shapes or a geometry verifier.
fw:RuntimePlanShape a sh:NodeShape; sh:targetClass fw:WorkflowNodePlan, fw:CanvasNodePlan;
  sh:property [ sh:path fw:widget; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI; sh:class fw:WidgetDefinition ];
  sh:property [ sh:path fw:nodeType; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path fw:catalogVersion; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9]+[.][0-9]+[.][0-9]+$" ];
  sh:property [ sh:path fw:catalogDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^[a-f0-9]{64}$" ];
  sh:property [ sh:path fw:widgetDefinitionSource; sh:minCount 1; sh:maxCount 1; sh:in ( "host-registry" "pack" ) ].
fw:CaseSeriesShape a sh:NodeShape; sh:targetClass fw:CaseSeries;
  sh:property [ sh:path fw:eventDateKind; sh:minCount 1; sh:maxCount 1;
                sh:in ( "onset" "report" "death" "specimen-collection" "other" ) ];
  sh:property [ sh:path fw:seriesPeriod; sh:minCount 1; sh:maxCount 1; sh:in ( "day" "week" "month" ) ];
  sh:property [ sh:path fw:seriesTotal; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0 ];
  sh:property [ sh:path fw:datedRecordCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer ];
  sh:property [ sh:path fw:undatedRecordCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer ];
  sh:property [ sh:path fw:seriesBin; sh:minCount 1; sh:class fw:SeriesBin ].
fw:SeriesBinShape a sh:NodeShape; sh:targetClass fw:SeriesBin;
  sh:property [ sh:path fw:periodKey; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 4 ];
  sh:property [ sh:path fw:caseCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0 ].
fw:PackCatalogShape a sh:NodeShape; sh:targetClass fw:PackCatalog;
  sh:property [ sh:path fw:packCatalogVersion; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9]+[.][0-9]+[.][0-9]+$" ];
  sh:property [ sh:path fw:packCatalogDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^[a-f0-9]{64}$" ].
fw:RuntimeStepShape a sh:NodeShape; sh:targetClass fw:WorkflowStep;
  sh:property [ sh:path fw:workflowNode; sh:minCount 1; sh:maxCount 1; sh:class fw:WorkflowNodePlan ];
  sh:property [ sh:path fw:resultEntity; sh:minCount 1; sh:maxCount 1; sh:class prov:Entity ];
  sh:property [ sh:path fw:receiptActivity; sh:class prov:Activity; sh:node fw:ReceiptActivityShape ].
fw:ReceiptActivityShape a sh:NodeShape;
  sh:property [ sh:path fw:workflowNode; sh:minCount 1; sh:maxCount 1; sh:class fw:WorkflowNodePlan ].
fw:RuntimeGeometryShape a sh:NodeShape;
  sh:property [ sh:path geo:asWKT; sh:minCount 1; sh:maxCount 1; sh:datatype geo:wktLiteral ].
fw:RuntimeQuantityShape a sh:NodeShape;
  sh:class qudt:QuantityValue;
  sh:property [ sh:path qudt:numericValue; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:Literal; sh:minInclusive 0 ];
  sh:property [ sh:path qudt:unit; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ].
fw:RuntimeMetresShape a sh:NodeShape; sh:node fw:RuntimeQuantityShape;
  sh:property [ sh:path qudt:unit; sh:hasValue <http://qudt.org/vocab/unit/M> ].
fw:RuntimeMinutesShape a sh:NodeShape; sh:node fw:RuntimeQuantityShape;
  sh:property [ sh:path qudt:unit; sh:hasValue <http://qudt.org/vocab/unit/MIN> ];
  sh:property [ sh:path qudt:numericValue; sh:minExclusive 0 ].
fw:StreetNetworkShape a sh:NodeShape; sh:targetClass fw:StreetNetwork;
  sh:property [ sh:path fw:directed; sh:hasValue true; sh:maxCount 1 ];
  sh:property [ sh:path fw:networkNode; sh:minCount 1; sh:class fw:NetworkVertex ];
  sh:property [ sh:path fw:networkEdge; sh:class fw:NetworkEdge ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:NetworkInput ].
fw:NetworkVertexShape a sh:NodeShape; sh:targetClass fw:NetworkVertex;
  sh:property [ sh:path geo:hasGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ].
fw:NetworkEdgeShape a sh:NodeShape; sh:targetClass fw:NetworkEdge;
  sh:property [ sh:path fw:fromVertex; sh:minCount 1; sh:maxCount 1; sh:class fw:NetworkVertex ];
  sh:property [ sh:path fw:toVertex; sh:minCount 1; sh:maxCount 1; sh:class fw:NetworkVertex ];
  sh:property [ sh:path fw:edgeLength; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape;
    sh:node [ sh:property [ sh:path qudt:numericValue; sh:minExclusive 0 ] ] ].
fw:CatchmentDatasetShape a sh:NodeShape; sh:targetClass fw:CatchmentDataset;
  sh:property [ sh:path fw:member; sh:class fw:Catchment ];
  sh:property [ sh:path fw:countSemantics; sh:minCount 1; sh:maxCount 1; sh:in ( "cumulative-threshold-memberships" "all-polygon-memberships" ) ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class prov:Activity ].
fw:CatchmentShape a sh:NodeShape; sh:targetClass fw:Catchment;
  sh:property [ sh:path fw:siteId; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path fw:sourceSite; sh:minCount 1; sh:maxCount 1; sh:class geo:Feature ];
  sh:property [ sh:path geo:hasGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ];
  sh:property [ sh:path fw:travelTime; sh:maxCount 1; sh:node fw:RuntimeMinutesShape ];
  sh:property [ sh:path fw:recordCount; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ].
fw:IsochroneReceiptShape a sh:NodeShape; sh:targetClass fw:NetworkIsochrone;
  sh:property [ sh:path fw:timeBudget; sh:minCount 1; sh:maxCount 6; sh:node fw:RuntimeMinutesShape ];
  sh:property [ sh:path fw:corridorWidth; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ];
  sh:property [ sh:path fw:snapLimit; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ];
  sh:property [ sh:path fw:walkingSpeed; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeQuantityShape;
    sh:node [ sh:property [ sh:path qudt:unit; sh:hasValue <http://qudt.org/vocab/unit/M-PER-SEC> ]; sh:property [ sh:path qudt:numericValue; sh:minExclusive 0 ] ] ];
  sh:property [ sh:path fw:travelDirection; sh:minCount 1; sh:maxCount 1; sh:in ( "inbound" "outbound" ) ];
  sh:property [ sh:path fw:fillInteriorHoles; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:boolean ].
fw:BufferReceiptShape a sh:NodeShape; sh:targetClass fw:AreaBuffer;
  sh:property [ sh:path fw:bufferDistance; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ].
fw:PolygonSummaryReceiptShape a sh:NodeShape; sh:targetClass fw:PolygonPointSummary;
  sh:property [ sh:path fw:boundaryPolicy; sh:minCount 1; sh:maxCount 1; sh:in ( "include" "exclude" ) ];
  sh:property [ sh:path fw:valueField; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ].

fw:CanvasPlanShape a sh:NodeShape; sh:targetClass fw:CanvasNodePlan;
  sh:property [ sh:path fw:configuration; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ].
fw:CanvasConnectionShape a sh:NodeShape; sh:targetClass fw:CanvasConnection;
  sh:property [ sh:path fw:fromPlan; sh:minCount 1; sh:maxCount 1; sh:class fw:CanvasNodePlan ];
  sh:property [ sh:path fw:toPlan; sh:minCount 1; sh:maxCount 1; sh:class fw:CanvasNodePlan ];
  sh:property [ sh:path fw:inputPort; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ].
fw:PointDatasetShape a sh:NodeShape; sh:targetClass fw:PointDataset;
  sh:property [ sh:path fw:recordCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ];
  sh:property [ sh:path fw:member; sh:class geo:Feature ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:PointInput ].
fw:PolygonClipReceiptShape a sh:NodeShape; sh:targetClass fw:PolygonClipping;
  sh:property [ sh:path fw:clipGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ].
fw:RasterReceiptShape a sh:NodeShape; sh:targetClass fw:RasterInputReading, fw:RasterClipping;
  sh:property [ sh:path prov:used; sh:minCount 2; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:rasterMaskMethod; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path fw:rasterMaskConvention; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:in ( "native-window/1" "cell-centre/1" "positive-area/1" ) ];
  sh:property [ sh:path fw:rasterMaskMarginPixels; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0; sh:maxInclusive 1 ].
fw:PresentationReceiptShape a sh:NodeShape; sh:targetClass fw:MapView, fw:TableView, fw:ChartView;
  sh:class prov:Activity;
  sh:property [ sh:path prov:used; sh:minCount 1; sh:nodeKind sh:IRI ].
fw:MapSpecificationShape a sh:NodeShape; sh:targetClass fw:MapSpecification;
  sh:class prov:Plan;
  sh:property [ sh:path dcterms:title; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ];
  sh:property [ sh:path dcterms:description; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path prov:wasDerivedFrom; sh:minCount 1; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:mapLegend; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:boolean ];
  sh:property [ sh:path fw:mapPresentation; sh:minCount 1; sh:maxCount 1; sh:in ("plot" "interactive") ];
  sh:property [ sh:path fw:mapBasemap; sh:minCount 1; sh:maxCount 1; sh:in ("none" "osm" "topo") ];
  sh:property [ sh:path fw:mapSourceNote; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ].
fw:ChartSpecificationShape a sh:NodeShape; sh:targetClass fw:ChartSpecification;
  sh:class prov:Plan;
  sh:property [ sh:path dcterms:title; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ];
  sh:property [ sh:path prov:wasDerivedFrom; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:chartRenderer; sh:minCount 1; sh:maxCount 1; sh:in ("html" "vega-lite") ];
  sh:property [ sh:path fw:chartMark; sh:minCount 1; sh:maxCount 1; sh:in ("bar" "point") ];
  sh:property [ sh:path fw:chartOrientation; sh:minCount 1; sh:maxCount 1; sh:in ("horizontal" "vertical") ];
  sh:property [ sh:path fw:chartField; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ];
  sh:property [ sh:path fw:chartMeasureKind; sh:minCount 1; sh:maxCount 1; sh:in ("record-count" "location-membership-count" "numeric-total") ];
  sh:property [ sh:path fw:chartUnitStatus; sh:minCount 1; sh:maxCount 1; sh:in ("records" "location-memberships" "source-unit-not-specified") ];
  sh:property [ sh:path fw:chartLegend; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:boolean ];
  sh:property [ sh:path fw:chartSourceNote; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ];
  sh:property [ sh:path fw:rendererSpecification; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path fw:chartRendererVersion; sh:maxCount 1; sh:datatype xsd:string ].
fw:ChartViewSpecificationShape a sh:NodeShape; sh:targetClass fw:ChartView;
  sh:property [ sh:path fw:chartSpecification; sh:minCount 1; sh:maxCount 1; sh:node fw:ChartSpecificationShape ].
fw:ReadinessConclusionShape a sh:NodeShape; sh:targetSubjectsOf fw:readyForSpatialAnalysis;
  sh:property [ sh:path fw:readyForSpatialAnalysis; sh:maxCount 1; sh:datatype xsd:boolean ].
fw:AreaMeasurementShape a sh:NodeShape; sh:targetClass fw:AreaMeasurement;
  sh:node fw:RuntimeQuantityShape;
  sh:property [ sh:path qudt:unit; sh:hasValue <http://qudt.org/vocab/unit/M2> ];
  sh:property [ sh:path fw:measuredGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:AreaComputation ].
fw:CoverageReceiptShape a sh:NodeShape; sh:targetClass fw:SpatialCoverageCheck;
  sh:property [ sh:path fw:studyArea; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:inputGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ];
  sh:property [ sh:path fw:checkedRecord; sh:class geo:Feature ].
fw:DonutGeomaskingShape a sh:NodeShape; sh:targetClass fw:DonutGeomasking;
  sh:class prov:Activity;
  sh:property [ sh:path prov:used; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:innerRadius; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ];
  sh:property [ sh:path fw:outerRadius; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ];
  sh:property [ sh:path fw:randomSeed; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ];
  sh:property [ sh:path fw:inputCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
  sh:property [ sh:path fw:outputCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ].
fw:HexAggregationShape a sh:NodeShape; sh:targetClass fw:HexAggregation;
  sh:class prov:Activity;
  sh:property [ sh:path prov:used; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:h3Resolution; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0; sh:maxInclusive 15 ];
  sh:property [ sh:path fw:minimumOccupancy; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 2 ];
  sh:property [ sh:path fw:inputCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
  sh:property [ sh:path fw:outputCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ].
fw:MovedPointDatasetShape a sh:NodeShape; sh:targetClass fw:MovedPointDataset;
  sh:property [ sh:path fw:recordCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
  sh:property [ sh:path fw:member; sh:minCount 1; sh:class fw:MovedPoint ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:DonutGeomasking ].
fw:MovedPointShape a sh:NodeShape; sh:targetClass fw:MovedPoint;
  sh:property [ sh:path geo:hasGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ].
fw:HexCellDatasetShape a sh:NodeShape; sh:targetClass fw:HexCellDataset;
  sh:property [ sh:path fw:recordCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ];
  sh:property [ sh:path fw:member; sh:class fw:HexCell ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:HexAggregation ].
fw:HexCellShape a sh:NodeShape; sh:targetClass fw:HexCell;
  sh:property [ sh:path geo:hasGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ];
  sh:property [ sh:path fw:recordCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 2 ].
fw:MeanCenterComputationShape a sh:NodeShape; sh:targetClass fw:MeanCenterComputation;
  sh:class prov:Activity;
  sh:property [ sh:path prov:used; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:computationCRS; sh:minCount 1; sh:maxCount 1; sh:pattern "^EPSG:32[67][0-9]{2}$" ];
  sh:property [ sh:path fw:inputCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ].
fw:MeanCenterResultShape a sh:NodeShape; sh:targetClass fw:MeanCenterResult;
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:MeanCenterComputation ];
  sh:property [ sh:path geo:hasGeometry; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ].
fw:PointSetComparisonShape a sh:NodeShape; sh:targetClass fw:PointSetComparison;
  sh:class prov:Activity;
  sh:property [ sh:path prov:used; sh:minCount 3; sh:maxCount 5; sh:nodeKind sh:IRI ];
  sh:property [ sh:path fw:computationCRS; sh:minCount 1; sh:maxCount 1; sh:pattern "^EPSG:32[67][0-9]{2}$" ];
  sh:property [ sh:path fw:inputCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
  sh:property [ sh:path fw:referenceCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
  sh:property [ sh:path fw:centerShift; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ];
  sh:property [ sh:path fw:originalNearestPumpDistance; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ];
  sh:property [ sh:path fw:movedNearestPumpDistance; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeMetresShape ].
fw:PointComparisonResultShape a sh:NodeShape; sh:targetClass fw:PointComparisonResult;
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:PointSetComparison ];
  sh:property [ sh:path fw:originalMeanCenter; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ];
  sh:property [ sh:path fw:movedMeanCenter; sh:minCount 1; sh:maxCount 1; sh:node fw:RuntimeGeometryShape ];
  sh:property [ sh:path fw:originalNearestPumpId; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path fw:movedNearestPumpId; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string ].
fw:DataTableShape a sh:NodeShape; sh:targetClass fw:DataTable;
  sh:property [ sh:path fw:keyField; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1 ];
  sh:property [ sh:path fw:valueField; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ];
  sh:property [ sh:path fw:valueUnitStatus; sh:minCount 1; sh:maxCount 1; sh:in ( "stated" "unstated" ) ];
  sh:property [ sh:path fw:valueUnit; sh:maxCount 1; sh:datatype xsd:string ];
  sh:property [ sh:path fw:tableRowCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
  sh:property [ sh:path fw:tableMissingValueCount; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ];
  sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class fw:TabularInput ].
