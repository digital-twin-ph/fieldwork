{
  "schema": "fieldwork/report-formats/1",
  "note": "THE DRAFT'S FORMATS, AS MAPPINGS ONTO ROLES (experiment 202, 2026-11-15). A role is what a section holds and where it comes from; a format is its own headings, in its own order, each pointing to roles. What the person writes is kept by role, so it follows them from one format to another. Each format names the published reports it follows, read at their sources (workspace reports/Sit rep and surveillance report templates.md). The publication is laid out by its own code and is not declared here.",
  "roles": {
    "reportNumber": {
      "source": "written",
      "label": "Report number"
    },
    "dataAsOf": {
      "source": "written",
      "label": "Data as of"
    },
    "period": {
      "source": "written",
      "label": "Reporting period"
    },
    "keyFigures": {
      "source": "written",
      "label": "Key figures"
    },
    "highlights": {
      "source": "written",
      "label": "Highlights"
    },
    "background": {
      "source": "notes",
      "part": "Introduction",
      "label": "Background"
    },
    "situation": {
      "source": "notes",
      "part": "Results",
      "label": "The situation and its figures"
    },
    "methods": {
      "source": "notes",
      "part": "Methods",
      "label": "Methods"
    },
    "interpretation": {
      "source": "notes",
      "part": "Discussion",
      "label": "Interpretation"
    },
    "limitations": {
      "source": "limitations",
      "label": "Limitations"
    },
    "riskAssessment": {
      "source": "written",
      "label": "Risk assessment"
    },
    "response": {
      "source": "written",
      "label": "Response"
    },
    "gaps": {
      "source": "written",
      "label": "Gaps and challenges"
    },
    "recommendations": {
      "source": "written",
      "label": "Recommendations"
    },
    "contacts": {
      "source": "written",
      "label": "Contacts"
    },
    "references": {
      "source": "references",
      "label": "Sources and references"
    },
    "alreadyKnown": {
      "source": "written",
      "label": "What is already known"
    },
    "addedHere": {
      "source": "written",
      "label": "What this report adds"
    },
    "practiceImplications": {
      "source": "written",
      "label": "Implications for public health practice"
    },
    "abstract": {
      "source": "written",
      "label": "Abstract"
    }
  },
  "formats": [
    {
      "id": "sitrep-who",
      "label": "Situation report, WHO style",
      "kicker": "Situation report",
      "follows": "WHO situation reports: COVID-19 Situation Report 92 (2020); Mpox multi-country external situation report 65 (2026)",
      "masthead": [
        {
          "role": "reportNumber",
          "prompt": [
            "Report number and date issued",
            "one line",
            "Situation report number, and the date it is issued."
          ]
        },
        {
          "role": "dataAsOf",
          "prompt": [
            "Data as of",
            "one line",
            "The date and time the data were received, which is not the date issued."
          ]
        }
      ],
      "sections": [
        {
          "heading": "Highlights",
          "roles": [
            "highlights"
          ],
          "prompt": [
            "Highlights",
            "three to six bullets",
            "What changed since the last report, one sentence each, with its number."
          ]
        },
        {
          "heading": "Situation in numbers",
          "roles": [
            "keyFigures"
          ],
          "box": true,
          "prompt": [
            "Situation in numbers",
            "three to six lines",
            "Each a number and what it counts: the total, and new since the last report, with its period."
          ]
        },
        {
          "heading": "Background",
          "roles": [
            "background"
          ]
        },
        {
          "heading": "Epidemiological update",
          "roles": [
            "situation"
          ]
        },
        {
          "heading": "Risk assessment",
          "roles": [
            "riskAssessment",
            "interpretation"
          ],
          "prompt": [
            "Risk assessment",
            "a level and two or three sentences",
            "The level of risk (very high, high, moderate, low), and what it rests on."
          ]
        },
        {
          "heading": "Preparedness and response",
          "roles": [
            "response"
          ],
          "prompt": [
            "Preparedness and response",
            "bullets",
            "What has been done since the last report, and by whom."
          ]
        },
        {
          "heading": "Recommendations",
          "roles": [
            "recommendations"
          ],
          "prompt": [
            "Recommendations",
            "bullets",
            "What should be done, and by whom."
          ]
        },
        {
          "heading": "Data notes",
          "roles": [
            "methods",
            "limitations"
          ]
        },
        {
          "heading": "Resources and references",
          "roles": [
            "references"
          ]
        }
      ]
    },
    {
      "id": "sitrep-ocha",
      "label": "Situation report, OCHA style",
      "kicker": "Situation report",
      "follows": "UN OCHA situation reports: Recent Developments in Northwest Syria, Situation Report No. 23 (2020); OCHA's Digital Situation Report minimums",
      "masthead": [
        {
          "role": "reportNumber",
          "prompt": [
            "Report number",
            "one line",
            "Situation report number."
          ]
        },
        {
          "role": "dataAsOf",
          "prompt": [
            "As of",
            "one line",
            "The date the information is current to."
          ]
        }
      ],
      "sections": [
        {
          "heading": "Highlights",
          "roles": [
            "highlights"
          ],
          "prompt": [
            "Highlights",
            "two to five bullets",
            "The most important developments, one sentence each."
          ]
        },
        {
          "heading": "Key figures",
          "roles": [
            "keyFigures"
          ],
          "box": true,
          "prompt": [
            "Key figures",
            "three to six lines",
            "Each a number and what it counts, with its source."
          ]
        },
        {
          "heading": "Situation overview",
          "roles": [
            "background",
            "situation"
          ]
        },
        {
          "heading": "Key priorities and response activities",
          "roles": [
            "response"
          ],
          "prompt": [
            "Key priorities and response activities",
            "bullets",
            "What is being done, by whom, and the priorities."
          ]
        },
        {
          "heading": "Operational gaps and challenges",
          "roles": [
            "gaps"
          ],
          "prompt": [
            "Operational gaps and challenges",
            "bullets",
            "What is missing, or in the way of the response."
          ]
        },
        {
          "heading": "Notes on the data",
          "roles": [
            "methods",
            "limitations"
          ]
        },
        {
          "heading": "References",
          "roles": [
            "references"
          ]
        },
        {
          "heading": "For further information, please contact",
          "roles": [
            "contacts"
          ],
          "prompt": [
            "Contacts",
            "one line each",
            "Name, title, organisation, email."
          ]
        }
      ]
    },
    {
      "id": "surveillance-ecdc",
      "label": "Surveillance report, ECDC style",
      "kicker": "Surveillance report",
      "follows": "ECDC Annual Epidemiological Report (H. influenzae, for 2024); ECDC Communicable Disease Threats Report",
      "masthead": [
        {
          "role": "period",
          "prompt": [
            "Reporting period",
            "one line",
            "The dates this report covers, and the date the data were retrieved."
          ]
        }
      ],
      "sections": [
        {
          "heading": "Key facts",
          "roles": [
            "highlights"
          ],
          "prompt": [
            "Key facts",
            "three to five bullets",
            "What a reader must know, each one sentence with its number."
          ]
        },
        {
          "heading": "Introduction",
          "roles": [
            "background"
          ]
        },
        {
          "heading": "Methods",
          "roles": [
            "methods"
          ]
        },
        {
          "heading": "Epidemiology",
          "roles": [
            "situation"
          ]
        },
        {
          "heading": "Discussion",
          "roles": [
            "interpretation",
            "limitations"
          ]
        },
        {
          "heading": "Public health implications",
          "roles": [
            "recommendations"
          ],
          "prompt": [
            "Public health implications",
            "three to five bullets",
            "What follows for public health, and for whom."
          ]
        },
        {
          "heading": "References",
          "roles": [
            "references"
          ]
        }
      ]
    },
    {
      "id": "surveillance-mmwr",
      "label": "Surveillance summary, MMWR style",
      "kicker": "Surveillance summary",
      "follows": "CDC MMWR Surveillance Summaries, and the MMWR author guide for them",
      "masthead": [
        {
          "role": "period",
          "prompt": [
            "Period covered",
            "one line",
            "The dates the data cover."
          ]
        }
      ],
      "sections": [
        {
          "heading": "Summary",
          "roles": [
            "highlights"
          ],
          "prompt": [
            "Summary",
            "three to five bullets",
            "The problem, what was found, and what it means for action."
          ]
        },
        {
          "heading": "Introduction",
          "roles": [
            "background"
          ]
        },
        {
          "heading": "Methods",
          "roles": [
            "methods"
          ]
        },
        {
          "heading": "Results",
          "roles": [
            "situation"
          ]
        },
        {
          "heading": "Discussion",
          "roles": [
            "interpretation"
          ]
        },
        {
          "heading": "Limitations",
          "roles": [
            "limitations"
          ]
        },
        {
          "heading": "Public health action",
          "roles": [
            "recommendations"
          ],
          "prompt": [
            "Public health action",
            "two to four sentences",
            "What public health should do with these findings."
          ]
        },
        {
          "heading": "References",
          "roles": [
            "references"
          ]
        }
      ]
    },
    {
      "id": "mmwr-report",
      "label": "Report, MMWR style",
      "kicker": "Morbidity and Mortality Weekly Report",
      "follows": "CDC MMWR full reports: McArdle CE et al., Asthma-associated emergency department visits during the Canadian wildfire smoke episodes, United States, April to August 2023 (MMWR 2023;72(34):926-32)",
      "masthead": [],
      "sections": [
        {
          "heading": "Summary",
          "roles": [
            "alreadyKnown",
            "addedHere",
            "practiceImplications"
          ],
          "box": true,
          "prompts": {
            "alreadyKnown": [
              "What is already known about this topic?",
              "one or two sentences",
              "What earlier work established."
            ],
            "addedHere": [
              "What is added by this report?",
              "two or three sentences",
              "What this report found, with its numbers."
            ],
            "practiceImplications": [
              "What are the implications for public health practice?",
              "one or two sentences",
              "What practitioners should do with it."
            ]
          }
        },
        {
          "heading": "Abstract",
          "roles": [
            "abstract"
          ],
          "prompt": [
            "Abstract",
            "up to 250 words",
            "The question, the data, the main numbers and what they mean, in one paragraph."
          ]
        },
        {
          "heading": "Introduction",
          "roles": [
            "background"
          ]
        },
        {
          "heading": "Methods",
          "roles": [
            "methods"
          ]
        },
        {
          "heading": "Results",
          "roles": [
            "situation"
          ]
        },
        {
          "heading": "Discussion",
          "roles": [
            "interpretation"
          ]
        },
        {
          "heading": "Limitations",
          "roles": [
            "limitations"
          ]
        },
        {
          "heading": "Public health implications",
          "roles": [
            "recommendations"
          ],
          "prompt": [
            "Public health implications",
            "two or three sentences",
            "What public health practice should do with these findings."
          ]
        },
        {
          "heading": "References",
          "roles": [
            "references"
          ]
        }
      ]
    }
  ]
